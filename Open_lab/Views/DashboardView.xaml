<UserControl x:Class="Open_lab.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="24">
        <StackPanel>
            <TextBlock Text="لوحة التحكم" FontSize="22" FontWeight="Bold" />
            <UniformGrid Columns="3" Margin="0,16,0,0">
                <Border Margin="8" Padding="12" Background="#F4F4F4">
                    <StackPanel>
                        <TextBlock Text="المرضى" />
                        <TextBlock Text="{Binding PatientCount}" FontSize="18" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Margin="8" Padding="12" Background="#F4F4F4">
                    <StackPanel>
                        <TextBlock Text="الزيارات" />
                        <TextBlock Text="{Binding VisitCount}" FontSize="18" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Margin="8" Padding="12" Background="#F4F4F4">
                    <StackPanel>
                        <TextBlock Text="التحاليل" />
                        <TextBlock Text="{Binding TestCount}" FontSize="18" FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </Grid>
</UserControl>
