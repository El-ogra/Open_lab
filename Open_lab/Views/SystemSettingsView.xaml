<UserControl x:Class="Open_lab.Views.SystemSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:Open_lab.Behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Header="إعدادات التقارير والطباعة" Margin="0,0,0,10">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
	                    <RowDefinition Height="Auto" />
	                    <RowDefinition Height="Auto" />
	                    <RowDefinition Height="Auto" />
	                    <RowDefinition Height="Auto" />
	                    <RowDefinition Height="Auto" />
	                    <RowDefinition Height="Auto" />
	                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="رأس التقرير" Margin="0,4" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ReportHeader, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="ذيل التقرير" Margin="10,4,0,4" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding ReportFooter, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="الهامش العلوي (سم)" Margin="0,4" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ReportMarginTop, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="الهامش السفلي (سم)" Margin="10,4,0,4" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding ReportMarginBottom, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" />

	                <TextBlock Grid.Row="2" Grid.Column="0" Text="اللون الأساسي" Margin="0,4" VerticalAlignment="Center" />
	                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ReportPrimaryColor, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" />
	                <TextBlock Grid.Row="2" Grid.Column="2" Text="طابعة التقرير" Margin="10,4,0,4" VerticalAlignment="Center" />
	                <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding ReportPrinterName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" />

	                <TextBlock Grid.Row="3" Grid.Column="0" Text="الهامش الأيسر (سم)" Margin="0,4" VerticalAlignment="Center" />
	                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ReportMarginLeft, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" />
	                <TextBlock Grid.Row="3" Grid.Column="2" Text="الهامش الأيمن (سم)" Margin="10,4,0,4" VerticalAlignment="Center" />
	                <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding ReportMarginRight, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" />

	                <TextBlock Grid.Row="4" Grid.Column="0" Text="مسار شعار التقرير" Margin="0,4" VerticalAlignment="Center" />
	                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ReportLogoPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" />
	                <TextBlock Grid.Row="4" Grid.Column="2" Text="طابعة الإيصال" Margin="10,4,0,4" VerticalAlignment="Center" />
	                <TextBox Grid.Row="4" Grid.Column="3" Text="{Binding ReceiptPrinterName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" />

	                <TextBlock Grid.Row="5" Grid.Column="0" Text="طابعة الباركود" Margin="0,4" VerticalAlignment="Center" />
	                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding BarcodePrinterName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" />
	                <TextBlock Grid.Row="5" Grid.Column="2" Text="طابعة الظرف" Margin="10,4,0,4" VerticalAlignment="Center" />
	                <TextBox Grid.Row="5" Grid.Column="3" Text="{Binding EnvelopePrinterName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" />

	                <TextBlock Grid.Row="6" Grid.Column="0" Text="رأس الإيصال" Margin="0,4" VerticalAlignment="Center" />
	                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding ReceiptHeaderText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" />
	                <TextBlock Grid.Row="6" Grid.Column="2" Text="ذيل الإيصال" Margin="10,4,0,4" VerticalAlignment="Center" />
	                <TextBox Grid.Row="6" Grid.Column="3" Text="{Binding ReceiptFooterText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" />

	                <TextBlock Grid.Row="7" Grid.Column="0" Text="عدد نسخ الإيصال" Margin="0,4" VerticalAlignment="Center" />
	                <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal">
	                    <TextBox Width="90" Text="{Binding ReceiptCopies, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,8,4" />
	                    <CheckBox Content="إظهار الشعار" IsChecked="{Binding ReceiptShowLogo}" VerticalAlignment="Center" />
	                </StackPanel>
	                <TextBlock Grid.Row="7" Grid.Column="2" Text="مسار شعار الفاتورة" Margin="10,4,0,4" VerticalAlignment="Center" />
	                <TextBox Grid.Row="7" Grid.Column="3" Text="{Binding InvoiceLogoPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" />

	                <TextBlock Grid.Row="8" Grid.Column="0" Text="عملة الفاتورة" Margin="0,4" VerticalAlignment="Center" />
	                <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding InvoiceCurrency, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" />
	                <CheckBox Grid.Row="8" Grid.Column="3" Content="إظهار التفاصيل الطبية في الفاتورة" IsChecked="{Binding InvoiceShowMedicalDetails}" Margin="0,4" VerticalAlignment="Center" />

	                <TextBlock Grid.Row="9" Grid.Column="0" Text="حجم الورق" Margin="0,4" VerticalAlignment="Center" />
	                <ComboBox Grid.Row="9" Grid.Column="1" SelectedValue="{Binding ReportPaperSize}" SelectedValuePath="Content" Margin="0,4">
	                    <ComboBoxItem Content="A4" />
	                    <ComboBoxItem Content="A5" />
	                </ComboBox>
	                <TextBlock Grid.Row="9" Grid.Column="2" Text="نوع الحساب الافتراضي" Margin="10,4,0,4" VerticalAlignment="Center" />
	                <ComboBox Grid.Row="9" Grid.Column="3" SelectedValue="{Binding DefaultAccountType}" SelectedValuePath="Content" Margin="0,4">
                    <ComboBoxItem Content="Cash" />
                    <ComboBoxItem Content="Credit" />
                </ComboBox>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="حفظ الإعدادات المتخصصة" Command="{Binding SaveProfileCommand}" />
            <Button Content="إعادة تحميل" Margin="8,0,0,0" Command="{Binding ReloadCommand}" />
        </StackPanel>

        <GroupBox Grid.Row="2" Header="تغيير كلمة مرور النظام" Margin="0,0,0,8">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="كلمة المرور الحالية" Margin="0,4" VerticalAlignment="Center" />
                <PasswordBox Grid.Row="0" Grid.Column="1" Margin="0,4"
                             behaviors:PasswordBoxAssistant.BindPassword="True"
                             behaviors:PasswordBoxAssistant.BoundPassword="{Binding CurrentMasterPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="كلمة المرور الجديدة" Margin="10,4,0,4" VerticalAlignment="Center" />
                <PasswordBox Grid.Row="0" Grid.Column="3" Margin="0,4"
                             behaviors:PasswordBoxAssistant.BindPassword="True"
                             behaviors:PasswordBoxAssistant.BoundPassword="{Binding NewMasterPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="تأكيد كلمة المرور" Margin="0,4" VerticalAlignment="Center" />
                <PasswordBox Grid.Row="1" Grid.Column="1" Margin="0,4"
                             behaviors:PasswordBoxAssistant.BindPassword="True"
                             behaviors:PasswordBoxAssistant.BoundPassword="{Binding ConfirmMasterPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Row="1" Grid.Column="3" Content="تحديث كلمة المرور" HorizontalAlignment="Left" Width="140" Margin="0,4" Command="{Binding ChangeMasterPasswordCommand}" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="إعدادات متقدمة (Key/Value)" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Margin="8">
                <TextBlock Text="المفتاح" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="200" />
                <TextBlock Text="القيمة" VerticalAlignment="Center" Margin="12,0,8,0" />
                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="280" />
                <Button Content="حفظ" Margin="12,0,0,0" Command="{Binding SaveRawSettingCommand}" />
                <Button Content="حذف" Margin="8,0,0,0" Command="{Binding DeleteRawSettingCommand}" />
            </StackPanel>
        </GroupBox>

        <DataGrid Grid.Row="4" ItemsSource="{Binding Settings}" SelectedItem="{Binding SelectedSetting}" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="المفتاح" Binding="{Binding Key}" Width="220" />
                <DataGridTextColumn Header="القيمة" Binding="{Binding Value}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="5" Text="{Binding StatusMessage}" Foreground="DarkGreen" Margin="0,10,0,0" TextWrapping="Wrap" />
    </Grid>
</UserControl>
