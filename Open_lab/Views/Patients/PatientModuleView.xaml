<UserControl x:Class="Open_lab.Views.Patients.PatientModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <Style x:Key="ModuleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="220" />
            <Setter Property="Height" Value="70" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="Background" Value="#8DB600" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="12">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#25333E">
        <Grid.RowDefinitions>
            <RowDefinition Height="215" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="20"
                Padding="22"
                Background="#FAFAFA"
                BorderBrush="#D5D8DA"
                BorderThickness="1"
                CornerRadius="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" FlowDirection="LeftToRight">
                    <Ellipse Width="126" Height="126" Fill="#E7F2F4" Stroke="#B5CDD2" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Text="AB-" Foreground="#A71921" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,44,0,0" />
                    <TextBlock Text="&#xE91D;" FontFamily="Segoe MDL2 Assets" Foreground="#376C78" FontSize="54" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-34,0,0" />
                    <Path Data="M55,150 L205,75" Stroke="#2C6B4F" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Path Data="M198,70 L224,60 L213,85 Z" Fill="#C0392B" />
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="من خلال هذه النافذة يمكنك عمل الآتي:"
                               Foreground="#D56E13"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,12" />
                    <TextBlock Text=". إضافة مريض جديد وطباعة الباركود والإيصال الخاص به وإدخال النتائج وطباعتها" FontSize="16" Foreground="#111" Margin="0,3" />
                    <TextBlock Text=". البحث عن مريض محدد أو عرض مرضى فترة معينة ومعرفة النتائج الغير منتهية" FontSize="16" Foreground="#111" Margin="0,3" />
                    <TextBlock Text=". وكذلك الغير محققة والغير مطبوعة" FontSize="16" Foreground="#111" Margin="0,3" />
                    <TextBlock Text=". تسليم نتائج المرضى وتصفية الحسابات الخاصة بهم وحصر النتائج الغير مسلمة" FontSize="16" Foreground="#111" Margin="0,3" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource ModuleButtonStyle}" Command="{Binding OpenAddPatientCommand}">
                <DockPanel LastChildFill="True">
                    <TextBlock Text="&#xE95E;" FontFamily="Segoe MDL2 Assets" FontSize="28" DockPanel.Dock="Left" Margin="0,0,12,0" />
                    <TextBlock Text="اضافة وتعديل بيانات المرضى" TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center" />
                </DockPanel>
            </Button>
            <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource ModuleButtonStyle}" Command="{Binding OpenEnterResultsCommand}">
                <DockPanel LastChildFill="True">
                    <TextBlock Text="&#xE70B;" FontFamily="Segoe MDL2 Assets" FontSize="28" DockPanel.Dock="Left" Margin="0,0,12,0" />
                    <TextBlock Text="ادخال نتائج التحاليل" TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center" />
                </DockPanel>
            </Button>
            <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource ModuleButtonStyle}" Command="{Binding OpenDeliverResultsCommand}">
                <DockPanel LastChildFill="True">
                    <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" FontSize="28" DockPanel.Dock="Left" Margin="0,0,12,0" />
                    <TextBlock Text="تسليم نتائج المرضى" TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center" />
                </DockPanel>
            </Button>
            <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource ModuleButtonStyle}" Command="{Binding OpenSearchPatientCommand}">
                <DockPanel LastChildFill="True">
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="28" DockPanel.Dock="Left" Margin="0,0,12,0" />
                    <TextBlock Text="بحث عن مريض" TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center" />
                </DockPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
