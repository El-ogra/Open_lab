<UserControl x:Class="Open_lab.Views.Patients.PatientSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="#F4F7F2">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding SearchCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D7E0D2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="6" />
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="95" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Background" Value="#6E9F16" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="190" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.4*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource PanelStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="95" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="من" VerticalAlignment="Center" />
                    <DatePicker Width="120" Margin="6,0,0,0" SelectedDate="{Binding DateFrom}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="إلى" VerticalAlignment="Center" />
                    <DatePicker Width="120" Margin="6,0,0,0" SelectedDate="{Binding DateTo}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="المرحلة" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="3" Text="{Binding AgeGroup}" IsEditable="True" SelectedIndex="3">
                    <ComboBoxItem Content="أطفال" />
                    <ComboBoxItem Content="بالغين" />
                    <ComboBoxItem Content="كبار سن" />
                    <ComboBoxItem Content="الكل" />
                </ComboBox>
                <TextBlock Grid.Column="4" Text="الجنس" VerticalAlignment="Center" />
                <StackPanel Grid.Column="5" Orientation="Horizontal">
                    <RadioButton Content="ذكر" Margin="0,0,8,0" />
                    <RadioButton Content="أنثى" Margin="0,0,8,0" />
                    <RadioButton Content="الكل" IsChecked="True" />
                </StackPanel>

                <TextBlock Grid.Row="1" Text="بداية الاسم" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="يحتوي على" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="3" ToolTip="استخدم نفس حقل الاسم للتضييق في الخدمة الحالية." />
                <TextBlock Grid.Row="1" Grid.Column="4" Text="الهاتف" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="5" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Row="1" Grid.Column="6" Content="بحث / F5" Command="{Binding SearchCommand}" Style="{StaticResource ActionButtonStyle}" />

                <TextBlock Grid.Row="2" Text="كود المعمل" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding LabId, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="الرقم القومي" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding NationalId, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="2" Grid.Column="4" Text="باركود" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="5" ToolTip="قارئ الباركود يكتب الكود هنا ثم يتم البحث." />
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource PanelStyle}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="نتائج البحث - الحد التشغيلي المقترح 100 نتيجة" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
                <DataGrid ItemsSource="{Binding Patients}"
                          SelectedItem="{Binding SelectedPatient}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Lab ID" Binding="{Binding LabId}" Width="120" />
                        <DataGridTextColumn Header="اسم المريض" Binding="{Binding FullName}" Width="*" />
                        <DataGridTextColumn Header="الجنس" Binding="{Binding Gender}" Width="90" />
                        <DataGridTextColumn Header="السن" Binding="{Binding Age}" Width="70" />
                        <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="130" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource PanelStyle}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="ملخص الحالة والإجراءات" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
                <StackPanel DockPanel.Dock="Bottom">
                    <UniformGrid Columns="2">
                        <TextBlock Text="غير منتهية: -" Margin="4" />
                        <TextBlock Text="غير مطبوعة: -" Margin="4" />
                        <TextBlock Text="غير مستلمة: -" Margin="4" />
                        <TextBlock Text="حساب غير مغلق: -" Margin="4" />
                    </UniformGrid>
                    <WrapPanel HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button Content="عرض النتائج" Command="{Binding DataContext.NavigateResultsEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource ActionButtonStyle}" />
                        <Button Content="بيانات المريض" Command="{Binding DataContext.NavigatePatientRegistrationCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource ActionButtonStyle}" />
                        <Button Content="نتائج مجمعة" Style="{StaticResource ActionButtonStyle}" />
                        <Button Content="القائمة الرئيسية" Command="{Binding DataContext.NavigateToPatientsCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource ActionButtonStyle}" />
                    </WrapPanel>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding SelectedPatient.FullName, TargetNullValue=لم يتم اختيار مريض}" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="{Binding SelectedPatient.LabId, StringFormat=Lab ID: {0}}" Margin="0,6" />
                    <TextBlock Text="{Binding SelectedPatient.Phone, StringFormat=هاتف: {0}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource PanelStyle}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="زيارات وتحاليل المريض المحدد" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
                <DataGrid ItemsSource="{Binding Visits}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="رقم الزيارة" Binding="{Binding VisitId}" Width="100" />
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding VisitDate}" Width="160" />
                        <DataGridTextColumn Header="نوع الحساب" Binding="{Binding AccountType}" Width="140" />
                        <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="8,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="F2 بيانات" Command="{Binding DataContext.NavigatePatientRegistrationCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource ActionButtonStyle}" />
                <Button Content="F4 نتائج" Command="{Binding DataContext.NavigateResultsEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource ActionButtonStyle}" />
                <Button Content="F6 تسليم" Command="{Binding DataContext.NavigateDeliveryCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource ActionButtonStyle}" />
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}" Foreground="#245423" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</UserControl>
