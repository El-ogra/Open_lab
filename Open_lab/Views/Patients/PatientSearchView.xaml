<UserControl x:Class="Open_lab.Views.Patients.PatientSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="LeftToRight"
             Background="{StaticResource AppMainBlue}">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding SearchCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Headers -->
        <Grid Grid.Row="0" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <!-- Col 0: مريض -->
            <Border Grid.Column="0" Background="{StaticResource AppOrange}" Margin="2">
                <TextBlock Text="مريض" Foreground="White" HorizontalAlignment="Center" FontWeight="Bold" Padding="5" FlowDirection="RightToLeft"/>
            </Border>
            <!-- Col 1: عدد مرضى عملية البحث -->
            <Border Grid.Column="1" Background="{StaticResource AppOrange}" Margin="2">
                <TextBlock Text="عدد مرضى عملية البحث 0" Foreground="White" HorizontalAlignment="Center" FontWeight="Bold" Padding="5" FlowDirection="RightToLeft"/>
            </Border>
            <!-- Col 2: تحاليل المريض -->
            <Border Grid.Column="2" Background="{StaticResource AppHeaderBlue}" Margin="2">
                <TextBlock Text="تحاليل المريض 0" Foreground="White" HorizontalAlignment="Center" FontWeight="Bold" Padding="5" FlowDirection="RightToLeft"/>
            </Border>
        </Grid>

        <!-- DataGrid & Tests Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- DataGrid in Left Column -->
            <DataGrid Grid.Column="0" ItemsSource="{Binding Patients}" SelectedItem="{Binding SelectedPatient}"
                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      ColumnHeaderStyle="{StaticResource CustomDataGridHeaderStyle}"
                      Background="{StaticResource LightPanelBg}" Margin="2" FlowDirection="LeftToRight">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding ID, FallbackValue='—'}" Width="60" />
                    <DataGridTextColumn Header="Lab ID" Binding="{Binding LabId}" Width="100" />
                    <DataGridTextColumn Header="Patient Name" Binding="{Binding FullName}" Width="*" />
                    <DataGridTextColumn Header="Date" Binding="{Binding Date, FallbackValue='—'}" Width="100" />
                    <DataGridTextColumn Header="Gender" Binding="{Binding Gender}" Width="60" />
                    <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="50" />
                    <DataGridTextColumn Header="Unit" Binding="{Binding Unit, FallbackValue='—'}" Width="80" />
                    <DataGridTextColumn Header="Referred By" Binding="{Binding ReferredBy, FallbackValue='—'}" Width="120" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Tests ListBox in Right Column -->
            <Border Grid.Column="1" Background="{StaticResource DarkPanelBg}" BorderBrush="{StaticResource AppHeaderBlue}" BorderThickness="2" Margin="2">
                <ListBox ItemsSource="{Binding PatientTests, FallbackValue={x:Null}}" Margin="5" Background="White" FlowDirection="RightToLeft"/>
            </Border>
        </Grid>

        <!-- Search Forms Area -->
        <Border Grid.Row="2" BorderBrush="{StaticResource AppHeaderBlue}" BorderThickness="2" Margin="2,10" Padding="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Col 0: Phone -->
                    <ColumnDefinition Width="1*" />
                    <!-- Col 1: Age/Date -->
                    <ColumnDefinition Width="2*" />
                    <!-- Col 2: Gender/Doctor -->
                    <ColumnDefinition Width="1*" />
                    <!-- Col 3: Name Exact/Random -->
                    <ColumnDefinition Width="1.5*" />
                    <!-- Col 4: Enter ID/Backup -->
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0 -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource SearchHeaderStyle}" Margin="0,0,2,2">
                            <TextBlock Text="بحث بالتليفون" Style="{StaticResource SearchHeaderTextStyle}" FlowDirection="RightToLeft"/>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource SearchHeaderStyle}" Margin="2,0,0,2">
                            <TextBlock Text="بحث بالجوال" Style="{StaticResource SearchHeaderTextStyle}" FlowDirection="RightToLeft"/>
                        </Border>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,2,0" FlowDirection="LeftToRight"/>
                        <TextBox Grid.Column="1" Text="{Binding MobilePhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}" FlowDirection="LeftToRight"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="2">
                    <Border Style="{StaticResource SearchHeaderStyle}" Margin="0,0,0,2">
                        <TextBlock Text="بحث بسن المريض" Style="{StaticResource SearchHeaderTextStyle}" FlowDirection="RightToLeft"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                        <RadioButton Content="حر" Foreground="White" IsChecked="{Binding IsAgeFree, Mode=TwoWay}" Margin="0,0,5,0" VerticalAlignment="Center" FlowDirection="RightToLeft"/>
                        <RadioButton Content="مقيد" Foreground="White" IsChecked="{Binding IsAgeRestricted, Mode=TwoWay}" Margin="0,0,5,0" VerticalAlignment="Center" FlowDirection="RightToLeft"/>
                        <ComboBox SelectedValue="{Binding AgeUnit, Mode=TwoWay}" SelectedValuePath="Content" Margin="0,0,5,0" FlowDirection="LeftToRight">
                            <ComboBoxItem Content="Years"/>
                        </ComboBox>
                        <Border Background="{StaticResource AppOrange}" Padding="2,0" Margin="0,0,5,0">
                            <TextBlock Text="من" Foreground="White" VerticalAlignment="Center" FlowDirection="RightToLeft"/>
                        </Border>
                        <TextBox Width="30" Text="{Binding AgeFrom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}" FlowDirection="LeftToRight"/>
                        <Border Background="{StaticResource AppOrange}" Padding="2,0" Margin="5,0,5,0">
                            <TextBlock Text="إلى" Foreground="White" VerticalAlignment="Center" FlowDirection="RightToLeft"/>
                        </Border>
                        <TextBox Width="30" Text="{Binding AgeTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}" FlowDirection="LeftToRight"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="2">
                    <Border Style="{StaticResource SearchHeaderStyle}" Margin="0,0,0,2">
                        <TextBlock Text="بحث بالفئة العمرية" Style="{StaticResource SearchHeaderTextStyle}" FlowDirection="RightToLeft"/>
                    </Border>
                    <ComboBox SelectedValue="{Binding AgeGroup, Mode=TwoWay}" SelectedValuePath="Content" FlowDirection="RightToLeft">
                        <ComboBoxItem Content="الكل" IsSelected="True"/>
                        <ComboBoxItem Content="أطفال"/>
                        <ComboBoxItem Content="بالغين"/>
                        <ComboBoxItem Content="كبار سن"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="3" Margin="2">
                    <Border Style="{StaticResource SearchHeaderStyle}" Margin="0,0,0,2">
                        <TextBlock Text="بحث باسم المريض (مطابق)" Style="{StaticResource SearchHeaderTextStyle}" FlowDirection="RightToLeft"/>
                    </Border>
                    <TextBox Text="{Binding NameExact, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}" FlowDirection="RightToLeft"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="4" Margin="10,2,2,2">
                    <Border Background="White" BorderBrush="Black" BorderThickness="1" Padding="5">
                        <TextBox Text="{Binding LabId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontWeight="Bold" HorizontalContentAlignment="Center" BorderThickness="0" FlowDirection="LeftToRight"/>
                    </Border>
                    <Button Content="🔄 New search" Command="{Binding SearchCommand}" Style="{StaticResource GreenActionButtonStyle}" Margin="0,5,0,0" FlowDirection="LeftToRight"/>
                </StackPanel>

                <!-- Row 1 -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="2">
                    <Border Style="{StaticResource SearchHeaderStyle}" Margin="0,0,0,2">
                        <TextBlock Text="بحث بالرقم القومي" Style="{StaticResource SearchHeaderTextStyle}" FlowDirection="RightToLeft"/>
                    </Border>
                    <TextBox Text="{Binding NationalId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="2">
                    <Border Style="{StaticResource SearchHeaderStyle}" Margin="0,0,0,2">
                        <TextBlock Text="بحث بتاريخ الطلب" Style="{StaticResource SearchHeaderTextStyle}" FlowDirection="RightToLeft"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                        <RadioButton Content="حر" Foreground="White" IsChecked="{Binding IsDateFree, Mode=TwoWay}" Margin="0,0,5,0" VerticalAlignment="Center" FlowDirection="RightToLeft"/>
                        <RadioButton Content="مقيد" Foreground="White" IsChecked="{Binding IsDateRestricted, Mode=TwoWay}" Margin="0,0,5,0" VerticalAlignment="Center" FlowDirection="RightToLeft"/>
                        <Border Background="{StaticResource AppOrange}" Padding="2,0" Margin="0,0,5,0">
                            <TextBlock Text="من" Foreground="White" VerticalAlignment="Center" FlowDirection="RightToLeft"/>
                        </Border>
                        <DatePicker SelectedDate="{Binding DateFrom, Mode=TwoWay}" Width="90" FlowDirection="LeftToRight"/>
                        <Border Background="{StaticResource AppOrange}" Padding="2,0" Margin="5,0,5,0">
                            <TextBlock Text="إلى" Foreground="White" VerticalAlignment="Center" FlowDirection="RightToLeft"/>
                        </Border>
                        <DatePicker SelectedDate="{Binding DateTo, Mode=TwoWay}" Width="90" FlowDirection="LeftToRight"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Margin="2">
                    <Border Style="{StaticResource SearchHeaderStyle}" Margin="0,0,0,2">
                        <TextBlock Text="بحث باسم الطبيب" Style="{StaticResource SearchHeaderTextStyle}" FlowDirection="RightToLeft"/>
                    </Border>
                    <ComboBox SelectedItem="{Binding DoctorName, Mode=TwoWay, FallbackValue=''}" FlowDirection="RightToLeft"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="3" Margin="2">
                    <Border Style="{StaticResource SearchHeaderStyle}" Margin="0,0,0,2">
                        <TextBlock Text="بحث باسم المريض (عشوائي)" Style="{StaticResource SearchHeaderTextStyle}" FlowDirection="RightToLeft"/>
                    </Border>
                    <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FlowDirection="RightToLeft"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="4" Margin="10,2,2,2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight">
                    <RadioButton Content="Database" Foreground="White" IsChecked="{Binding IsDatabaseSearch, Mode=TwoWay}" Margin="0,0,10,0"/>
                    <RadioButton Content="Backup" Foreground="White" IsChecked="{Binding IsBackupSearch, Mode=TwoWay}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Action Buttons -->
        <Border Grid.Row="3" Background="{StaticResource AppOrange}" Padding="5" Margin="2">
            <WrapPanel HorizontalAlignment="Center">
                <!-- Buttons are rendered from physical Left to Right. We want 'بيانات المريض' on far left, 'القائمة الرئيسية' on far right -->
                <Button Content="بيانات المريض" Command="{Binding NavigatePatientRegistrationCommand}" Style="{StaticResource GreyActionButtonStyle}" FlowDirection="RightToLeft"/>
                <Button Content="نتائج التحاليل" Command="{Binding NavigateResultsEntryCommand}" Style="{StaticResource GreyActionButtonStyle}" FlowDirection="RightToLeft"/>
                <Button Content="حذف المريض" Command="{Binding DeletePatientCommand}" Style="{StaticResource OrangeActionButtonStyle}" FlowDirection="RightToLeft"/>
                <Button Content="نتائج لم تدخل" Command="{Binding UnenteredResultsCommand}" ToolTip="عرض المرضى الذين لديهم نتائج غير مدخلة" Style="{StaticResource YellowActionButtonStyle}" FlowDirection="RightToLeft"/>
                <Button Content="نتائج لم تراجع" Command="{Binding UnreviewedResultsCommand}" ToolTip="عرض المرضى الذين لديهم نتائج لم تراجع" Style="{StaticResource GreenActionButtonStyle}" FlowDirection="RightToLeft"/>
                <Button Content="نتائج لم تطبع" Command="{Binding UnprintedResultsCommand}" ToolTip="عرض المرضى الذين لديهم نتائج لم تطبع" Style="{StaticResource GreenActionButtonStyle}" FlowDirection="RightToLeft"/>
                <Button Content="نتائج لم تسلم" Command="{Binding UndeliveredResultsCommand}" ToolTip="عرض المرضى الذين لديهم نتائج لم تسلم" Style="{StaticResource GreenActionButtonStyle}" FlowDirection="RightToLeft"/>
                <Button Content="حساب مفتوح" Command="{Binding OpenAccountCommand}" ToolTip="عرض المرضى الذين لديهم حساب مفتوح" Style="{StaticResource GreenActionButtonStyle}" FlowDirection="RightToLeft"/>
                <Button Content="نتائج مجمعة" Command="{Binding GroupedResultsCommand}" ToolTip="عرض المرضى الذين لديهم نتائج مجمعة" Style="{StaticResource BlueActionButtonStyle}" FlowDirection="RightToLeft"/>
                <Button Content="القائمة الرئيسية" Command="{Binding DataContext.NavigateToPatientsCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource BlueActionButtonStyle}" FlowDirection="RightToLeft"/>
            </WrapPanel>
        </Border>
    </Grid>
</UserControl>
