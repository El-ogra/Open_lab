<UserControl x:Class="Open_lab.Views.Patients.DeliveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="LeftToRight"
             Background="{StaticResource DeliveryMainGreenBg}">

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding SearchCommand}" />
        <KeyBinding Key="Enter" Command="{Binding DeliverCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="250" />
        </Grid.ColumnDefinitions>

        <!-- Left Column (Main Area) -->
        <Grid Grid.Column="0" Margin="0,0,5,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Patient Info -->
            <Border Grid.Row="0" Background="{StaticResource DeliveryPanelGreen}" Padding="5" BorderBrush="Yellow" BorderThickness="2" Margin="0,0,0,5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" FlowDirection="RightToLeft" Margin="0,2">
                        <!-- Code -->
                        <Border Style="{StaticResource InfoBoxHeaderStyle}" Background="{StaticResource DeliveryOrange}"><TextBlock Text="الكود" Foreground="White" Width="60" TextAlignment="Center"/></Border>
                        <Border Style="{StaticResource InfoBoxValueStyle}"><TextBlock Text="{Binding PatientCode}" Width="100"/></Border>
                        
                        <!-- Name -->
                        <Border Style="{StaticResource InfoBoxHeaderStyle}"><TextBlock Text="الاسم" Foreground="White" Width="60" TextAlignment="Center"/></Border>
                        <Border Style="{StaticResource InfoBoxValueStyle}"><TextBlock Text="{Binding SelectedVisit.PatientName}" Width="250"/></Border>

                        <!-- Referral -->
                        <Border Style="{StaticResource InfoBoxHeaderStyle}"><TextBlock Text="الجهة" Foreground="White" Width="60" TextAlignment="Center"/></Border>
                        <Border Style="{StaticResource InfoBoxValueStyle}"><TextBlock Text="{Binding PatientReferral}" Width="200"/></Border>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" FlowDirection="RightToLeft" Margin="0,2">
                        <!-- Lab ID -->
                        <Border Style="{StaticResource InfoBoxHeaderStyle}" Background="{StaticResource DeliveryOrange}"><TextBlock Text="Lab ID" Foreground="White" Width="60" TextAlignment="Center" FlowDirection="LeftToRight"/></Border>
                        <Border Style="{StaticResource InfoBoxValueStyle}"><TextBlock Text="{Binding SelectedVisit.LabId}" Width="100" FlowDirection="LeftToRight"/></Border>

                        <!-- Gender -->
                        <Border Style="{StaticResource InfoBoxHeaderStyle}"><TextBlock Text="النوع" Foreground="White" Width="60" TextAlignment="Center"/></Border>
                        <Border Style="{StaticResource InfoBoxValueStyle}"><TextBlock Text="{Binding PatientGender}" Width="60"/></Border>

                        <!-- Age -->
                        <Border Style="{StaticResource InfoBoxHeaderStyle}"><TextBlock Text="العمر" Foreground="White" Width="60" TextAlignment="Center"/></Border>
                        <Border Style="{StaticResource InfoBoxValueStyle}"><TextBlock Text="{Binding PatientAge}" Width="60"/></Border>
                        
                        <!-- Required (المطلوب) -->
                        <Border Style="{StaticResource InfoBoxHeaderStyle}"><TextBlock Text="المطلوب" Foreground="White" Width="60" TextAlignment="Center"/></Border>
                        <Border Style="{StaticResource InfoBoxValueStyle}"><TextBlock Text="{Binding TotalRequired, StringFormat={}{0:N2}}" Width="80"/></Border>

                        <!-- Total (الإجمالي) -->
                        <Border Style="{StaticResource InfoBoxHeaderStyle}"><TextBlock Text="الإجمالي" Foreground="White" Width="60" TextAlignment="Center"/></Border>
                        <Border Style="{StaticResource InfoBoxValueStyle}"><TextBlock Text="{Binding TotalAmount, StringFormat={}{0:N2}}" Width="80"/></Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Row 1: DataGrid -->
            <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedVisitTests}"
                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      ColumnHeaderStyle="{StaticResource DeliveryDataGridHeaderStyle}"
                      Background="White" BorderBrush="{StaticResource DeliveryPanelGreen}" BorderThickness="3" Margin="0,0,0,5" FlowDirection="LeftToRight">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Test Name" Binding="{Binding TestName}" Width="*" />
                    <DataGridTextColumn Header="Result" Binding="{Binding ResultValue}" Width="150" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                    <DataGridCheckBoxColumn Header="Finish" Binding="{Binding IsFinished}" Width="60" />
                    <DataGridCheckBoxColumn Header="Verify" Binding="{Binding IsVerified}" Width="60" />
                    <DataGridCheckBoxColumn Header="Print" Binding="{Binding ShouldPrint}" Width="60" />
                    <DataGridCheckBoxColumn Header="Export" Binding="{Binding ShouldExport}" Width="60" />
                    <DataGridTextColumn Header="Price" Binding="{Binding Price}" Width="80" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Row 2: Payment & Notes -->
            <Border Grid.Row="2" Background="{StaticResource DeliveryPanelGreen}" Padding="5" BorderBrush="Yellow" BorderThickness="2" Margin="0,0,0,5">
                <Grid FlowDirection="RightToLeft">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="2">
                        <Button Content="الاستلام" Command="{Binding PayCommand}" Style="{StaticResource DeliveryBlueButtonStyle}" Width="100"/>
                        <TextBox Width="120" Margin="5,0" Text="{Binding PaymentAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="مستلمة" Command="{Binding DeliverCommand}" Style="{StaticResource DeliveryYellowButtonStyle}" Width="80"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="2">
                        <TextBox Width="300" Margin="5,0" Text="{Binding DeliveryNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="ملاحظات" Command="{Binding ShowNotesCommand}" Background="{StaticResource DeliveryOrange}" Foreground="White" Style="{StaticResource DeliveryBaseButtonStyle}" Width="100"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="2">
                        <Border Background="{StaticResource DeliveryHeaderBlue}" Padding="5" Margin="0,0,5,0" Width="150">
                            <TextBlock Text="تم طباعة نتائج المريض...!" Foreground="White" TextAlignment="Center"/>
                        </Border>
                        <Border Background="{StaticResource DeliveryYellow}" Padding="5" Margin="0,0,5,0" Width="40">
                            <TextBlock Text="0" TextAlignment="Center" FontWeight="Bold"/>
                        </Border>
                        <Border Background="{StaticResource DeliveryHeaderBlue}" Padding="5" Margin="0,0,5,0" Width="150">
                            <TextBlock Text="تم تسجيل نتائج المريض...!" Foreground="White" TextAlignment="Center"/>
                        </Border>
                        <Border Background="{StaticResource DeliveryYellow}" Padding="5" Margin="0,0,5,0" Width="40">
                            <TextBlock Text="0" TextAlignment="Center" FontWeight="Bold"/>
                        </Border>
                        <Border Background="{StaticResource DeliveryHeaderBlue}" Padding="5" Margin="0,0,5,0" Width="150">
                            <TextBlock Text="تم تسديد الحساب...!" Foreground="White" TextAlignment="Center"/>
                        </Border>
                        <Border Background="{StaticResource DeliveryYellow}" Padding="5" Margin="0,0,5,0" Width="40">
                            <TextBlock Text="0" TextAlignment="Center" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Row 3: Bottom Actions -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" FlowDirection="RightToLeft" Margin="0,5,0,0">
                <Button Content="القائمة الرئيسية" Command="{Binding DataContext.NavigateToPatientsCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource DeliveryDarkGreenButtonStyle}" Width="150"/>
                <Border Width="100"/> <!-- Spacer -->
                <Button Content="حساب المريض" Command="{Binding PatientAccountCommand}" Style="{StaticResource DeliveryYellowButtonStyle}" Width="150" Margin="20,0"/>
                <Button Content="تسليم نتائج المريض المنتهية" Command="{Binding DeliverCommand}" Style="{StaticResource DeliveryGreenButtonStyle}" Width="180"/>
            </StackPanel>
        </Grid>

        <!-- Right Column (Side Panel) -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{StaticResource DeliveryPanelGreen}" Padding="5" Margin="0,0,0,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource DeliveryOrange}" Width="30">
                        <TextBlock Text="{Binding Visits.Count}" Foreground="White" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="النتائج الغير مستلمة" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="RightToLeft"/>
                </Grid>
            </Border>
            
            <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource DeliveryPanelGreen}" BorderThickness="3">
                <ListBox ItemsSource="{Binding Visits}" SelectedItem="{Binding SelectedVisit}" FlowDirection="RightToLeft">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding PatientName}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding LabId, StringFormat=Lab ID: {0}}" FontSize="10" Foreground="Gray" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Bottom Panel -->
            <Border Grid.Row="2" Background="{StaticResource DeliveryPanelGreen}" Padding="5" Margin="0,2,0,0">
                <Grid FlowDirection="RightToLeft">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Refresh and ALL -->
                    <Button Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Content="🔄 Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource DeliveryGreenButtonStyle}" Margin="2"/>
                    <ToggleButton Grid.Row="0" Grid.Column="3" Content="ALL" Command="{Binding FilterAllCommand}" Margin="2" Background="White"/>

                    <!-- VIP Pat Lab £ -->
                    <ToggleButton Grid.Row="1" Grid.Column="0" Content="VIP" IsChecked="{Binding IsVIP, Mode=TwoWay}" Margin="2" Background="{StaticResource DeliveryPanelGreen}" Foreground="White"/>
                    <ToggleButton Grid.Row="1" Grid.Column="1" Content="Pat" IsChecked="{Binding IsPat, Mode=TwoWay}" Margin="2" Background="{StaticResource DeliveryPanelGreen}" Foreground="White"/>
                    <ToggleButton Grid.Row="1" Grid.Column="2" Content="Lab" IsChecked="{Binding IsLab, Mode=TwoWay}" Margin="2" Background="{StaticResource DeliveryPanelGreen}" Foreground="White"/>
                    <ToggleButton Grid.Row="1" Grid.Column="3" Content="لم تسلم" IsChecked="{Binding UndeliveredOnly, Mode=TwoWay}" Margin="2" Background="{StaticResource DeliveryOrange}" Foreground="White"/>

                    <!-- Date From / To -->
                    <Grid Grid.Row="2" Grid.ColumnSpan="4" Margin="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource DeliveryOrange}" Width="30" Margin="0,2"><TextBlock Text="من" Foreground="White" TextAlignment="Center"/></Border>
                        <DatePicker Grid.Row="0" Grid.Column="1" SelectedDate="{Binding DateFrom, Mode=TwoWay}" Margin="2" FlowDirection="LeftToRight"/>
                        
                        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource DeliveryOrange}" Width="30" Margin="0,2"><TextBlock Text="إلى" Foreground="White" TextAlignment="Center"/></Border>
                        <DatePicker Grid.Row="1" Grid.Column="1" SelectedDate="{Binding DateTo, Mode=TwoWay}" Margin="2" FlowDirection="LeftToRight"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
