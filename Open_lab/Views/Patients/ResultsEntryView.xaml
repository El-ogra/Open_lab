<UserControl x:Class="Open_lab.Views.Patients.ResultsEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="#F3F7F0">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding LoadVisitTestsCommand}" />
        <KeyBinding Key="F8" Command="{Binding VerifyResultsCommand}" />
        <KeyBinding Key="F9" Command="{Binding ReopenResultsCommand}" />
        <KeyBinding Key="F12" Command="{Binding SaveResultsCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D7E0D2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="6" />
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="95" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Background" Value="#6E9F16" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource PanelStyle}">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock Text="من تاريخ" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <DatePicker SelectedDate="{Binding DateFrom}" Width="130" />
                    <TextBlock Text="إلى" VerticalAlignment="Center" Margin="12,0,6,0" />
                    <DatePicker SelectedDate="{Binding DateTo}" Width="130" />
                    <Button Content="F5 / Refresh" Command="{Binding LoadVisitTestsCommand}" Style="{StaticResource ActionButtonStyle}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="F2 بيانات المرضى" Command="{Binding DataContext.NavigatePatientRegistrationCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource ActionButtonStyle}" />
                    <Button Content="F3 البحث" Command="{Binding DataContext.NavigatePatientSearchCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource ActionButtonStyle}" />
                    <Button Content="F6 التسليم" Command="{Binding DataContext.NavigateDeliveryCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource ActionButtonStyle}" />
                    <Button Content="القائمة الرئيسية" Command="{Binding DataContext.NavigateToPatientsCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource ActionButtonStyle}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource PanelStyle}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="مرضى اليوم / تحاليل الفترة" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
                <DataGrid ItemsSource="{Binding VisitTests}"
                          SelectedItem="{Binding SelectedVisitTest}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="80" />
                        <DataGridTextColumn Header="المريض" Binding="{Binding PatientName}" Width="*" />
                        <DataGridTextColumn Header="التحليل" Binding="{Binding TestName}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="170" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding SelectedVisitTest.PatientName, TargetNullValue=لا يوجد مريض محدد}" FontSize="18" FontWeight="Bold" />
                    <TextBlock Grid.Column="1" Text="{Binding SelectedVisitTest.PatientGender, StringFormat=الجنس: {0}}" />
                    <TextBlock Grid.Column="2" Text="{Binding SelectedVisitTest.PatientAge, StringFormat=السن: {0}}" />
                    <Border Grid.Column="3" Background="#DFF0D8" Padding="8,3" CornerRadius="3">
                        <TextBlock Text="زيارات: -" HorizontalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource PanelStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="نافذة إدخال نتيجة التحليل المحدد" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
                    <DataGrid ItemsSource="{Binding ResultItems}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="البند" Binding="{Binding ParameterName}" IsReadOnly="True" Width="*" />
                            <DataGridTextColumn Header="النتيجة" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="170" />
                            <DataGridTextColumn Header="Flag" Binding="{Binding Flag}" Width="90" />
                            <DataGridTextColumn Header="تعليق" Binding="{Binding Comment}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <GroupBox Header="التعليق والتاريخ المرضي">
                        <TextBox Text="{Binding MedicalHistorySummary, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" />
                    </GroupBox>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Content="حفظ" Command="{Binding SaveResultsCommand}" Style="{StaticResource ActionButtonStyle}" />
                        <Button Content="اعتماد / F8" Command="{Binding VerifyResultsCommand}" Style="{StaticResource ActionButtonStyle}" />
                        <Button Content="إعادة فتح / F9" Command="{Binding ReopenResultsCommand}" Style="{StaticResource ActionButtonStyle}" Background="#D98B20" />
                        <Button Content="معاينة الطباعة" Style="{StaticResource ActionButtonStyle}" ToolTip="تحتاج ربط IPrintService بواجهة المعاينة." />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="#245423" Margin="8,0" />
        </Grid>

        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="الاختصارات: F2 بيانات المرضى، F3 البحث، F4 هذه الشاشة، F5 تحديث، F6 التسليم، F8 اعتماد، F9 إعادة فتح." Foreground="#566" Margin="8" />
    </Grid>
</UserControl>
