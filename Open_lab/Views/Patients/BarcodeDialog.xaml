<Window x:Class="Open_lab.Views.Patients.BarcodeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="طباعة الباركود"
        Width="720"
        Height="620"
        MinWidth="620"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft">
    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Background" Value="#6E9F16" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{Binding PatientName}" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="اضبط موضع الطباعة ثم اطبع الأكواد المطلوبة." Foreground="#566" Margin="0,4,0,10" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="كود الحالة" Margin="0,4">
                    <StackPanel>
                        <TextBlock Text="{Binding CaseCode}" FontWeight="SemiBold" />
                        <Image Source="{Binding CaseBarcode}" Height="92" Stretch="Uniform" />
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="كود الملف" Margin="0,4">
                    <StackPanel>
                        <TextBlock Text="{Binding FileCode}" FontWeight="SemiBold" />
                        <Image Source="{Binding FileBarcode}" Height="92" Stretch="Uniform" />
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="كود المعمل" Margin="0,4">
                    <StackPanel>
                        <TextBlock Text="{Binding LabCode}" FontWeight="SemiBold" />
                        <Image Source="{Binding LabBarcode}" Height="92" Stretch="Uniform" />
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="ملصقات الأنابيب" Margin="0,4">
                    <ItemsControl ItemsSource="{Binding TubeLabels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#D7E0D2" BorderThickness="1" Margin="3" Padding="6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Text}" />
                                        <Image Source="{Binding Barcode}" Height="64" Stretch="Uniform" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </GroupBox>

                <GroupBox Header="ضبط موضع الطباعة" Margin="0,8">
                    <UniformGrid Columns="2">
                        <StackPanel Margin="4">
                            <TextBlock Text="إزاحة أفقية" />
                            <Slider Minimum="-100" Maximum="100" Value="{Binding OffsetX}" />
                        </StackPanel>
                        <StackPanel Margin="4">
                            <TextBlock Text="إزاحة رأسية" />
                            <Slider Minimum="-100" Maximum="100" Value="{Binding OffsetY}" />
                        </StackPanel>
                    </UniformGrid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <WrapPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="طباعة كل الأكواد" Command="{Binding PrintAllCommand}" Style="{StaticResource ActionButtonStyle}" />
            <Button Content="طباعة الحالة" Command="{Binding PrintCaseCommand}" Style="{StaticResource ActionButtonStyle}" />
            <Button Content="طباعة الملف" Command="{Binding PrintFileCommand}" Style="{StaticResource ActionButtonStyle}" />
            <Button Content="طباعة المعمل" Command="{Binding PrintLabCommand}" Style="{StaticResource ActionButtonStyle}" />
            <Button Content="إغلاق" IsCancel="True" Style="{StaticResource ActionButtonStyle}" Background="#607D8B" />
        </WrapPanel>
    </Grid>
</Window>
