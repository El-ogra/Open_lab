<UserControl x:Class="Open_lab.Views.Patients.PatientRegistrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="#13314F">
    <UserControl.Resources>

        <!-- ========= ألوان الواجهة الموحدة ========= -->
        <SolidColorBrush x:Key="NavyBackground" Color="#13314F" />
        <SolidColorBrush x:Key="PanelBorder"    Color="#1F4F86" />
        <SolidColorBrush x:Key="HeaderOrange"   Color="#F39C12" />
        <SolidColorBrush x:Key="HeaderYellow"   Color="#F1C40F" />
        <SolidColorBrush x:Key="OliveGreen"     Color="#6E8B3D" />
        <SolidColorBrush x:Key="FreshGreen"     Color="#8DB600" />
        <SolidColorBrush x:Key="DangerRed"      Color="#D9534F" />
        <SolidColorBrush x:Key="InfoBlue"       Color="#2E86C1" />
        <SolidColorBrush x:Key="FieldLabelBg"   Color="#2980B9" />
        <SolidColorBrush x:Key="YellowPanel"    Color="#F4D03F" />

        <!-- ========= نمط ترويسة المجموعة (عنوان برتقالي) ========= -->
        <Style x:Key="GroupHeaderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource HeaderOrange}" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,8,-12" />
        </Style>
        <Style x:Key="GroupHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- ========= نمط الإطار الأزرق الرئيسي ========= -->
        <Style x:Key="GroupBoxStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource NavyBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,16,10,8" />
            <Setter Property="Margin" Value="6,8,6,4" />
        </Style>

        <!-- ========= نمط ليبل أزرق للحقول ========= -->
        <Style x:Key="FieldLabelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource FieldLabelBg}" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="MinWidth" Value="95" />
        </Style>
        <Style x:Key="FieldLabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ========= نمط أزرار الإجراءات (متعدد الألوان) ========= -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Background" Value="{StaticResource FreshGreen}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========= نمط أزرار العينات الخضراء ========= -->
        <Style x:Key="SampleButtonStyle" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="78" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Background" Value="{StaticResource FreshGreen}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F39C12" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========= نمط الـ CheckBox الزيتوني ========= -->
        <Style x:Key="OliveCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="2,2" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Background" Value="{StaticResource OliveGreen}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="2"
                                Padding="4,3">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Left"
                                        Width="16" Height="16"
                                        Background="White"
                                        BorderBrush="#444"
                                        BorderThickness="1"
                                        Margin="0,0,6,0">
                                    <Path x:Name="CheckMark"
                                          Stretch="Fill"
                                          Stroke="#1F4F86"
                                          StrokeThickness="2"
                                          Data="M 0 5 L 4 9 L 10 0"
                                          Margin="2"
                                          Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========= نمط حقل النص الأبيض ========= -->
        <Style x:Key="WhiteTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="BorderBrush" Value="#7FB3D5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Margin" Value="2" />
        </Style>

        <!-- ========= نمط ComboBox أبيض ========= -->
        <Style x:Key="WhiteComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Margin" Value="2" />
        </Style>

        <!-- ========= نمط الـ RadioButton ========= -->
        <Style x:Key="WhiteRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,12,0" />
        </Style>

    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- شريط التاريخ والوقت العلوي -->
            <RowDefinition Height="*" />
            <!-- المحتوى الرئيسي -->
            <RowDefinition Height="Auto" />
            <!-- شريط أزرار التحكم السفلي -->
            <RowDefinition Height="Auto" />
            <!-- شريط القائمة الرئيسية -->
            <RowDefinition Height="Auto" />
            <!-- رسالة الحالة -->
        </Grid.RowDefinitions>

        <!-- ============================================================ -->
        <!-- 1) الشريط العلوي: التاريخ والوقت (الاستلام + الدخول)         -->
        <!-- ============================================================ -->
        <Border Grid.Row="0" Style="{StaticResource GroupBoxStyle}" Padding="8" Margin="6,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- تاريخ الاستلام -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,12,0">
                    <Border Style="{StaticResource FieldLabelStyle}" MinWidth="110">
                        <TextBlock Text="تاريخ الاستلام" Style="{StaticResource FieldLabelText}" />
                    </Border>
                    <DatePicker Width="130" SelectedDate="{Binding ReceptionDate}" Margin="2" />
                    <TextBox Width="80"
                             Style="{StaticResource WhiteTextBoxStyle}"
                             Text="{Binding ReceptionTimeText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="وقت الاستلام (HH:mm tt)" />
                </StackPanel>

                <!-- تاريخ الدخول -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border Style="{StaticResource FieldLabelStyle}" MinWidth="110">
                        <TextBlock Text="تاريخ الدخول" Style="{StaticResource FieldLabelText}" />
                    </Border>
                    <DatePicker Width="130" SelectedDate="{Binding EntryDate}" Margin="2" />
                    <TextBox Width="80"
                             Style="{StaticResource WhiteTextBoxStyle}"
                             Text="{Binding EntryTimeText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="وقت الدخول (HH:mm tt)" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- 2) المنطقة الرئيسية: قائمة التحاليل (يسار) + البيانات (يمين) -->
        <!-- ============================================================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <!-- لوحة قائمة التحاليل + الملخص المالي -->
                <ColumnDefinition Width="1.85*" />
                <!-- لوحة بيانات المريض الكاملة -->
            </Grid.ColumnDefinitions>

            <!-- ============== العمود الأيسر: قائمة التحاليل + ملخص مالي ============== -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- *********** لوحة Routine test menu *********** -->
                <Border Grid.Row="0"
                        Background="{StaticResource YellowPanel}"
                        BorderBrush="#B7950B"
                        BorderThickness="1"
                        CornerRadius="3"
                        Margin="6,4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="160" />
                        </Grid.RowDefinitions>

                        <!-- العنوان -->
                        <Border Grid.Row="0" Background="#C0392B" CornerRadius="3" Padding="6">
                            <TextBlock Text="Routine test menu"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       FlowDirection="LeftToRight" />
                        </Border>

                        <!-- الصف الثاني: التصنيف + البحث -->
                        <Grid Grid.Row="1" Margin="4,6,4,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" SelectedIndex="0" Style="{StaticResource WhiteComboBoxStyle}"
                                      FlowDirection="LeftToRight">
                                <ComboBoxItem Content="Rotine Tests" />
                                <ComboBoxItem Content="Send Out" />
                                <ComboBoxItem Content="All" />
                            </ComboBox>
                            <TextBox Grid.Column="1"
                                     Style="{StaticResource WhiteTextBoxStyle}"
                                     Text="{Binding TestSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="كتابة جزء من اسم التحليل للفلترة" />
                        </Grid>

                        <!-- الصف الثالث: Selected Test + العداد -->
                        <Grid Grid.Row="2" Margin="4,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#1F4F86" CornerRadius="2" Padding="6,3"
                                    HorizontalAlignment="Stretch" Margin="0,0,4,0">
                                <TextBlock Text="Selected Test" Foreground="White" FontWeight="Bold"
                                           HorizontalAlignment="Center" FlowDirection="LeftToRight" />
                            </Border>
                            <Border Grid.Column="1" Background="#F39C12" CornerRadius="2" Padding="8,3"
                                    MinWidth="38">
                                <TextBlock Text="{Binding SelectedTests.Count}"
                                           Foreground="White" FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                            </Border>
                        </Grid>

                        <!-- قائمة التحاليل المتاحة -->
                        <DataGrid Grid.Row="3"
                                  Margin="4,4"
                                  Background="White"
                                  ItemsSource="{Binding AvailableTests}"
                                  SelectedItem="{Binding SelectedAvailableTest}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  RowBackground="White"
                                  AlternatingRowBackground="#F5F5F5"
                                  FlowDirection="LeftToRight">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Test Name" Binding="{Binding NameReport}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- أزرار قائمة التحاليل -->
                        <UniformGrid Grid.Row="4" Columns="3" Margin="4,4">
                            <Button Content="Add select test"
                                    Command="{Binding AddTestCommand}"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Background="#27AE60" />
                            <Button Content="Delete"
                                    Command="{Binding RemoveTestCommand}"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Background="#A6A66E" />
                            <Button Content="All"
                                    Command="{Binding AddAllTestsCommand}"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Background="#A6A66E" />
                        </UniformGrid>

                        <!-- التحاليل المختارة -->
                        <Border Grid.Row="6" Background="White" Margin="4,4" BorderBrush="#B7950B" BorderThickness="1">
                            <DataGrid ItemsSource="{Binding SelectedTests}"
                                      SelectedItem="{Binding SelectedTest}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      FlowDirection="LeftToRight">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Selected" Binding="{Binding TestName}" Width="*" />
                                    <DataGridTextColumn Header="Price"    Binding="{Binding Price}"    Width="70" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </Border>

                <!-- *********** الملخص المالي السفلي *********** -->
                <Border Grid.Row="1"
                        Background="{StaticResource HeaderOrange}"
                        BorderBrush="#B7950B"
                        BorderThickness="1"
                        CornerRadius="3"
                        Margin="6,4"
                        Padding="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- يسار: 3 أزرار الحركات والتراجع -->
                        <Border Grid.Row="0" Grid.Column="0" Background="#3CB371" CornerRadius="2" Padding="3,2" Margin="2">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="الباقي للمعمل" Foreground="White" FontWeight="Bold"
                                           DockPanel.Dock="Right" Margin="6,0" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding BalanceForLab, StringFormat=N1, Mode=OneWay}" Width="60"
                                         Style="{StaticResource WhiteTextBoxStyle}" IsReadOnly="True"
                                         HorizontalContentAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="1" Background="#2E86C1" CornerRadius="2" Padding="3,2" Margin="2">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="إجمالي التحاليل" Foreground="White" FontWeight="Bold"
                                           DockPanel.Dock="Right" Margin="6,0" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding TotalAmount, StringFormat=N1, Mode=OneWay}" Width="60"
                                         Style="{StaticResource WhiteTextBoxStyle}" IsReadOnly="True"
                                         HorizontalContentAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Background="#3CB371" CornerRadius="2" Padding="3,2" Margin="2">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="الباقي للمريض" Foreground="White" FontWeight="Bold"
                                           DockPanel.Dock="Right" Margin="6,0" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding BalanceForPatient, StringFormat=N1, Mode=OneWay}" Width="60"
                                         Style="{StaticResource WhiteTextBoxStyle}" IsReadOnly="True"
                                         HorizontalContentAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Background="#2E86C1" CornerRadius="2" Padding="3,2" Margin="2">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="الخصم %" Foreground="White" FontWeight="Bold"
                                           DockPanel.Dock="Right" Margin="6,0" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding DiscountPercent, UpdateSourceTrigger=PropertyChanged}" Width="60"
                                         Style="{StaticResource WhiteTextBoxStyle}"
                                         HorizontalContentAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="0" Background="White" CornerRadius="2" Padding="3,2" Margin="2">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="المدفوع" Foreground="#C0392B" FontWeight="Bold"
                                           DockPanel.Dock="Right" Margin="6,0" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged}" Width="60"
                                         Style="{StaticResource WhiteTextBoxStyle}"
                                         HorizontalContentAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="1" Background="#2E86C1" CornerRadius="2" Padding="3,2" Margin="2">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="قيمة الخصم" Foreground="White" FontWeight="Bold"
                                           DockPanel.Dock="Right" Margin="6,0" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding DiscountAmount, StringFormat=N1, Mode=OneWay}" Width="60"
                                         Style="{StaticResource WhiteTextBoxStyle}" IsReadOnly="True"
                                         HorizontalContentAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="3" Grid.Column="1" Background="#2E86C1" CornerRadius="2" Padding="3,2" Margin="2">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="التكلفة بعد الخصم" Foreground="White" FontWeight="Bold"
                                           DockPanel.Dock="Right" Margin="6,0" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding NetTotal, StringFormat=N1, Mode=OneWay}" Width="60"
                                         Style="{StaticResource WhiteTextBoxStyle}" IsReadOnly="True"
                                         HorizontalContentAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="4" Grid.Column="1" Background="#2E86C1" CornerRadius="2" Padding="3,2" Margin="2">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="المدفوع سابقا" Foreground="White" FontWeight="Bold"
                                           DockPanel.Dock="Right" Margin="6,0" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding PreviousPaidAmount, UpdateSourceTrigger=PropertyChanged}" Width="60"
                                         Style="{StaticResource WhiteTextBoxStyle}"
                                         HorizontalContentAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <!-- أزرار صغيرة -->
                        <UniformGrid Grid.Row="3" Grid.Column="0" Columns="3" Margin="2">
                            <Button Content="حركة" Command="{Binding ShowMovementCommand}" Style="{StaticResource ActionButtonStyle}" Background="#27AE60" MinWidth="50" Height="26"/>
                            <Button Content="تراجع" Command="{Binding UndoCommand}"        Style="{StaticResource ActionButtonStyle}" Background="#F1C40F" Foreground="Black" MinWidth="50" Height="26"/>
                            <Button Content="خالص" Command="{Binding SettleCommand}"      Style="{StaticResource ActionButtonStyle}" Background="#27AE60" MinWidth="50" Height="26"/>
                        </UniformGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============== العمود الأيمن: بيانات المريض + الجهة + المعلومات الإضافية ============== -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- ============ مجموعة بيانات المريض ============ -->
                    <Grid Margin="6,12,6,4">
                        <Border Style="{StaticResource GroupBoxStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*"    />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*"    />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- صف 0: Lab ID + كود المريض -->
                                <Border Grid.Row="0" Grid.Column="0" Background="#27AE60" CornerRadius="2" Padding="6,3" Margin="2">
                                    <TextBlock Text="Lab. ID" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBox Grid.Row="0" Grid.Column="1"
                                         Style="{StaticResource WhiteTextBoxStyle}"
                                         Text="{Binding LabId, UpdateSourceTrigger=PropertyChanged}" />
                                <Border Grid.Row="0" Grid.Column="2" Background="{StaticResource HeaderOrange}" CornerRadius="2" Padding="6,3" Margin="2">
                                    <TextBlock Text="كود المريض" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBox Grid.Row="0" Grid.Column="3"
                                         Style="{StaticResource WhiteTextBoxStyle}"
                                         Text="{Binding PatientCode, UpdateSourceTrigger=PropertyChanged}" />

                                <!-- صف 1: Sex + Individual -->
                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabelStyle}">
                                    <TextBlock Text="Sex" Style="{StaticResource FieldLabelText}" FlowDirection="LeftToRight"/>
                                </Border>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                    <RadioButton Content="Male"
                                                 Style="{StaticResource WhiteRadioStyle}"
                                                 IsChecked="{Binding Gender, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Male}" />
                                    <RadioButton Content="Female"
                                                 Style="{StaticResource WhiteRadioStyle}"
                                                 IsChecked="{Binding Gender, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Female}" />
                                    <RadioButton Content="Unknown"
                                                 Style="{StaticResource WhiteRadioStyle}"
                                                 IsChecked="{Binding Gender, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Unknown}" />
                                </StackPanel>
                                <CheckBox Grid.Row="1" Grid.Column="2" Content="VIP" Foreground="White"
                                          VerticalAlignment="Center" Margin="6,0"
                                          IsChecked="{Binding IsVip}" />
                                <ComboBox Grid.Row="1" Grid.Column="3"
                                          Style="{StaticResource WhiteComboBoxStyle}"
                                          SelectedItem="{Binding AccountType, Mode=TwoWay}"
                                          IsEditable="True">
                                    <ComboBoxItem Content="Individual" />
                                    <ComboBoxItem Content="Lab to Lab" />
                                </ComboBox>

                                <!-- صف 2: اسم المريض + اللقب -->
                                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabelStyle}">
                                    <TextBlock Text="اسم المريض" Style="{StaticResource FieldLabelText}" />
                                </Border>
                                <TextBox Grid.Row="2" Grid.Column="1"
                                         Style="{StaticResource WhiteTextBoxStyle}"
                                         Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" />
                                <ComboBox Grid.Row="2" Grid.Column="2"
                                          Style="{StaticResource WhiteComboBoxStyle}"
                                          SelectedItem="{Binding Title, Mode=TwoWay}"
                                          IsEditable="True"
                                          MinWidth="80">
                                    <ComboBoxItem Content="السيد/" />
                                    <ComboBoxItem Content="السيدة/" />
                                    <ComboBoxItem Content="الآنسة/" />
                                    <ComboBoxItem Content="الطفل/" />
                                </ComboBox>
                                <TextBox Grid.Row="2" Grid.Column="3"
                                         Style="{StaticResource WhiteTextBoxStyle}"
                                         Text="{Binding PatientTitleNote, UpdateSourceTrigger=PropertyChanged}" />

                                <!-- صف 3: السن + عنوان المريض -->
                                <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabelStyle}">
                                    <TextBlock Text="السن" Style="{StaticResource FieldLabelText}" />
                                </Border>
                                <Grid Grid.Row="3" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Style="{StaticResource WhiteTextBoxStyle}"
                                             Text="{Binding Age, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                    <ComboBox Grid.Column="1"
                                              Style="{StaticResource WhiteComboBoxStyle}"
                                              SelectedItem="{Binding AgeUnit, Mode=TwoWay}"
                                              IsEditable="True">
                                        <ComboBoxItem Content="Years" />
                                        <ComboBoxItem Content="Months" />
                                        <ComboBoxItem Content="Days" />
                                    </ComboBox>
                                </Grid>
                                <Border Grid.Row="3" Grid.Column="2" Style="{StaticResource FieldLabelStyle}">
                                    <TextBlock Text="عنوان المريض" Style="{StaticResource FieldLabelText}" />
                                </Border>
                                <TextBox Grid.Row="3" Grid.Column="3"
                                         Style="{StaticResource WhiteTextBoxStyle}"
                                         Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />

                                <!-- صف 4: تليفون + محمول -->
                                <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabelStyle}">
                                    <TextBlock Text="تليفون" Style="{StaticResource FieldLabelText}" />
                                </Border>
                                <TextBox Grid.Row="4" Grid.Column="1"
                                         Style="{StaticResource WhiteTextBoxStyle}"
                                         Text="{Binding HomePhone, UpdateSourceTrigger=PropertyChanged}" />
                                <Border Grid.Row="4" Grid.Column="2" Style="{StaticResource FieldLabelStyle}">
                                    <TextBlock Text="محمول" Style="{StaticResource FieldLabelText}" />
                                </Border>
                                <TextBox Grid.Row="4" Grid.Column="3"
                                         Style="{StaticResource WhiteTextBoxStyle}"
                                         Text="{Binding MobilePhone, UpdateSourceTrigger=PropertyChanged}" />

                                <!-- صف 5: رقم قومي + البريد الإلكتروني -->
                                <Border Grid.Row="5" Grid.Column="0" Style="{StaticResource FieldLabelStyle}">
                                    <TextBlock Text="رقم قومي" Style="{StaticResource FieldLabelText}" />
                                </Border>
                                <TextBox Grid.Row="5" Grid.Column="1"
                                         Style="{StaticResource WhiteTextBoxStyle}"
                                         Text="{Binding NationalId, UpdateSourceTrigger=PropertyChanged}" />
                                <Border Grid.Row="5" Grid.Column="2" Style="{StaticResource FieldLabelStyle}">
                                    <TextBlock Text="البريد الإلكتروني" Style="{StaticResource FieldLabelText}" />
                                </Border>
                                <TextBox Grid.Row="5" Grid.Column="3"
                                         Style="{StaticResource WhiteTextBoxStyle}"
                                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Border>
                        <!-- ترويسة المجموعة -->
                        <Border Style="{StaticResource GroupHeaderStyle}" VerticalAlignment="Top">
                            <TextBlock Text="بيانات المريض" Style="{StaticResource GroupHeaderText}" />
                        </Border>
                    </Grid>

                    <!-- ============ مجموعة بيانات الطبيب أو الجهة ============ -->
                    <Grid Margin="6,14,6,4">
                        <Border Style="{StaticResource GroupBoxStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*"    />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*"    />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- صف 0: جهة الإحالة -->
                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabelStyle}">
                                    <TextBlock Text="جهة الإحالة" Style="{StaticResource FieldLabelText}" />
                                </Border>
                                <ComboBox Grid.Row="0" Grid.Column="1"
                                          Style="{StaticResource WhiteComboBoxStyle}"
                                          ItemsSource="{Binding Referrals}"
                                          SelectedItem="{Binding SelectedReferral}"
                                          DisplayMemberPath="Name" />
                                <CheckBox Grid.Row="0" Grid.Column="2" Content="Print" Foreground="White"
                                          VerticalAlignment="Center" Margin="6,0"
                                          IsChecked="{Binding PrintReferralOnReport}" FlowDirection="LeftToRight" />
                                <ComboBox Grid.Row="0" Grid.Column="3"
                                          Style="{StaticResource WhiteComboBoxStyle}"
                                          SelectedItem="{Binding DoctorTitle, Mode=TwoWay}"
                                          IsEditable="True">
                                    <ComboBoxItem Content="د./" />
                                    <ComboBoxItem Content="أ.د./" />
                                    <ComboBoxItem Content="م.د./" />
                                </ComboBox>

                                <!-- صف 1: تليفون + عنوان الجهة -->
                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabelStyle}">
                                    <TextBlock Text="تليفون" Style="{StaticResource FieldLabelText}" />
                                </Border>
                                <TextBox Grid.Row="1" Grid.Column="1"
                                         Style="{StaticResource WhiteTextBoxStyle}"
                                         Text="{Binding ReferralPhone, UpdateSourceTrigger=PropertyChanged}" />
                                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource FieldLabelStyle}">
                                    <TextBlock Text="عنوان الجهة" Style="{StaticResource FieldLabelText}" />
                                </Border>
                                <TextBox Grid.Row="1" Grid.Column="3"
                                         Style="{StaticResource WhiteTextBoxStyle}"
                                         Text="{Binding ReferralAddress, UpdateSourceTrigger=PropertyChanged}" />

                                <!-- صف 2: تليفون + اسم المسؤول -->
                                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabelStyle}">
                                    <TextBlock Text="تليفون" Style="{StaticResource FieldLabelText}" />
                                </Border>
                                <TextBox Grid.Row="2" Grid.Column="1"
                                         Style="{StaticResource WhiteTextBoxStyle}"
                                         Text="{Binding ReferralAltPhone, UpdateSourceTrigger=PropertyChanged}" />
                                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource FieldLabelStyle}">
                                    <TextBlock Text="اسم المسؤول" Style="{StaticResource FieldLabelText}" />
                                </Border>
                                <TextBox Grid.Row="2" Grid.Column="3"
                                         Style="{StaticResource WhiteTextBoxStyle}"
                                         Text="{Binding ReferralResponsible, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource GroupHeaderStyle}" VerticalAlignment="Top">
                            <TextBlock Text="بيانات الطبيب أو الجهة" Style="{StaticResource GroupHeaderText}" />
                        </Border>
                    </Grid>

                    <!-- ============ مجموعة معلومات اضافية ============ -->
                    <Grid Margin="6,14,6,4">
                        <Border Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <!-- صف صائم + ساعات الصيام + هل سبق التحليل -->
                                <Grid Margin="2,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" Content="صائم" Style="{StaticResource OliveCheckBoxStyle}"
                                              IsChecked="{Binding IsFasting}" />
                                    <Border Grid.Column="1" Style="{StaticResource FieldLabelStyle}" MinWidth="125">
                                        <TextBlock Text="عدد ساعات الصيام" Style="{StaticResource FieldLabelText}" />
                                    </Border>
                                    <TextBox  Grid.Column="2"
                                              Style="{StaticResource WhiteTextBoxStyle}"
                                              Width="50"
                                              Text="{Binding FastingHours, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Grid.Column="5"
                                              Content="هل سبق لك التحليل بمعملنا"
                                              Style="{StaticResource OliveCheckBoxStyle}"
                                              IsChecked="{Binding HadPreviousAnalysisHere}" />
                                </Grid>

                                <!-- شبكة الـ checkboxes الإضافية (صفان × 4 أعمدة) -->
                                <UniformGrid Columns="4" Margin="2,2">
                                    <CheckBox Content="هل يأخذ علاج لسيولة الدم" Style="{StaticResource OliveCheckBoxStyle}" IsChecked="{Binding TakesBloodThinners}" />
                                    <CheckBox Content="هل يأخذ علاج مضاد حيوي"   Style="{StaticResource OliveCheckBoxStyle}" IsChecked="{Binding TakesAntibiotics}" />
                                    <CheckBox Content="هل سبق تك التحليل بمعملنا" Style="{StaticResource OliveCheckBoxStyle}" IsChecked="{Binding TakesDiabetesMedication}" />
                                    <CheckBox Content="هل يأخذ علاج للسكر"        Style="{StaticResource OliveCheckBoxStyle}" IsChecked="{Binding TakesDiabetesTreatment}" />

                                    <CheckBox Content="هل يأخذ علاج للفيروسات"    Style="{StaticResource OliveCheckBoxStyle}" IsChecked="{Binding TakesAntiVirals}" />
                                    <CheckBox Content="هل يأخذ علاج مضاد حيوي"   Style="{StaticResource OliveCheckBoxStyle}" IsChecked="{Binding TakesAntibioticAlt}" />
                                    <CheckBox Content="هل سبق نقل دم"             Style="{StaticResource OliveCheckBoxStyle}" IsChecked="{Binding HadBloodTransfusion}" />
                                    <CheckBox Content="هل يأخذ علاج للغدد"        Style="{StaticResource OliveCheckBoxStyle}" IsChecked="{Binding TakesGlandsTreatment}" />

                                    <CheckBox Content="للسيدات هل يوجد حمل"       Style="{StaticResource OliveCheckBoxStyle}" IsChecked="{Binding IsPregnant}" />
                                    <CheckBox Content="هل المريض مدخن"            Style="{StaticResource OliveCheckBoxStyle}" IsChecked="{Binding IsSmoker}" />
                                    <CheckBox Content="هل يأخذ علاج للكبد"        Style="{StaticResource OliveCheckBoxStyle}" IsChecked="{Binding TakesLiverTreatment}" />
                                    <CheckBox Content="هل تم عمل اشعة بالصبغة"    Style="{StaticResource OliveCheckBoxStyle}" IsChecked="{Binding HadContrastImaging}" />
                                </UniformGrid>

                                <!-- أزرار العينات -->
                                <WrapPanel Margin="2,8,2,2" FlowDirection="LeftToRight">
                                    <ToggleButton Content="Blood" Style="{StaticResource SampleButtonStyle}" IsChecked="{Binding HasBloodSample}" />
                                    <ToggleButton Content="Urine" Style="{StaticResource SampleButtonStyle}" IsChecked="{Binding HasUrineSample}" />
                                    <ToggleButton Content="Stool" Style="{StaticResource SampleButtonStyle}" IsChecked="{Binding HasStoolSample}" />
                                    <ToggleButton Content="Semen" Style="{StaticResource SampleButtonStyle}" IsChecked="{Binding HasSemenSample}" />
                                    <ToggleButton Content="CSF"   Style="{StaticResource SampleButtonStyle}" IsChecked="{Binding HasCsfSample}" />
                                    <ToggleButton Content="Taken outside Lab"
                                                  Style="{StaticResource SampleButtonStyle}"
                                                  Background="#F39C12"
                                                  MinWidth="135"
                                                  IsChecked="{Binding TakenOutsideLab}" />
                                </WrapPanel>

                                <!-- ملاحظات -->
                                <Grid Margin="2,4,2,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Style="{StaticResource WhiteTextBoxStyle}"
                                             MinHeight="46"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             Text="{Binding MedicalNotes, UpdateSourceTrigger=PropertyChanged}" />
                                    <Border Grid.Column="1" Background="{StaticResource HeaderOrange}" CornerRadius="2"
                                            Padding="10,4" Margin="2" VerticalAlignment="Center">
                                        <TextBlock Text="ملاحظات" Foreground="White" FontWeight="Bold" />
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource GroupHeaderStyle}" VerticalAlignment="Top">
                            <TextBlock Text="معلومات اضافية" Style="{StaticResource GroupHeaderText}" />
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============================================================ -->
        <!-- 3) شريط أزرار الإجراءات السفلي (الإرسال/الباركود/...)         -->
        <!-- ============================================================ -->
        <Border Grid.Row="2" Margin="6,4" Padding="4" Background="#1F4F86" CornerRadius="3">
            <WrapPanel HorizontalAlignment="Center">
                <Button Content="الإرسال"      Command="{Binding SendCommand}"        Style="{StaticResource ActionButtonStyle}" Background="#F1C40F" Foreground="Black" />
                <Button Content="الباركود"     Command="{Binding ShowBarcodeCommand}" Style="{StaticResource ActionButtonStyle}" Background="#27AE60" />
                <Button Content="حذف"          Command="{Binding DeleteCommand}"      Style="{StaticResource ActionButtonStyle}" Background="{StaticResource DangerRed}" />
                <Button Content="حفظ"          Command="{Binding SaveCommand}"        Style="{StaticResource ActionButtonStyle}" Background="#27AE60" />
                <Button Content="تعديل"        Command="{Binding EditCommand}"        Style="{StaticResource ActionButtonStyle}" Background="#27AE60" />
                <Button Content="إضافة مريض"   Command="{Binding NewCommand}"         Style="{StaticResource ActionButtonStyle}" Background="#27AE60" />
            </WrapPanel>
        </Border>

        <!-- ============================================================ -->
        <!-- 4) الشريط السفلي: القائمة الرئيسية + النتائج + مرضى اليوم    -->
        <!-- ============================================================ -->
        <Border Grid.Row="3" Margin="6,2" Padding="4" Background="#13314F">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="القائمة الرئيسية"
                        Command="{Binding DataContext.NavigateToPatientsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="#2E86C1"
                        MinWidth="130" />
                <Button Grid.Column="1" Content="نتائج التحاليل"
                        Command="{Binding DataContext.NavigateResultsEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="White"
                        Foreground="Black"
                        MinWidth="120" />
                <ComboBox Grid.Column="2"
                          Margin="6,2"
                          Style="{StaticResource WhiteComboBoxStyle}"
                          ItemsSource="{Binding QuickPatientsList}"
                          SelectedItem="{Binding QuickSelectedPatient}"
                          DisplayMemberPath="FullName" />
                <Button Grid.Column="3" Content="مرضى اليوم"
                        Command="{Binding ShowTodayPatientsCommand}"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="#2E86C1"
                        MinWidth="110" />
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- 5) رسالة الحالة (تظهر تحت كل شيء)                            -->
        <!-- ============================================================ -->
        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}"
                   Foreground="#F1C40F" Margin="12,2" FontWeight="Bold" />
    </Grid>
</UserControl>
