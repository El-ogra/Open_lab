<UserControl x:Class="Open_lab.Views.Patients.PatientRegistrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="LeftToRight"
             Background="#031E31"
             FontFamily="Tahoma"
             FontSize="11">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PageBlue" Color="#031E31" />
        <SolidColorBrush x:Key="PanelBlue" Color="#0B4E79" />
        <SolidColorBrush x:Key="DarkPanel" Color="#38594F" />
        <SolidColorBrush x:Key="FieldBlue" Color="#2F8FD5" />
        <SolidColorBrush x:Key="HotGreen" Color="#B8F10F" />
        <SolidColorBrush x:Key="FormGreen" Color="#B4EF12" />
        <SolidColorBrush x:Key="TealGreen" Color="#04B99E" />
        <SolidColorBrush x:Key="Yellow" Color="#FFF26A" />
        <SolidColorBrush x:Key="Orange" Color="#F2A21A" />
        <SolidColorBrush x:Key="Red" Color="#E8291F" />
        <SolidColorBrush x:Key="GridLine" Color="#80907D" />

        <Style TargetType="TextBox" x:Key="Box">
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Padding" Value="3,0" />
            <Setter Property="Background" Value="#F7F7F7" />
            <Setter Property="BorderBrush" Value="#8DA9BD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FlowDirection" Value="RightToLeft" />
        </Style>

        <Style TargetType="ComboBox" x:Key="Combo">
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Background" Value="#F7F7F7" />
            <Setter Property="BorderBrush" Value="#8DA9BD" />
            <Setter Property="FlowDirection" Value="RightToLeft" />
        </Style>

        <Style TargetType="Border" x:Key="BlueLabel">
            <Setter Property="Height" Value="22" />
            <Setter Property="MinWidth" Value="86" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Background" Value="{StaticResource FieldBlue}" />
        </Style>

        <Style TargetType="TextBlock" x:Key="LabelText">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style TargetType="Button" x:Key="FlatButton">
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="BorderBrush" Value="#31536B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="MainActionButton" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="{StaticResource HotGreen}" />
            <Setter Property="Foreground" Value="#173000" />
        </Style>

        <Style TargetType="CheckBox" x:Key="SampleCheck">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="FlowDirection" Value="LeftToRight" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="CheckBox" x:Key="MedicalCheck">
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Left"
                                        Width="14"
                                        Height="14"
                                        Margin="3,0,5,0"
                                        Background="#EFFFFB"
                                        BorderBrush="#033B39"
                                        BorderThickness="1">
                                    <Path x:Name="Tick"
                                          Data="M 1 7 L 5 11 L 13 1"
                                          Stroke="#039A34"
                                          StrokeThickness="2"
                                          Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid" x:Key="ListGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="None" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource GridLine}" />
            <Setter Property="RowHeight" Value="19" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Background" Value="#ECF6D9" />
            <Setter Property="BorderBrush" Value="#1C271C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="SelectionMode" Value="Single" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="4" Background="{StaticResource PageBlue}" FlowDirection="LeftToRight">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="44*" />
            <ColumnDefinition Width="56*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="152" />
        </Grid.RowDefinitions>

        <Border Grid.Column="0"
                Grid.Row="0"
                BorderBrush="#FFF200"
                BorderThickness="2"
                Margin="0,0,6,0"
                Padding="6"
                FlowDirection="LeftToRight">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="27" />
                    <RowDefinition Height="24" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="148" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="start"
                            Command="{Binding StartCommand}"
                            Style="{StaticResource FlatButton}"
                            Background="{StaticResource HotGreen}" />
                    <TextBox Grid.Column="1"
                             Style="{StaticResource Box}"
                             Text="{Binding TestSearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <RadioButton Grid.Column="2"
                                 Content="TM"
                                 IsChecked="{Binding TestCategoryFilter, Converter={StaticResource StringEqualsConverter}, ConverterParameter=TM}"
                                 VerticalAlignment="Center"
                                 FontWeight="Bold"
                                 Foreground="#FFF200" />
                    <RadioButton Grid.Column="3"
                                 Content="TG"
                                 IsChecked="{Binding TestCategoryFilter, Converter={StaticResource StringEqualsConverter}, ConverterParameter=TG}"
                                 VerticalAlignment="Center"
                                 FontWeight="Bold"
                                 Foreground="#FFF200" />
                    <RadioButton Grid.Column="4"
                                 Content="CC"
                                 IsChecked="{Binding TestCategoryFilter, Converter={StaticResource StringEqualsConverter}, ConverterParameter=CC}"
                                 VerticalAlignment="Center"
                                 FontWeight="Bold"
                                 Foreground="#FFF200" />
                    <TextBlock Grid.Column="5"
                               Text="complete test menu"
                               Foreground="#FFCB00"
                               FontStyle="Italic"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58*" />
                        <ColumnDefinition Width="42*" />
                    </Grid.ColumnDefinitions>

                    <DataGrid x:Name="AvailableTestsList"
                              Grid.Column="0"
                              Style="{StaticResource ListGrid}"
                              ItemsSource="{Binding AvailableTests}"
                              SelectedItem="{Binding SelectedAvailableTest}"
                              FlowDirection="LeftToRight">
                        <DataGrid.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding AddSelectedTestCommand}" />
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding NameReport}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Column="1" Margin="6,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="46" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource FormGreen}">
                                <TextBlock Text="Patient's tests"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <Border Grid.Column="1" Background="#CF3A00">
                                <TextBlock Text="{Binding SelectedTests.Count}"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <DataGrid Grid.Row="1"
                                  Style="{StaticResource ListGrid}"
                                  Background="{StaticResource DarkPanel}"
                                  Foreground="White"
                                  ItemsSource="{Binding SelectedTests}"
                                  SelectedItem="{Binding SelectedTest}"
                                  FlowDirection="LeftToRight">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding TestName}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>

                <Grid Grid.Row="2" Margin="0,4,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="64" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="Add select test"
                            Command="{Binding AddTestCommand}"
                            Style="{StaticResource FlatButton}"
                            Background="{StaticResource HotGreen}" />
                    <Button Grid.Column="1"
                            Content="Delete"
                            Command="{Binding RemoveTestCommand}"
                            Style="{StaticResource FlatButton}"
                            Background="{StaticResource HotGreen}" />
                    <Button Grid.Column="2"
                            Content="All"
                            Command="{Binding AddAllTestsCommand}"
                            Style="{StaticResource FlatButton}"
                            Background="{StaticResource HotGreen}" />
                </Grid>

                <Border Grid.Row="3" Background="{StaticResource Orange}" Padding="3,0">
                    <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" VerticalAlignment="Center">
                        <TextBlock Text="Taken outside lab"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Margin="0,0,8,0" />
                        <CheckBox Content="Urine" IsChecked="{Binding HasUrineSample}" Style="{StaticResource SampleCheck}" />
                        <CheckBox Content="Stool" IsChecked="{Binding HasStoolSample}" Style="{StaticResource SampleCheck}" />
                        <CheckBox Content="Blood" IsChecked="{Binding HasBloodSample}" Style="{StaticResource SampleCheck}" Foreground="#D10000" />
                        <CheckBox Content="Semen" IsChecked="{Binding HasSemenSample}" Style="{StaticResource SampleCheck}" />
                        <CheckBox Content="CSF" IsChecked="{Binding HasCsfSample}" Style="{StaticResource SampleCheck}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

            <Grid Grid.Column="1" Grid.Row="0" FlowDirection="RightToLeft" IsEnabled="{Binding IsEditMode}">
            <Grid.RowDefinitions>
                <RowDefinition Height="61" />
                <RowDefinition Height="118" />
                <RowDefinition Height="74" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#ED3C35" Padding="8,6" Margin="0,0,0,7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24" />
                        <RowDefinition Height="24" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="96" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource Yellow}" Margin="1">
                        <TextBlock Text="تاريخ الدخول" Foreground="#12900E" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <DatePicker Grid.Row="0" Grid.Column="1" SelectedDate="{Binding EntryDate}" />
                    <TextBox Grid.Row="0" Grid.Column="2" Style="{StaticResource Box}" Text="{Binding EntryTimeText, UpdateSourceTrigger=PropertyChanged}" Foreground="#12900E" HorizontalContentAlignment="Center" />
                    <Border Grid.Row="0" Grid.Column="3" Background="{StaticResource Yellow}" Margin="1">
                        <TextBlock Text="تاريخ الاستلام" Foreground="#12900E" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <DatePicker Grid.Row="0" Grid.Column="4" SelectedDate="{Binding ReceptionDate}" />
                    <TextBox Grid.Row="0" Grid.Column="5" Style="{StaticResource Box}" Text="{Binding ReceptionTimeText, UpdateSourceTrigger=PropertyChanged}" Foreground="#12900E" HorizontalContentAlignment="Center" />

                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource BlueLabel}">
                        <TextBlock Text="كود المريض" Style="{StaticResource LabelText}" />
                    </Border>
                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Box}" Text="{Binding PatientCode, UpdateSourceTrigger=PropertyChanged}" />
                    <Border Grid.Row="1" Grid.Column="2" Background="#12BDE2" Margin="1">
                        <CheckBox Content="VIP" IsChecked="{Binding IsVip}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="Bold" />
                    </Border>
                    <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource BlueLabel}">
                        <TextBlock Text="Lab. ID" Style="{StaticResource LabelText}" />
                    </Border>
                    <TextBox Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="2" Style="{StaticResource Box}" Text="{Binding LabId, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="{StaticResource PanelBlue}" Padding="8" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25" />
                        <RowDefinition Height="25" />
                        <RowDefinition Height="25" />
                        <RowDefinition Height="25" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="124" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource BlueLabel}">
                            <TextBlock Text="اسم المريض" Style="{StaticResource LabelText}" />
                        </Border>
                        <ComboBox Grid.Column="1" Style="{StaticResource Combo}" SelectedItem="{Binding Title, Mode=TwoWay}" IsEditable="True">
                            <ComboBoxItem Content="السيد/" />
                            <ComboBoxItem Content="السيدة/" />
                            <ComboBoxItem Content="الآنسة/" />
                            <ComboBoxItem Content="الطفل/" />
                        </ComboBox>
                        <TextBox Grid.Column="2" Style="{StaticResource Box}" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" FontWeight="Bold" Foreground="#0B2CFF" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal" FlowDirection="LeftToRight" Background="#FFE7D4" Margin="1" VerticalAlignment="Stretch">
                            <RadioButton Content="Male" IsChecked="{Binding Gender, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Male}" VerticalAlignment="Center" Margin="4,0" FontWeight="Bold" Foreground="#B60000" />
                            <RadioButton Content="Female" IsChecked="{Binding Gender, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Female}" VerticalAlignment="Center" Margin="4,0" FontWeight="Bold" Foreground="#B60000" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="126" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource BlueLabel}">
                            <TextBlock Text="موبايل/تليفون" Style="{StaticResource LabelText}" />
                        </Border>
                        <TextBox Grid.Column="1" Style="{StaticResource Box}" Text="{Binding MobilePhone, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Grid.Column="2" Style="{StaticResource Box}" Text="{Binding HomePhone, UpdateSourceTrigger=PropertyChanged}" />
                        <Border Grid.Column="3" Style="{StaticResource BlueLabel}" MinWidth="70">
                            <TextBlock Text="سن المريض" Style="{StaticResource LabelText}" />
                        </Border>
                        <Grid Grid.Column="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="55" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource Box}" Text="{Binding Age, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" HorizontalContentAlignment="Center" />
                        <ComboBox Grid.Column="1" Style="{StaticResource Combo}" SelectedItem="{Binding AgeUnit, Mode=TwoWay}" IsEditable="True">
                            <ComboBoxItem Content="Year" />
                            <ComboBoxItem Content="Month" />
                            <ComboBoxItem Content="Day" />
                        </ComboBox>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="190" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource BlueLabel}">
                            <TextBlock Text="رقم البطاقة" Style="{StaticResource LabelText}" />
                        </Border>
                        <TextBox Grid.Column="1" Style="{StaticResource Box}" Text="{Binding NationalId, UpdateSourceTrigger=PropertyChanged}" />
                        <Border Grid.Column="2" Style="{StaticResource BlueLabel}">
                            <TextBlock Text="نوع الحساب" Style="{StaticResource LabelText}" />
                        </Border>
                        <ComboBox Grid.Column="3" Style="{StaticResource Combo}" SelectedItem="{Binding AccountType, Mode=TwoWay}" IsEditable="True">
                            <ComboBoxItem Content="Individual" />
                            <ComboBoxItem Content="Contract" />
                            <ComboBoxItem Content="Insurance" />
                        </ComboBox>
                    </Grid>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource BlueLabel}">
                            <TextBlock Text="عنوان المريض" Style="{StaticResource LabelText}" />
                        </Border>
                        <TextBox Grid.Column="1" Style="{StaticResource Box}" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="{StaticResource PanelBlue}" Padding="8" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26" />
                        <RowDefinition Height="26" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="92" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource FormGreen}" Margin="1">
                        <TextBlock Text="الطبيب المعالج" Style="{StaticResource LabelText}" />
                    </Border>
                    <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource Combo}" SelectedItem="{Binding DoctorTitle, Mode=TwoWay}" IsEditable="True">
                        <ComboBoxItem Content="د./" />
                        <ComboBoxItem Content="أ.د/" />
                        <ComboBoxItem Content="أ./" />
                    </ComboBox>
                    <TextBox Grid.Row="0" Grid.Column="2" Style="{StaticResource Box}" Text="{Binding ReferralTitleNote, UpdateSourceTrigger=PropertyChanged}" FontWeight="Bold" Foreground="#166C00" />
                    <CheckBox Grid.Row="0" Grid.Column="3"
                                  Content="Print"
                                  IsChecked="{Binding PrintReferralOnReport}"
                                  Foreground="White"
                                  FontWeight="Bold"
                                  FlowDirection="LeftToRight"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center" />

                    <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource FormGreen}" Margin="1">
                        <TextBlock Text="جهة الإحالة" Style="{StaticResource LabelText}" />
                    </Border>
                    <ComboBox Grid.Row="1"
                              Grid.Column="1"
                              Grid.ColumnSpan="2"
                              Style="{StaticResource Combo}"
                              ItemsSource="{Binding Referrals}"
                              SelectedItem="{Binding SelectedReferral}"
                              Text="{Binding ReferralSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              DisplayMemberPath="Name"
                              IsEditable="True"
                              IsTextSearchEnabled="True"
                              StaysOpenOnEdit="True" />
                </Grid>
            </Border>

            <Border Grid.Row="3" Background="{StaticResource PanelBlue}" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25" />
                        <RowDefinition Height="25" />
                        <RowDefinition Height="25" />
                        <RowDefinition Height="25" />
                        <RowDefinition Height="25" />
                        <RowDefinition Height="25" />
                        <RowDefinition Height="34" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="112" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Row="0" Grid.Column="0" Content="هل يأخذ علاج السكر" Background="{StaticResource TealGreen}" Style="{StaticResource MedicalCheck}" IsChecked="{Binding TakesDiabetesTreatment}" />
                    <CheckBox Grid.Row="0" Grid.Column="1" Content="مريض فقر الدم" Background="{StaticResource Yellow}" Foreground="#790000" Style="{StaticResource MedicalCheck}" IsChecked="{Binding HasAnemia}" />
                    <TextBox Grid.Row="0" Grid.Column="2" Style="{StaticResource Box}" Text="{Binding FastingHours, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" />
                    <CheckBox Grid.Row="0" Grid.Column="3" Content="صائم" Background="{StaticResource Orange}" Style="{StaticResource MedicalCheck}" IsChecked="{Binding IsFasting}" />

                    <CheckBox Grid.Row="1" Grid.Column="0" Content="هل يأخذ علاج للغدة" Background="{StaticResource TealGreen}" Style="{StaticResource MedicalCheck}" IsChecked="{Binding TakesGlandsTreatment}" />
                    <CheckBox Grid.Row="1" Grid.Column="1" Content="مريض بالتهاب المفاصل" Background="{StaticResource Yellow}" Foreground="#790000" Style="{StaticResource MedicalCheck}" IsChecked="{Binding HasJointInflammation}" />
                    <Border Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Background="{StaticResource Yellow}" Margin="1">
                        <TextBlock Text="عدد ساعات الصيام" Foreground="#AC0000" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <CheckBox Grid.Row="2" Grid.Column="0" Content="هل يأخذ مضاد حيوي" Background="{StaticResource TealGreen}" Style="{StaticResource MedicalCheck}" IsChecked="{Binding TakesAntibiotics}" />
                    <CheckBox Grid.Row="2" Grid.Column="1" Content="مريض بالضغط الدم" Background="{StaticResource Yellow}" Foreground="#790000" Style="{StaticResource MedicalCheck}" IsChecked="{Binding HasHypertension}" />
                    <CheckBox Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Content="هل يأخذ علاج لسيولة الدم" Background="{StaticResource TealGreen}" Style="{StaticResource MedicalCheck}" IsChecked="{Binding TakesBloodThinners}" />

                    <CheckBox Grid.Row="3" Grid.Column="0" Content="هل يأخذ علاج للكبد" Background="{StaticResource TealGreen}" Style="{StaticResource MedicalCheck}" IsChecked="{Binding TakesLiverTreatment}" />
                    <CheckBox Grid.Row="3" Grid.Column="1" Content="مريض بالفشل الكلوي" Background="{StaticResource Yellow}" Foreground="#790000" Style="{StaticResource MedicalCheck}" IsChecked="{Binding HasKidneyFailure}" />
                    <CheckBox Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" Content="هل يأخذ علاج للفيروسات" Background="{StaticResource TealGreen}" Style="{StaticResource MedicalCheck}" IsChecked="{Binding TakesAntiVirals}" />

                    <CheckBox Grid.Row="4" Grid.Column="0" Content="للسيدات هل يوجد حمل" Background="{StaticResource TealGreen}" Style="{StaticResource MedicalCheck}" IsChecked="{Binding IsPregnant}" />
                    <CheckBox Grid.Row="4" Grid.Column="1" Content="مريض بالإصابة بمرض مزمن" Background="{StaticResource Yellow}" Foreground="#790000" Style="{StaticResource MedicalCheck}" IsChecked="{Binding HasChronicDisease}" />
                    <CheckBox Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2" Content="مضاعفات الحمل" Background="{StaticResource Yellow}" Foreground="#790000" Style="{StaticResource MedicalCheck}" IsChecked="{Binding HasPregnancyComplication}" />
                    <CheckBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4" Content="هل تم عمل اشعة بالصبغة او بالموجات الصوتيه خلال يومين" Background="{StaticResource TealGreen}" Style="{StaticResource MedicalCheck}" IsChecked="{Binding HadContrastImaging}" />

                    <TextBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource Box}" Height="30" Text="{Binding MedicalNotes, UpdateSourceTrigger=PropertyChanged}" />
                    <Border Grid.Row="6" Grid.Column="3" Background="{StaticResource Orange}" Margin="1">
                        <TextBlock Text="ملاحظات" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Column="0" Grid.Row="1" Background="#F2D100" BorderBrush="#FFF200" BorderThickness="0,2,0,0" Padding="6,4" FlowDirection="LeftToRight">
            <Grid HorizontalAlignment="Left" Width="424">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="58" />
                    <ColumnDefinition Width="112" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="22" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="30" />
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0" Grid.Column="0" Style="{StaticResource Box}" Text="{Binding BalanceForLab, StringFormat=N1, Mode=OneWay}" Background="#31B34B" Foreground="White" FontWeight="Bold" HorizontalContentAlignment="Center" />
                <Border Grid.Row="0" Grid.Column="1" Background="#F58220" Margin="1">
                    <TextBlock Text="الباقي للمعمل" Style="{StaticResource LabelText}" />
                </Border>
                <TextBox Grid.Row="0" Grid.Column="4" Style="{StaticResource Box}" Text="{Binding TotalAmount, StringFormat=N0, Mode=OneWay}" Background="#2B8DEB" Foreground="White" FontWeight="Bold" HorizontalContentAlignment="Center" />
                <Border Grid.Row="0" Grid.Column="5" Background="#D71919" Margin="1">
                    <TextBlock Text="اجمالي التحاليل" Style="{StaticResource LabelText}" FontSize="10" />
                </Border>

                <TextBox Grid.Row="1" Grid.Column="0" Style="{StaticResource Box}" Text="{Binding BalanceForPatient, StringFormat=N1, Mode=OneWay}" Background="#31B34B" Foreground="White" FontWeight="Bold" HorizontalContentAlignment="Center" />
                <Border Grid.Row="1" Grid.Column="1" Background="#F58220" Margin="1">
                    <TextBlock Text="الباقي للمريض" Style="{StaticResource LabelText}" />
                </Border>
                <Border Grid.Row="1" Grid.Column="3" Background="#2B8DEB" Margin="1">
                    <TextBlock Text="%" Style="{StaticResource LabelText}" />
                </Border>
                <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource Box}" Text="{Binding DiscountPercent, UpdateSourceTrigger=PropertyChanged}" Background="White" HorizontalContentAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="4" Style="{StaticResource Box}" Text="{Binding DiscountValue, UpdateSourceTrigger=PropertyChanged}" Background="White" HorizontalContentAlignment="Center" />
                <Border Grid.Row="1" Grid.Column="5" Background="#1C71C9" Margin="1">
                    <TextBlock Text="الخصم" Style="{StaticResource LabelText}" />
                </Border>

                <TextBox Grid.Row="2" Grid.Column="0" Style="{StaticResource Box}" Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" />
                <Border Grid.Row="2" Grid.Column="1" Background="#D71919" Margin="1">
                    <TextBlock Text="المدفوع" Style="{StaticResource LabelText}" />
                </Border>
                <TextBox Grid.Row="2" Grid.Column="4" Style="{StaticResource Box}" Text="{Binding DiscountAmount, StringFormat=N1, Mode=OneWay}" Background="#2B8DEB" Foreground="White" FontWeight="Bold" HorizontalContentAlignment="Center" />
                <Border Grid.Row="2" Grid.Column="5" Background="#1C71C9" Margin="1">
                    <TextBlock Text="قيمة الخصم" Style="{StaticResource LabelText}" />
                </Border>

                <TextBox Grid.Row="3" Grid.Column="4" Style="{StaticResource Box}" Text="{Binding NetTotal, StringFormat=N1, Mode=OneWay}" Background="#2B8DEB" Foreground="White" FontWeight="Bold" HorizontalContentAlignment="Center" />
                <Border Grid.Row="3" Grid.Column="5" Background="#1C71C9" Margin="1">
                    <TextBlock Text="التكلفة بعض الخصم" Style="{StaticResource LabelText}" FontSize="10" />
                </Border>

                <TextBox Grid.Row="4" Grid.Column="4" Style="{StaticResource Box}" Text="{Binding PreviousPaidAmount, UpdateSourceTrigger=PropertyChanged}" Background="#2B8DEB" Foreground="White" FontWeight="Bold" HorizontalContentAlignment="Center" />
                <Border Grid.Row="4" Grid.Column="5" Background="#1C71C9" Margin="1">
                    <TextBlock Text="المدفوع سابقا" Style="{StaticResource LabelText}" />
                </Border>

                <Button Grid.Row="5" Grid.Column="0" Content="موافق" Command="{Binding SaveCommand}" Style="{StaticResource MainActionButton}" Height="26" />
                <Button Grid.Row="5" Grid.Column="1" Content="تراجع" Command="{Binding UndoCommand}" Style="{StaticResource MainActionButton}" Height="26" />
                <Button Grid.Row="5" Grid.Column="2" Grid.ColumnSpan="2" Content="خالص" Command="{Binding SettleCommand}" Style="{StaticResource MainActionButton}" Height="26" />
            </Grid>
        </Border>

        <Border Grid.Column="1" Grid.Row="1" Background="{StaticResource PageBlue}" BorderBrush="#FFF200" BorderThickness="0,2,0,0" Padding="0,7,0,0" FlowDirection="RightToLeft">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="36" />
                    <RowDefinition Height="43" />
                </Grid.RowDefinitions>
                <UniformGrid Grid.Row="0" Columns="4" Rows="1">
                    <Button Content="تراجع  ✖" Command="{Binding UndoCommand}" Style="{StaticResource MainActionButton}" Foreground="#E00000" />
                    <Button Content="حفظ  ✔" Command="{Binding SaveCommand}" Style="{StaticResource MainActionButton}" Foreground="#047A00" />
                    <Button Content="تعديل  👤" Command="{Binding EditCommand}" Style="{StaticResource MainActionButton}" />
                    <Button Content="إضافة  👤" Command="{Binding NewCommand}" Style="{StaticResource MainActionButton}" />
                </UniformGrid>

                <UniformGrid Grid.Row="1" Columns="4" Rows="1">
                    <Button Content="الكارنية" Command="{Binding InsuranceCommand}" Style="{StaticResource MainActionButton}" Background="#FFE214" />
                    <Button Content="ورقة العمل" Command="{Binding WorksheetCommand}" Style="{StaticResource MainActionButton}" Background="#FFE214" />
                    <Button Content="الباركود" Command="{Binding ShowBarcodeCommand}" Style="{StaticResource MainActionButton}" Background="#FFE214" />
                    <Button Content="الإيصال" Command="{Binding PrintReceiptCommand}" Style="{StaticResource MainActionButton}" Background="#FFE214" />
                </UniformGrid>

                <Border Grid.Row="2" BorderBrush="#FFF200" BorderThickness="2" Padding="2" Margin="0,2,0,0">
                    <UniformGrid Columns="3" Rows="1">
                        <Button Content="القائمة الرئيسية" Command="{Binding GoToHomeCommand}" Style="{StaticResource MainActionButton}" Background="#2E4E9D" Foreground="White" />
                        <Button Content="نتائج التحاليل" Command="{Binding GoToResultsCommand}" Style="{StaticResource MainActionButton}" Background="#F2F1D8" />
                        <Button Content="قائمة المرضى" x:Name="QuickPatientsListButton" Command="{Binding ShowTodayPatientsCommand}" Style="{StaticResource MainActionButton}" Background="#00B1E8" Foreground="White" />
                    </UniformGrid>
                </Border>

                <Popup PlacementTarget="{Binding ElementName=QuickPatientsListButton}"
                       Placement="Top"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       IsOpen="{Binding IsQuickPatientsListVisible, Mode=TwoWay}">
                    <Border Background="White" BorderBrush="#00B1E8" BorderThickness="2" Padding="4" MinWidth="320" MaxHeight="360">
                        <DataGrid ItemsSource="{Binding QuickPatientsList}"
                                  SelectedItem="{Binding QuickSelectedPatient}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  FlowDirection="LeftToRight">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="LabId" Binding="{Binding LabId}" Width="100" />
                                <DataGridTextColumn Header="الاسم" Binding="{Binding FullName}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Popup>
            </Grid>
        </Border>
    </Grid>
</UserControl>
