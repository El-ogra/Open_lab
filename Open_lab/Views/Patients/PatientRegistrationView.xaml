                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="تعديل" VerticalAlignment="Center"
                                               HorizontalAlignment="Right" Margin="4,0,2,0" />
                                    <TextBlock Grid.Column="1" Text="&#xE70F;" Style="{StaticResource SidebarIconGlyph}" />
                                </Grid>
                            </Button>
                            <Button Command="{Binding SaveCommand}"
                                    Style="{StaticResource SidebarActionButtonStyle}"
                                    Background="{StaticResource SidebarLime}">
