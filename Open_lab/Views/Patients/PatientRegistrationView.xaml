<UserControl x:Class="Open_lab.Views.Patients.PatientRegistrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="#13314F">

    <UserControl.Resources>

        <!-- ========= ألوان الواجهة ========= -->
        <SolidColorBrush x:Key="NavyBackground"  Color="#13314F" />
        <SolidColorBrush x:Key="PanelBorder"     Color="#1F4F86" />
        <SolidColorBrush x:Key="HeaderOrange"    Color="#D35400" />
        <SolidColorBrush x:Key="BrightOrange"    Color="#E67E22" />
        <SolidColorBrush x:Key="HeaderYellow"    Color="#F1C40F" />
        <SolidColorBrush x:Key="OliveGreen"      Color="#808000" />
        <SolidColorBrush x:Key="FreshGreen"      Color="#27AE60" />
        <SolidColorBrush x:Key="LimeGreen"       Color="#8DB600" />
        <SolidColorBrush x:Key="DangerRed"       Color="#C0392B" />
        <SolidColorBrush x:Key="InfoBlue"        Color="#2980B9" />
        <SolidColorBrush x:Key="LabelBlue"       Color="#3498DB" />
        <SolidColorBrush x:Key="YellowPanel"     Color="#F1C40F" />
        <SolidColorBrush x:Key="DarkBlueHeader"  Color="#0B243B" />
        <SolidColorBrush x:Key="CyanLabel"       Color="#00838F" />
        <SolidColorBrush x:Key="TestListBg"      Color="#C62828" />

        <!-- ========= نمط ترويسة المجموعة ========= -->
        <Style x:Key="GroupHeaderStyle" TargetType="Border">
            <Setter Property="Background"          Value="{StaticResource DarkBlueHeader}" />
            <Setter Property="CornerRadius"        Value="2" />
            <Setter Property="Padding"             Value="10,2" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin"              Value="0,0,10,-12" />
            <Setter Property="BorderBrush"         Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness"     Value="1" />
        </Style>
        <Style x:Key="GroupHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{StaticResource HeaderYellow}" />
            <Setter Property="FontWeight"  Value="Bold" />
            <Setter Property="FontSize"    Value="12" />
        </Style>

        <!-- ========= نمط الإطار الأزرق ========= -->
        <Style x:Key="GroupBoxStyle" TargetType="Border">
            <Setter Property="Background"       Value="Transparent" />
            <Setter Property="BorderBrush"      Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness"  Value="1" />
            <Setter Property="CornerRadius"     Value="2" />
            <Setter Property="Padding"          Value="6,14,6,6" />
            <Setter Property="Margin"           Value="4,6,4,2" />
        </Style>

        <!-- ========= نمط ليبل الحقل (أزرق) ========= -->
        <Style x:Key="FieldLabelStyle" TargetType="Border">
            <Setter Property="Background"       Value="{StaticResource LabelBlue}" />
            <Setter Property="CornerRadius"     Value="1" />
            <Setter Property="Padding"          Value="4,2" />
            <Setter Property="Margin"           Value="1" />
            <Setter Property="MinWidth"         Value="80" />
            <Setter Property="Height"           Value="24" />
        </Style>
        <Style x:Key="FieldLabelText" TargetType="TextBlock">
            <Setter Property="Foreground"          Value="White" />
            <Setter Property="FontWeight"          Value="SemiBold" />
            <Setter Property="FontSize"            Value="11" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment"   Value="Center" />
        </Style>

        <!-- ========= نمط ليبل سيان (للـ Lab ID وVIP) ========= -->
        <Style x:Key="CyanLabelStyle" TargetType="Border">
            <Setter Property="Background"       Value="{StaticResource CyanLabel}" />
            <Setter Property="CornerRadius"     Value="1" />
            <Setter Property="Padding"          Value="6,2" />
            <Setter Property="Margin"           Value="1" />
            <Setter Property="MinWidth"         Value="60" />
            <Setter Property="Height"           Value="24" />
        </Style>

        <!-- ========= نمط أزرار الإجراءات ========= -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="MinWidth"        Value="70" />
            <Setter Property="Height"          Value="26" />
            <Setter Property="Margin"          Value="1" />
            <Setter Property="Background"      Value="{StaticResource FreshGreen}" />
            <Setter Property="Foreground"      Value="Black" />
            <Setter Property="BorderThickness" Value="0.5" />
            <Setter Property="BorderBrush"     Value="#444" />
            <Setter Property="FontWeight"      Value="Bold" />
            <Setter Property="FontSize"        Value="11" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Background" Value="#BDC3C7" />
                                <Setter Property="Foreground" Value="#7F8C8D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========= ترويسة عينات خارج المختبر (عنوان بصري فقط) ========= -->
        <Style x:Key="OutsideLabHeaderStyle" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource BrightOrange}" />
            <Setter Property="Padding"         Value="8,4" />
            <Setter Property="Margin"          Value="0" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>

        <!-- ========= CheckBox أنواع العينات (مرجعي) ========= -->
        <Style x:Key="SampleCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="FontWeight"        Value="Bold" />
            <Setter Property="FontSize"          Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin"            Value="6,2,8,2" />
            <Setter Property="Cursor"            Value="Hand" />
            <Setter Property="FlowDirection"     Value="LeftToRight" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="CheckBoxBorder"
                                    Width="14" Height="14"
                                    Background="White"
                                    BorderBrush="#5D4037"
                                    BorderThickness="1"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckMark"
                                      Data="M 1 7 L 4 10 L 11 2"
                                      Stroke="#1B5E20"
                                      StrokeThickness="2"
                                      Visibility="Collapsed"
                                      Margin="1" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="#FFF9C4" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource HeaderOrange}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========= نمط CheckBox الزيتوني ========= -->
        <Style x:Key="OliveCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground"      Value="White" />
            <Setter Property="FontSize"        Value="10.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin"          Value="1" />
            <Setter Property="Background"      Value="{StaticResource OliveGreen}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="0" Padding="3,2">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Left" Width="13" Height="13"
                                        Background="White" BorderBrush="#333" BorderThickness="1" Margin="0,0,4,0">
                                    <Path x:Name="CheckMark"
                                          Stretch="Fill" Stroke="Black" StrokeThickness="2"
                                          Data="M 0 5 L 4 9 L 10 0" Margin="1" Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========= حقل نص أبيض ========= -->
        <Style x:Key="WhiteTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background"              Value="White" />
            <Setter Property="Foreground"              Value="Black" />
            <Setter Property="Padding"                 Value="2,1" />
            <Setter Property="BorderBrush"             Value="#7FB3D5" />
            <Setter Property="BorderThickness"         Value="1" />
            <Setter Property="MinHeight"               Value="22" />
            <Setter Property="Height"                  Value="24" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin"                  Value="1" />
        </Style>

        <Style x:Key="WhiteComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="Height"     Value="24" />
            <Setter Property="Margin"     Value="1" />
        </Style>

        <Style x:Key="WhiteRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground"        Value="White" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin"            Value="3,0,6,0" />
            <Setter Property="FontSize"          Value="11" />
        </Style>

        <Style x:Key="DarkRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground"        Value="#13314F" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin"            Value="3,0,6,0" />
            <Setter Property="FontSize"          Value="11" />
            <Setter Property="FontWeight"        Value="Bold" />
        </Style>

        <!-- ========= شريط الإجراءات الجانبي (مرجعي) ========= -->
        <SolidColorBrush x:Key="SidebarLime"       Color="#B8E986" />
        <SolidColorBrush x:Key="SidebarYellowBtn"  Color="#F1C40F" />
        <SolidColorBrush x:Key="SidebarTicketBlue" Color="#5DADE2" />
        <SolidColorBrush x:Key="SidebarMenuBlue"   Color="#2874A6" />

        <Style x:Key="SidebarActionButtonStyle" TargetType="Button">
            <Setter Property="MinHeight"       Value="36" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin"          Value="2,1" />
            <Setter Property="Padding"         Value="2,1" />
            <Setter Property="BorderBrush"     Value="#2C3E50" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground"      Value="Black" />
            <Setter Property="FontWeight"      Value="Bold" />
            <Setter Property="FontSize"        Value="11" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarIconGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily"          Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize"            Value="15" />
            <Setter Property="Width"               Value="24" />
            <Setter Property="TextAlignment"       Value="Center" />
            <Setter Property="VerticalAlignment"   Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

    </UserControl.Resources>

    <!-- ===================================================================== -->
    <!--  الشبكة الرئيسية للصفحة                                               -->
    <!-- ===================================================================== -->
    <Grid Margin="4,2,4,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================================================================= -->
        <!-- ROW 0 – شريط التاريخ والوقت العلوي                               -->
        <!-- ================================================================= -->
        <Border Grid.Row="0" Margin="2,2,2,4" Padding="4,2"
                Background="#0B243B"
                BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                CornerRadius="2">
            <DockPanel LastChildFill="False">

                <!-- Entry Date -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="6,0,2,0">
                    <Border Background="{StaticResource InfoBlue}" CornerRadius="1" Padding="6,2" Margin="1"
                            MinWidth="80">
                        <TextBlock Text="تاريخ الدخول" Foreground="White" FontWeight="Bold" FontSize="11"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBox Width="115" Text="{Binding EntryDate, StringFormat='{}{0:dd-MMM-yyyy}', UpdateSourceTrigger=PropertyChanged}" Margin="1"
                             Style="{StaticResource WhiteTextBoxStyle}" FlowDirection="LeftToRight" Language="en-US" />
                    <TextBox Width="72" Style="{StaticResource WhiteTextBoxStyle}"
                             Text="{Binding EntryTimeText, UpdateSourceTrigger=PropertyChanged}"
                             FontWeight="Bold" FlowDirection="LeftToRight" Language="en-US" />
                </StackPanel>

                <!-- Reception Date -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="10,0">
                    <Border Background="{StaticResource InfoBlue}" CornerRadius="1" Padding="6,2" Margin="1"
                            MinWidth="90">
                        <TextBlock Text="تاريخ الاستلام" Foreground="White" FontWeight="Bold" FontSize="11"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBox Width="115" Text="{Binding ReceptionDate, StringFormat='{}{0:dd-MMM-yyyy}', UpdateSourceTrigger=PropertyChanged}" Margin="1"
                             Style="{StaticResource WhiteTextBoxStyle}" FlowDirection="LeftToRight" Language="en-US" />
                    <TextBox Width="72" Style="{StaticResource WhiteTextBoxStyle}"
                             Text="{Binding ReceptionTimeText, UpdateSourceTrigger=PropertyChanged}"
                             FontWeight="Bold" FlowDirection="LeftToRight" Language="en-US" />
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ================================================================= -->
        <!-- ROW 1 – المنطقة الرئيسية (بيانات المريض يمين | قائمة التحاليل يسار) -->
        <!-- ================================================================= -->
        <Grid Grid.Row="1" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <!-- Col 0 → يمين الشاشة (RTL) = بيانات المريض -->
                <ColumnDefinition Width="1.75*" />
                <!-- Col 1 → يسار الشاشة  (RTL) = قائمة التحاليل + الملخص المالي -->
                <ColumnDefinition Width="1.25*" />
            </Grid.ColumnDefinitions>

            <!-- ============================================================= -->
            <!-- COL 1 (يسار): قائمة التحاليل + العينات + الملخص المالي       -->
            <!-- ============================================================= -->
            <Grid Grid.Column="1" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- *** لوحة قائمة التحاليل *** -->
                <Border Grid.Row="0"
                        Background="#0D47A1"
                        BorderBrush="{StaticResource PanelBorder}"
                        BorderThickness="1" CornerRadius="2"
                        Margin="2,2,2,2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <!-- شريط start / TM TG CG       -->
                            <RowDefinition Height="Auto" />
                            <!-- تصنيف + بحث + عنوان المختارة -->
                            <RowDefinition Height="*" />
                            <!-- القوائم المتوازية             -->
                            <RowDefinition Height="Auto" />
                            <!-- أزرار Add / Delete / All      -->
                            <RowDefinition Height="Auto" />
                            <!-- أزرار العينات                 -->
                        </Grid.RowDefinitions>

                        <!-- ─── شريط الرأس: start + وضع التصنيف + complete test menu ─── -->
                        <Grid Grid.Row="0" Background="{StaticResource HeaderYellow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- زر start -->
                            <Button Grid.Column="0"
                                    Content="start"
                                    Command="{Binding StartCommand}"
                                    Background="{StaticResource FreshGreen}"
                                    Foreground="White"
                                    FontWeight="Bold" FontSize="12"
                                    Height="28" MinWidth="55" Margin="4,2"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    FlowDirection="LeftToRight">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="2" Padding="6,2">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- أزرار الوضع TM / TG / CG -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <RadioButton Content="TM" GroupName="TestMode"
                                             Style="{StaticResource DarkRadioStyle}" IsChecked="True" />
                                <RadioButton Content="TG" GroupName="TestMode"
                                             Style="{StaticResource DarkRadioStyle}" />
                                <RadioButton Content="CG" GroupName="TestMode"
                                             Style="{StaticResource DarkRadioStyle}" />
                            </StackPanel>

                            <!-- رابط القائمة الكاملة -->
                            <TextBlock Grid.Column="2"
                                       Text="complete test menu"
                                       Foreground="#0B243B" FontWeight="Bold" FontSize="10.5"
                                       VerticalAlignment="Center" Margin="4,0"
                                       Cursor="Hand" FlowDirection="LeftToRight"
                                       TextDecorations="Underline" />
                        </Grid>

                        <!-- ─── تصنيف + بحث | عنوان قائمة المختارة ─── -->
                        <Grid Grid.Row="1" Margin="2,3,2,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- عنوان المختارة + العدد -->
                            <Grid Grid.Column="0" Margin="1,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="28" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource InfoBlue}"
                                        Padding="4,2">
                                    <TextBlock Text="Patient's tests" Foreground="White" FontWeight="Bold"
                                               FontSize="11" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" FlowDirection="LeftToRight" />
                                </Border>
                                <Border Grid.Column="1" Background="{StaticResource BrightOrange}">
                                    <TextBlock Text="{Binding SelectedTests.Count}"
                                               Foreground="White" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>

                            <!-- تصنيف + بحث -->
                            <DockPanel Grid.Column="1" Margin="1,0">
                                <ComboBox DockPanel.Dock="Left"
                                          SelectedItem="{Binding TestCategoryFilter, Mode=TwoWay}"
                                          Style="{StaticResource WhiteComboBoxStyle}"
                                          Width="85" FlowDirection="LeftToRight">
                                    <!-- CRITICAL FIX Phase 0: Typo "Rotine" → "Routine" to match ViewModel default value (C-05) -->
                                    <ComboBoxItem Content="Routine Tests" IsSelected="True" />
                                    <ComboBoxItem Content="Send Out" />
                                    <ComboBoxItem Content="All" />
                                </ComboBox>
                                <TextBox Style="{StaticResource WhiteTextBoxStyle}"
                                         Text="{Binding TestSearchText, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </Grid>

                        <!-- ─── القوائم المتوازية ─── -->
                        <Grid Grid.Row="2" Margin="2,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- قائمة المختارة (يمين في RTL = Column 0) -->
                            <DataGrid Grid.Column="0" Margin="1"
                                      Background="White"
                                      ItemsSource="{Binding SelectedTests}"
                                      SelectedItem="{Binding SelectedTest}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False" IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      FlowDirection="LeftToRight"
                                      RowBackground="White"
                                      AlternatingRowBackground="#EFF7FF"
                                      GridLinesVisibility="Horizontal">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background"  Value="{StaticResource InfoBlue}" />
                                        <Setter Property="Foreground"  Value="White" />
                                        <Setter Property="FontWeight"  Value="Bold" />
                                        <Setter Property="FontSize"    Value="11" />
                                        <Setter Property="Padding"     Value="4,3" />
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Selected" Binding="{Binding TestName}" Width="*" />
                                    <DataGridTextColumn Header="D"        Binding="{Binding Price}"    Width="36" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- قائمة المتاحة (يسار في RTL = Column 1) -->
                            <DataGrid Grid.Column="1" x:Name="AvailableTestsList" Margin="1"
                                      Background="#FFEBEE"
                                      ItemsSource="{Binding AvailableTests}"
                                      SelectedItem="{Binding SelectedAvailableTest}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False" IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      RowHeaderWidth="0"
                                      MouseDoubleClick="AvailableTestsList_MouseDoubleClick"
                                      FlowDirection="LeftToRight"
                                      RowBackground="#FFEBEE"
                                      AlternatingRowBackground="#FFCDD2"
                                      GridLinesVisibility="Horizontal">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="{StaticResource TestListBg}" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="FontSize"   Value="11" />
                                        <Setter Property="Padding"    Value="4,3" />
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Test Name" Binding="{Binding NameReport}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <!-- ─── أزرار Add / Delete / All ─── -->
                        <UniformGrid Grid.Row="3" Columns="3" Margin="2,2,2,1">
                            <Button Content="Add select test"
                                    Command="{Binding AddTestCommand}"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Background="{StaticResource LimeGreen}" />
                            <Button Content="Delete"
                                    Command="{Binding RemoveTestCommand}"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Background="{StaticResource OliveGreen}" />
                            <Button Content="All"
                                    Command="{Binding AddAllTestsCommand}"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Background="{StaticResource OliveGreen}" />
                        </UniformGrid>

                        <!-- ─── عينات خارج المختبر: ترويسة + CheckBoxes ─── -->
                        <Border Grid.Row="4" Margin="2,2,2,3"
                                BorderBrush="#7CB342"
                                BorderThickness="1"
                                CornerRadius="1"
                                Background="#0D47A1"
                                Padding="1">
                            <Grid FlowDirection="LeftToRight">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource OutsideLabHeaderStyle}">
                                    <TextBlock Text="Taken outside lab"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               FontSize="11"
                                               VerticalAlignment="Center" />
                                </Border>

                                <Border Grid.Column="1"
                                        Background="#FFF8E1"
                                        BorderBrush="#C5E1A5"
                                        BorderThickness="1,0,0,0"
                                        Padding="4,2">
                                    <WrapPanel VerticalAlignment="Center">
                                        <CheckBox Content="Urine"
                                                  Style="{StaticResource SampleCheckBoxStyle}"
                                                  Foreground="#5D4037"
                                                  IsChecked="{Binding HasUrineSample}" />
                                        <CheckBox Content="Stool"
                                                  Style="{StaticResource SampleCheckBoxStyle}"
                                                  Foreground="#5D4037"
                                                  IsChecked="{Binding HasStoolSample}" />
                                        <CheckBox Content="Blood"
                                                  Style="{StaticResource SampleCheckBoxStyle}"
                                                  Foreground="#5D4037"
                                                  IsChecked="{Binding HasBloodSample}" />
                                        <CheckBox Content="Semen"
                                                  Style="{StaticResource SampleCheckBoxStyle}"
                                                  Foreground="#4A148C"
                                                  IsChecked="{Binding HasSemenSample}" />
                                        <CheckBox Content="CSF"
                                                  Style="{StaticResource SampleCheckBoxStyle}"
                                                  Foreground="#1B5E20"
                                                  IsChecked="{Binding HasCsfSample}" />
                                    </WrapPanel>
                                </Border>
                            </Grid>
                        </Border>

                    </Grid>
                </Border>

                <!-- *** الملخص المالي *** -->
                <Border Grid.Row="1"
                        Background="{StaticResource YellowPanel}"
                        BorderBrush="{StaticResource PanelBorder}"
                        BorderThickness="1" CornerRadius="2"
                        Margin="2,2,2,0" Padding="3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- ====== العمود الأيمن (RTL): إجمالي / خصم / ... — عنوان يمين، حقل يسار ====== -->

                        <!-- إجمالي التحاليل -->
                        <Grid Grid.Row="0" Grid.Column="0" Margin="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource DangerRed}" Padding="4,2">
                                <TextBlock Text="إجمالي التحاليل" Foreground="White" FontWeight="Bold" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBox Grid.Column="1"
                                     Text="{Binding TotalAmount, StringFormat=N0, Mode=OneWay}"
                                     Style="{StaticResource WhiteTextBoxStyle}" IsReadOnly="True"
                                     FontWeight="Bold" HorizontalContentAlignment="Center" />
                        </Grid>

                        <!-- الخصم -->
                        <Grid Grid.Row="1" Grid.Column="0" Margin="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource InfoBlue}" Padding="4,2">
                                <TextBlock Text="الخصم" Foreground="White" FontWeight="Bold" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" Style="{StaticResource WhiteComboBoxStyle}" FontSize="10">
                                    <ComboBoxItem Content="%" IsSelected="True" />
                                </ComboBox>
                                <TextBox Grid.Column="1"
                                         Text="{Binding DiscountPercent, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource WhiteTextBoxStyle}" FontWeight="Bold"
                                         HorizontalContentAlignment="Center" />
                            </Grid>
                        </Grid>

                        <!-- قيمة الخصم -->
                        <Grid Grid.Row="2" Grid.Column="0" Margin="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource InfoBlue}" Padding="4,2">
                                <TextBlock Text="قيمة الخصم" Foreground="White" FontWeight="Bold" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBox Grid.Column="1"
                                     Text="{Binding DiscountAmount, StringFormat=N0, Mode=OneWay}"
                                     Style="{StaticResource WhiteTextBoxStyle}" IsReadOnly="True"
                                     FontWeight="Bold" HorizontalContentAlignment="Center" />
                        </Grid>

                        <!-- التكلفة بعد الخصم -->
                        <Grid Grid.Row="3" Grid.Column="0" Margin="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource InfoBlue}" Padding="4,2">
                                <TextBlock Text="التكلفة بعد الخصم" Foreground="White" FontWeight="Bold" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBox Grid.Column="1"
                                     Text="{Binding NetTotal, StringFormat=N0, Mode=OneWay}"
                                     Style="{StaticResource WhiteTextBoxStyle}" IsReadOnly="True"
                                     FontWeight="Bold" HorizontalContentAlignment="Center" />
                        </Grid>

                        <!-- المدفوع سابقا -->
                        <Grid Grid.Row="4" Grid.Column="0" Margin="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource InfoBlue}" Padding="4,2">
                                <TextBlock Text="المدفوع سابقا" Foreground="White" FontWeight="Bold" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBox Grid.Column="1"
                                     Text="{Binding PreviousPaidAmount, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource WhiteTextBoxStyle}" FontWeight="Bold"
                                     HorizontalContentAlignment="Center" />
                        </Grid>

                        <!-- ====== العمود الأيسر (RTL): باقي / مدفوع / أزرار — عنوان يمين، حقل يسار ====== -->

                        <!-- الباقي للمعمل -->
                        <Grid Grid.Row="0" Grid.Column="1" Margin="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="95" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource BrightOrange}" Padding="4,2">
                                <TextBlock Text="الباقي للمعمل" Foreground="White" FontWeight="Bold" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBox Grid.Column="1"
                                     Text="{Binding BalanceForLab, StringFormat=N1, Mode=OneWay}"
                                     Style="{StaticResource WhiteTextBoxStyle}" IsReadOnly="True"
                                     FontWeight="Bold" HorizontalContentAlignment="Center"
                                     Background="#C8E6C9" />
                        </Grid>

                        <!-- الباقي للمريض -->
                        <Grid Grid.Row="1" Grid.Column="1" Margin="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="95" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource BrightOrange}" Padding="4,2">
                                <TextBlock Text="الباقي للمريض" Foreground="White" FontWeight="Bold" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBox Grid.Column="1"
                                     Text="{Binding BalanceForPatient, StringFormat=N1, Mode=OneWay}"
                                     Style="{StaticResource WhiteTextBoxStyle}" IsReadOnly="True"
                                     FontWeight="Bold" HorizontalContentAlignment="Center"
                                     Background="#C8E6C9" />
                        </Grid>

                        <!-- المدفوع -->
                        <Grid Grid.Row="2" Grid.Column="1" Margin="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="95" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource DangerRed}" Padding="4,2">
                                <TextBlock Text="المدفوع" Foreground="White" FontWeight="Bold" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBox Grid.Column="1"
                                     Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource WhiteTextBoxStyle}" FontWeight="Bold"
                                     HorizontalContentAlignment="Center" />
                        </Grid>

                        <!-- أزرار: خالص / تراجع / موافق -->
                        <UniformGrid Grid.Row="3" Grid.Column="1" Columns="3" Margin="1,4,1,1">
                            <Button Content="خالص" Command="{Binding SettleCommand}"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Background="{StaticResource LimeGreen}" Height="24" FontSize="10" />
                            <Button Content="تراجع" Command="{Binding UndoCommand}"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Background="{StaticResource LimeGreen}" Height="24" FontSize="10" />
                            <Button Content="موافق" Command="{Binding SaveCommand}"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Background="{StaticResource LimeGreen}" Height="24" FontSize="10" />
                        </UniformGrid>

                    </Grid>
                </Border>

            </Grid>

            <!-- ============================================================= -->
            <!-- COL 0 (يمين): بيانات المريض + أزرار الإجراءات (أسفل يمين)     -->
            <!-- ============================================================= -->
            <Grid Grid.Column="0" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- ========= مجموعة بيانات المريض ========= -->
                    <Grid Margin="4,8,4,2">
                        <Border Style="{StaticResource GroupBoxStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- ROW 0: كود المريض + VIP + Lab. ID -->
                                <Border Grid.Row="0" Grid.Column="0"
                                        Background="{StaticResource BrightOrange}"
                                        CornerRadius="1" Padding="6,2" Margin="1" MinWidth="80" Height="24">
                                    <TextBlock Text="كود المريض" Foreground="White" FontWeight="Bold"
                                               FontSize="11" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBox Grid.Row="0" Grid.Column="1"
                                         Style="{StaticResource WhiteTextBoxStyle}"
                                         Text="{Binding PatientCode, UpdateSourceTrigger=PropertyChanged}" />

                                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Style="{StaticResource CyanLabelStyle}" MinWidth="40" Margin="3,1,1,1">
                                        <TextBlock Text="VIP" Foreground="White" FontWeight="Bold"
                                                   FontSize="11" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" FlowDirection="LeftToRight" />
                                    </Border>
                                    <CheckBox IsChecked="{Binding IsVip}"
                                              VerticalAlignment="Center" Margin="2,0" />
                                </StackPanel>

                                <Border Grid.Row="0" Grid.Column="3"
                                        Style="{StaticResource CyanLabelStyle}">
                                    <TextBlock Text="Lab. ID" Foreground="White" FontWeight="Bold"
                                               FontSize="11" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" FlowDirection="LeftToRight" />
                                </Border>
                                <TextBox Grid.Row="0" Grid.Column="4"
                                         Style="{StaticResource WhiteTextBoxStyle}"
                                         Text="{Binding LabId, UpdateSourceTrigger=PropertyChanged}"
                                         FontWeight="Bold" />

                                <!-- ROW 1: اسم المريض + Sex -->
                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabelStyle}">
                                    <TextBlock Text="اسم المريض" Style="{StaticResource FieldLabelText}" />
                                </Border>
                                <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="75" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" Style="{StaticResource WhiteComboBoxStyle}"
                                              SelectedItem="{Binding Title, Mode=TwoWay}" IsEditable="True">
                                        <ComboBoxItem Content="السيد/" />
                                        <ComboBoxItem Content="السيدة/" />
                                        <ComboBoxItem Content="الآنسة/" />
                                        <ComboBoxItem Content="الطفل/" />
                                    </ComboBox>
                                    <TextBox Grid.Column="1" Style="{StaticResource WhiteTextBoxStyle}"
                                             Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" />
                                    <Border Grid.Column="2" Style="{StaticResource FieldLabelStyle}">
                                        <TextBlock Text="Sex" Style="{StaticResource FieldLabelText}"
                                                   FlowDirection="LeftToRight" />
                                    </Border>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <RadioButton Content="Male"    Style="{StaticResource WhiteRadioStyle}"
                                                     IsChecked="{Binding Gender, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Male}" />
                                        <RadioButton Content="Female"  Style="{StaticResource WhiteRadioStyle}"
                                                     IsChecked="{Binding Gender, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Female}" />
                                        <RadioButton Content="Unknown" Style="{StaticResource WhiteRadioStyle}"
                                                     IsChecked="{Binding Gender, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Unknown}" />
                                    </StackPanel>
                                </Grid>

                                <!-- ROW 3: موبايل/تليفون + السن -->
                                <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabelStyle}">
                                    <TextBlock Text="موبايل/تليفون" Style="{StaticResource FieldLabelText}" />
                                </Border>
                                <Grid Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="75" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource WhiteTextBoxStyle}"
                                             Text="{Binding HomePhone, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="1" Style="{StaticResource WhiteTextBoxStyle}"
                                             Text="{Binding MobilePhone, UpdateSourceTrigger=PropertyChanged}" />
                                    <Border Grid.Column="2" Style="{StaticResource FieldLabelStyle}">
                                        <TextBlock Text="السن" Style="{StaticResource FieldLabelText}" />
                                    </Border>
                                    <TextBox Grid.Column="3" Style="{StaticResource WhiteTextBoxStyle}"
                                             Text="{Binding Age, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                    <ComboBox Grid.Column="4" Style="{StaticResource WhiteComboBoxStyle}"
                                              SelectedItem="{Binding AgeUnit, Mode=TwoWay}" IsEditable="True">
                                        <ComboBoxItem Content="Years" />
                                        <ComboBoxItem Content="Months" />
                                        <ComboBoxItem Content="Days" />
                                    </ComboBox>
                                </Grid>

                                <!-- ROW 4: رقم البطاقة + نوع الحساب -->
                                <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabelStyle}">
                                    <TextBlock Text="رقم البطاقة" Style="{StaticResource FieldLabelText}" />
                                </Border>
                                <Grid Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource WhiteTextBoxStyle}"
                                             Text="{Binding NationalId, UpdateSourceTrigger=PropertyChanged}" />
                                    <Border Grid.Column="1" Style="{StaticResource FieldLabelStyle}">
                                        <TextBlock Text="نوع الحساب" Style="{StaticResource FieldLabelText}" />
                                    </Border>
                                    <ComboBox Grid.Column="2"
                                              Style="{StaticResource WhiteComboBoxStyle}"
                                              SelectedItem="{Binding AccountType, Mode=TwoWay}"
                                              IsEditable="True">
                                        <ComboBoxItem Content="Individual" />
                                        <ComboBoxItem Content="Lab to Lab" />
                                    </ComboBox>
                                </Grid>

                                <!-- ROW 5: عنوان المريض + البريد الإلكتروني -->
                                <Border Grid.Row="5" Grid.Column="0" Style="{StaticResource FieldLabelStyle}">
                                    <TextBlock Text="عنوان المريض" Style="{StaticResource FieldLabelText}" />
                                </Border>
                                <Grid Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource WhiteTextBoxStyle}"
                                             Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
                                    <Border Grid.Column="1" Style="{StaticResource FieldLabelStyle}">
                                        <TextBlock Text="البريد الإلكتروني" Style="{StaticResource FieldLabelText}" />
                                    </Border>
                                    <TextBox Grid.Column="2" Style="{StaticResource WhiteTextBoxStyle}"
                                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ========= مجموعة بيانات الطبيب أو الجهة ========= -->
                    <Grid Margin="4,10,4,2">
                        <Border Style="{StaticResource GroupBoxStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- ROW 0: جهة الإحالة + عنوان الطبيب + Print -->
                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabelStyle}">
                                    <TextBlock Text="جهة الإحالة" Style="{StaticResource FieldLabelText}" />
                                </Border>
                                <ComboBox Grid.Row="0" Grid.Column="1"
                                          Style="{StaticResource WhiteComboBoxStyle}"
                                          ItemsSource="{Binding Referrals}"
                                          SelectedItem="{Binding SelectedReferral}"
                                          DisplayMemberPath="Name" />

                                <Grid Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="55" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" Style="{StaticResource WhiteComboBoxStyle}"
                                              SelectedItem="{Binding DoctorTitle, Mode=TwoWay}"
                                              IsEditable="True">
                                        <ComboBoxItem Content="د./" />
                                        <ComboBoxItem Content="أ.د./" />
                                        <ComboBoxItem Content="م.د./" />
                                    </ComboBox>
                                    <TextBox Grid.Column="1" Style="{StaticResource WhiteTextBoxStyle}"
                                             Text="{Binding ReferralTitleNote, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Grid.Column="2" Content="Print"
                                              Foreground="White" VerticalAlignment="Center"
                                              Margin="4,0" FontSize="11"
                                              IsChecked="{Binding PrintReferralOnReport}"
                                              FlowDirection="LeftToRight" />
                                </Grid>

                                <!-- ROW 1: تليفون + عنوان الجهة -->
                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabelStyle}">
                                    <TextBlock Text="تليفون" Style="{StaticResource FieldLabelText}" />
                                </Border>
                                <TextBox Grid.Row="1" Grid.Column="1"
                                         Style="{StaticResource WhiteTextBoxStyle}"
                                         Text="{Binding ReferralPhone, UpdateSourceTrigger=PropertyChanged}" />
                                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource FieldLabelStyle}">
                                    <TextBlock Text="عنوان الجهة" Style="{StaticResource FieldLabelText}" />
                                </Border>
                                <TextBox Grid.Row="1" Grid.Column="3"
                                         Style="{StaticResource WhiteTextBoxStyle}"
                                         Text="{Binding ReferralAddress, UpdateSourceTrigger=PropertyChanged}" />

                                <!-- ROW 2: تليفون ثاني + اسم المسؤول -->
                                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabelStyle}">
                                    <TextBlock Text="تليفون" Style="{StaticResource FieldLabelText}" />
                                </Border>
                                <TextBox Grid.Row="2" Grid.Column="1"
                                         Style="{StaticResource WhiteTextBoxStyle}"
                                         Text="{Binding ReferralAltPhone, UpdateSourceTrigger=PropertyChanged}" />
                                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource FieldLabelStyle}">
                                    <TextBlock Text="اسم المسؤول" Style="{StaticResource FieldLabelText}" />
                                </Border>
                                <Grid Grid.Row="2" Grid.Column="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="50" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource WhiteTextBoxStyle}"
                                             Text="{Binding ReferralResponsible, UpdateSourceTrigger=PropertyChanged}" />
                                    <ComboBox Grid.Column="1" Style="{StaticResource WhiteComboBoxStyle}"
                                              SelectedItem="{Binding ReferralTitle, Mode=TwoWay}"
                                              IsEditable="True">
                                        <ComboBoxItem Content="د./" />
                                        <ComboBoxItem Content="أ.د./" />
                                        <ComboBoxItem Content="م.د./" />
                                    </ComboBox>
                                </Grid>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource GroupHeaderStyle}" VerticalAlignment="Top">
                            <TextBlock Text="بيانات الطبيب أو الجهة" Style="{StaticResource GroupHeaderText}" />
                        </Border>
                    </Grid>

                    <!-- ========= مجموعة معلومات إضافية ========= -->
                    <Grid Margin="4,10,4,2">
                        <Border Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>

                                <!-- صف: صائم + ساعات الصيام + هل سبق التحليل -->
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" Content="صائم"
                                              Style="{StaticResource OliveCheckBoxStyle}"
                                              IsChecked="{Binding IsFasting}" />

                                    <Border Grid.Column="1" Style="{StaticResource FieldLabelStyle}" MinWidth="115">
                                        <TextBlock Text="عدد ساعات الصيام" Style="{StaticResource FieldLabelText}" />
                                    </Border>
                                    <TextBox Grid.Column="2" Style="{StaticResource WhiteTextBoxStyle}"
                                             Text="{Binding FastingHours, UpdateSourceTrigger=PropertyChanged}" />

                                    <CheckBox Grid.Column="4" Content="هل سبق لك التحليل بمعملنا"
                                              Style="{StaticResource OliveCheckBoxStyle}"
                                              IsChecked="{Binding HadPreviousAnalysisHere}" />
                                </Grid>

                                <!-- شبكة CheckBox الطبية (3 أعمدة) -->
                                <UniformGrid Columns="3" Margin="0,1">
                                    <CheckBox Content="هل يأخذ علاج لسيولة الدم"   Style="{StaticResource OliveCheckBoxStyle}" IsChecked="{Binding TakesBloodThinners}" />
                                    <CheckBox Content="هل يأخذ علاج مضاد حيوي"     Style="{StaticResource OliveCheckBoxStyle}" IsChecked="{Binding TakesAntibiotics}" />
                                    <CheckBox Content="هل يأخذ علاج للسكر"          Style="{StaticResource OliveCheckBoxStyle}" IsChecked="{Binding TakesDiabetesTreatment}" />

                                    <CheckBox Content="هل يأخذ علاج للفيروسات"      Style="{StaticResource OliveCheckBoxStyle}" IsChecked="{Binding TakesAntiVirals}" />
                                    <CheckBox Content="هل سبق نقل دم"               Style="{StaticResource OliveCheckBoxStyle}" IsChecked="{Binding HadBloodTransfusion}" />
                                    <CheckBox Content="هل يأخذ علاج للغدد"          Style="{StaticResource OliveCheckBoxStyle}" IsChecked="{Binding TakesGlandsTreatment}" />

                                    <CheckBox Content="للسيدات هل يوجد حمل"         Style="{StaticResource OliveCheckBoxStyle}" IsChecked="{Binding IsPregnant}" />
                                    <CheckBox Content="هل المريض مدخن"              Style="{StaticResource OliveCheckBoxStyle}" IsChecked="{Binding IsSmoker}" />
                                    <CheckBox Content="هل يأخذ علاج للكبد"          Style="{StaticResource OliveCheckBoxStyle}" IsChecked="{Binding TakesLiverTreatment}" />

                                    <CheckBox Content="هل تم عمل اشعة بالصبغة"      Style="{StaticResource OliveCheckBoxStyle}" IsChecked="{Binding HadContrastImaging}" />
                                </UniformGrid>

                                <!-- حقل الملاحظات -->
                                <Grid Margin="0,4,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Style="{StaticResource WhiteTextBoxStyle}"
                                             MinHeight="38" AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             Text="{Binding MedicalNotes, UpdateSourceTrigger=PropertyChanged}" />
                                    <Border Grid.Column="1" Background="{StaticResource BrightOrange}"
                                            CornerRadius="1" Padding="10,2" Margin="2,1,1,1"
                                            VerticalAlignment="Stretch">
                                        <TextBlock Text="ملاحظات" Foreground="White" FontWeight="Bold"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </Grid>

                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource GroupHeaderStyle}" VerticalAlignment="Top">
                            <TextBlock Text="معلومات اضافية" Style="{StaticResource GroupHeaderText}" />
                        </Border>
                    </Grid>

                </StackPanel>
                </ScrollViewer>

                <!-- أزرار الإجراءات — أسفل يمين (4 + 4 + 3) مطابق للمرجع -->
                <Border Grid.Row="1" Margin="4,4,4,0" Padding="2"
                        Background="#0B243B"
                        BorderBrush="{StaticResource PanelBorder}"
                        BorderThickness="1"
                        CornerRadius="2">
                    <StackPanel>

                        <UniformGrid Rows="1" Columns="4" Margin="0,0,0,2">
                            <Button Command="{Binding NewCommand}"
                                    Style="{StaticResource SidebarActionButtonStyle}"
                                    Background="{StaticResource SidebarLime}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="إضافة" VerticalAlignment="Center"
                                               HorizontalAlignment="Right" Margin="4,0,2,0" />
