<UserControl x:Class="Open_lab.Views.Patients.PatientRegistrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="#13314F">
    <UserControl.Resources>

        <!-- ========= ألوان الواجهة الموحدة المستوحاة من الصورة ========= -->
        <SolidColorBrush x:Key="NavyBackground" Color="#13314F" />
        <SolidColorBrush x:Key="PanelBorder"    Color="#1F4F86" />
        <SolidColorBrush x:Key="HeaderOrange"   Color="#D35400" />
        <SolidColorBrush x:Key="BrightOrange"   Color="#E67E22" />
        <SolidColorBrush x:Key="HeaderYellow"   Color="#F1C40F" />
        <SolidColorBrush x:Key="OliveGreen"     Color="#808000" />
        <SolidColorBrush x:Key="FreshGreen"     Color="#27AE60" />
        <SolidColorBrush x:Key="LimeGreen"      Color="#8DB600" />
        <SolidColorBrush x:Key="DangerRed"      Color="#C0392B" />
        <SolidColorBrush x:Key="InfoBlue"       Color="#2980B9" />
        <SolidColorBrush x:Key="LabelBlue"      Color="#3498DB" />
        <SolidColorBrush x:Key="YellowPanel"    Color="#F1C40F" />
        <SolidColorBrush x:Key="DarkBlueHeader" Color="#0B243B" />

        <!-- ========= نمط ترويسة المجموعة (أزرق غامق مع نص أصفر) ========= -->
        <Style x:Key="GroupHeaderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource DarkBlueHeader}" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,10,-12" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="GroupHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource HeaderYellow}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- ========= نمط الإطار الأزرق الرئيسي ========= -->
        <Style x:Key="GroupBoxStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="8,14,8,6" />
            <Setter Property="Margin" Value="4,6,4,2" />
        </Style>

        <!-- ========= نمط ليبل أزرق للحقول ========= -->
        <Style x:Key="FieldLabelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource LabelBlue}" />
            <Setter Property="CornerRadius" Value="1" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="MinWidth" Value="85" />
            <Setter Property="Height" Value="26" />
        </Style>
        <Style x:Key="FieldLabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ========= نمط أزرار الإجراءات ========= -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Background" Value="{StaticResource FreshGreen}" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="BorderThickness" Value="0.5" />
            <Setter Property="BorderBrush" Value="#444" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Background" Value="#BDC3C7" />
                                <Setter Property="Foreground" Value="#7F8C8D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========= نمط أزرار العينات ========= -->
        <Style x:Key="SampleButtonStyle" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="70" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource HeaderOrange}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource HeaderOrange}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource HeaderYellow}" />
                                <Setter Property="Foreground" Value="Black" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========= نمط الـ CheckBox المستطيل الملون ========= -->
        <Style x:Key="OliveCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Background" Value="{StaticResource OliveGreen}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="0"
                                Padding="3,2">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Left"
                                        Width="14" Height="14"
                                        Background="White"
                                        BorderBrush="#333"
                                        BorderThickness="1"
                                        Margin="0,0,4,0">
                                    <Path x:Name="CheckMark"
                                          Stretch="Fill"
                                          Stroke="Black"
                                          StrokeThickness="2"
                                          Data="M 0 5 L 4 9 L 10 0"
                                          Margin="1"
                                          Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========= حقول النص ========= -->
        <Style x:Key="WhiteTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="Padding" Value="2,1" />
            <Setter Property="BorderBrush" Value="#7FB3D5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="1" />
        </Style>

        <Style x:Key="WhiteComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="1" />
        </Style>

        <Style x:Key="WhiteRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,0,8,0" />
            <Setter Property="FontSize" Value="11" />
        </Style>

    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- شريط التاريخ والوقت العلوي -->
            <RowDefinition Height="*" />
            <!-- المحتوى الرئيسي -->
            <RowDefinition Height="Auto" />
            <!-- شريط أزرار التحكم السفلي -->
            <RowDefinition Height="Auto" />
            <!-- شريط القائمة الرئيسية -->
            <RowDefinition Height="Auto" />
            <!-- رسالة الحالة -->
        </Grid.RowDefinitions>

        <!-- ============================================================ -->
        <!-- 1) الشريط العلوي: التاريخ والوقت (الاستلام + الدخول)         -->
        <!-- ============================================================ -->
        <Border Grid.Row="0" Margin="4,2" Padding="2" Background="#13314F" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <!-- تاريخ الدخول (يمين) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="4,0">
                    <Border Style="{StaticResource FieldLabelStyle}" Background="{StaticResource InfoBlue}" MinWidth="90">
                        <TextBlock Text="تاريخ الدخول" Style="{StaticResource FieldLabelText}" />
                    </Border>
                    <DatePicker Width="115" SelectedDate="{Binding EntryDate}" Margin="1" />
                    <TextBox Width="75"
                             Style="{StaticResource WhiteTextBoxStyle}"
                             Text="{Binding EntryTimeText, UpdateSourceTrigger=PropertyChanged}"
                             FontWeight="Bold" />
                </StackPanel>

                <!-- تاريخ الاستلام (يسار الدخول) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0">
                    <Border Style="{StaticResource FieldLabelStyle}" Background="{StaticResource InfoBlue}" MinWidth="100">
                        <TextBlock Text="تاريخ الاستلام" Style="{StaticResource FieldLabelText}" />
                    </Border>
                    <DatePicker Width="115" SelectedDate="{Binding ReceptionDate}" Margin="1" />
                    <TextBox Width="75"
                             Style="{StaticResource WhiteTextBoxStyle}"
                             Text="{Binding ReceptionTimeText, UpdateSourceTrigger=PropertyChanged}"
                             FontWeight="Bold" />
                </StackPanel>

                <!-- وقت النظام (اختياري - يظهر كـ 09:00 PM في الصورة) -->
                <Border DockPanel.Dock="Left" Background="White" Padding="6,2" Margin="4,0" CornerRadius="1">
                    <TextBlock Text="{Binding SystemTimeText, FallbackValue='09:00 PM'}" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center"/>
                </Border>
            </DockPanel>
        </Border>

        <!-- ============================================================ -->
        <!-- 2) المنطقة الرئيسية: قائمة التحاليل (يسار) + البيانات (يمين) -->
        <!-- ============================================================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.85*" />
                <!-- لوحة بيانات المريض الكاملة (على اليمين) -->
                <ColumnDefinition Width="1.05*" />
                <!-- لوحة قائمة التحاليل + الملخص المالي (على الشمال) -->
            </Grid.ColumnDefinitions>

            <!-- ============== العمود الأيسر: قائمة التحاليل + ملخص مالي ============== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- *********** لوحة Routine test menu *********** -->
                <Border Grid.Row="0"
                        Background="#0D47A1"
                        BorderBrush="{StaticResource PanelBorder}"
                        BorderThickness="1"
                        CornerRadius="2"
                        Margin="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*"    />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- العنوان: أصفر مع نص أزرق غامق -->
                        <Border Grid.Row="0" Background="{StaticResource HeaderYellow}" Padding="8,4">
                            <TextBlock Text="Routine test menu"
                                       Foreground="#13314F"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       FlowDirection="LeftToRight" />
                        </Border>

                        <!-- الصف الثاني: التصنيف + البحث + عنوان القائمة المختارة -->
                        <Grid Grid.Row="1" Margin="2,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            
                            <!-- فوق القائمة المختارة (الجهة اليمنى) -->
                            <Grid Grid.Column="0" Margin="2,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource InfoBlue}" Padding="6,2" Margin="0,0,2,0">
                                    <TextBlock Text="Selected Test" Foreground="White" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                                </Border>
                                <Border Grid.Column="1" Background="{StaticResource BrightOrange}" MinWidth="30">
                                    <TextBlock Text="{Binding SelectedTests.Count}"
                                               Foreground="White" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <!-- فوق القائمة المتاحة (الجهة اليسرى) -->
                            <DockPanel Grid.Column="1" Margin="2,0">
                                <ComboBox DockPanel.Dock="Left" SelectedIndex="0" Style="{StaticResource WhiteComboBoxStyle}" Width="100" FlowDirection="LeftToRight">
                                    <ComboBoxItem Content="Rotine Tests" />
                                    <ComboBoxItem Content="Send Out" />
                                    <ComboBoxItem Content="All" />
                                </ComboBox>
                                <TextBox Style="{StaticResource WhiteTextBoxStyle}"
                                         Text="{Binding TestSearchText, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </Grid>

                        <!-- القوائم المتوازية (المتاحة والمختارة) -->
                        <Grid Grid.Row="2" Margin="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- قائمة التحاليل المختارة (يمين) -->
                            <DataGrid Grid.Column="0"
                                      Margin="1"
                                      Background="White"
                                      ItemsSource="{Binding SelectedTests}"
                                      SelectedItem="{Binding SelectedTest}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      FlowDirection="LeftToRight">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Selected" Binding="{Binding TestName}" Width="*" />
                                    <DataGridTextColumn Header="Price"    Binding="{Binding Price}"    Width="50" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- قائمة التحاليل المتاحة (يسار) -->
                            <DataGrid Grid.Column="1"
                                      Margin="1"
                                      Background="#E8F1F8"
                                      ItemsSource="{Binding AvailableTests}"
                                      SelectedItem="{Binding SelectedAvailableTest}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      RowHeaderWidth="15"
                                      FlowDirection="LeftToRight">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Test Name" Binding="{Binding NameReport}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <!-- أزرار التحكم -->
                        <UniformGrid Grid.Row="3" Columns="3" Margin="2">
                            <Button Content="All" Command="{Binding AddAllTestsCommand}" Style="{StaticResource ActionButtonStyle}" Background="{StaticResource OliveGreen}" />
                            <Button Content="Delete" Command="{Binding RemoveTestCommand}" Style="{StaticResource ActionButtonStyle}" Background="{StaticResource OliveGreen}" />
                            <Button Content="Add select test" Command="{Binding AddTestCommand}" Style="{StaticResource ActionButtonStyle}" Background="{StaticResource LimeGreen}" />
                        </UniformGrid>
                    </Grid>
                </Border>

                <!-- *********** الملخص المالي السفلي (أصفر) *********** -->
                <Border Grid.Row="1"
                        Background="{StaticResource YellowPanel}"
                        BorderBrush="{StaticResource PanelBorder}"
                        BorderThickness="1"
                        CornerRadius="2"
                        Margin="4"
                        Padding="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- اليمين: القيم المالية (Column 0) -->
                        <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource InfoBlue}" Padding="4,2" Margin="1">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="إجمالي التحاليل" Foreground="White" FontWeight="Bold" FontSize="11"
                                           DockPanel.Dock="Right" Margin="4,0" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding TotalAmount, StringFormat=N0, Mode=OneWay}" Width="50"
                                         Style="{StaticResource WhiteTextBoxStyle}" IsReadOnly="True" FontWeight="Bold"
                                         HorizontalContentAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource InfoBlue}" Padding="4,2" Margin="1">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="الخصم" Foreground="White" FontWeight="Bold" FontSize="11"
                                           DockPanel.Dock="Right" Margin="4,0" VerticalAlignment="Center"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding DiscountPercent, UpdateSourceTrigger=PropertyChanged}" Width="35"
                                             Style="{StaticResource WhiteTextBoxStyle}" FontWeight="Bold"
                                             HorizontalContentAlignment="Center"/>
                                    <ComboBox Grid.Column="1" Width="40" Style="{StaticResource WhiteComboBoxStyle}" FontSize="10">
                                        <ComboBoxItem Content="%" IsSelected="True"/>
                                    </ComboBox>
                                </Grid>
                            </DockPanel>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="0" Background="{StaticResource InfoBlue}" Padding="4,2" Margin="1">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="قيمة الخصم" Foreground="White" FontWeight="Bold" FontSize="11"
                                           DockPanel.Dock="Right" Margin="4,0" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding DiscountAmount, StringFormat=N0, Mode=OneWay}" Width="50"
                                         Style="{StaticResource WhiteTextBoxStyle}" IsReadOnly="True" FontWeight="Bold"
                                         HorizontalContentAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <Border Grid.Row="3" Grid.Column="0" Background="{StaticResource InfoBlue}" Padding="4,2" Margin="1">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="التكلفة بعد الخصم" Foreground="White" FontWeight="Bold" FontSize="11"
                                           DockPanel.Dock="Right" Margin="4,0" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding NetTotal, StringFormat=N0, Mode=OneWay}" Width="50"
                                         Style="{StaticResource WhiteTextBoxStyle}" IsReadOnly="True" FontWeight="Bold"
                                         HorizontalContentAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <Border Grid.Row="4" Grid.Column="0" Background="{StaticResource InfoBlue}" Padding="4,2" Margin="1">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="المدفوع سابقا" Foreground="White" FontWeight="Bold" FontSize="11"
                                           DockPanel.Dock="Right" Margin="4,0" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding PreviousPaidAmount, UpdateSourceTrigger=PropertyChanged}" Width="50"
                                         Style="{StaticResource WhiteTextBoxStyle}" FontWeight="Bold"
                                         HorizontalContentAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <!-- اليسار: البواقي والمدفوع (Column 1) -->
                        <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource BrightOrange}" Padding="4,2" Margin="1">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="الباقي للمعمل" Foreground="White" FontWeight="Bold" FontSize="11"
                                           DockPanel.Dock="Right" Margin="4,0" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding BalanceForLab, StringFormat=N1, Mode=OneWay}" Width="50"
                                         Style="{StaticResource WhiteTextBoxStyle}" IsReadOnly="True" FontWeight="Bold"
                                         HorizontalContentAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource BrightOrange}" Padding="4,2" Margin="1">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="الباقي للمريض" Foreground="White" FontWeight="Bold" FontSize="11"
                                           DockPanel.Dock="Right" Margin="4,0" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding BalanceForPatient, StringFormat=N1, Mode=OneWay}" Width="50"
                                         Style="{StaticResource WhiteTextBoxStyle}" IsReadOnly="True" FontWeight="Bold"
                                         HorizontalContentAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="1" Background="{StaticResource DangerRed}" Padding="4,2" Margin="1">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="المدفوع" Foreground="White" FontWeight="Bold" FontSize="11"
                                           DockPanel.Dock="Right" Margin="4,0" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged}" Width="50"
                                         Style="{StaticResource WhiteTextBoxStyle}" FontWeight="Bold"
                                         HorizontalContentAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <!-- أزرار الحركات (تحت البواقي في العمود 1) -->
                        <UniformGrid Grid.Row="3" Grid.RowSpan="2" Grid.Column="1" Columns="2" Margin="1">
                            <Button Content="حركة" Command="{Binding ShowMovementCommand}" Style="{StaticResource ActionButtonStyle}" Background="{StaticResource FreshGreen}" Height="24" FontSize="10"/>
                            <Button Content="تراجع" Command="{Binding UndoCommand}"        Style="{StaticResource ActionButtonStyle}" Background="{StaticResource FreshGreen}" Height="24" FontSize="10"/>
                            <Button Content="خالص" Command="{Binding SettleCommand}"      Style="{StaticResource ActionButtonStyle}" Background="{StaticResource FreshGreen}" Height="24" FontSize="10"/>
                            <Button Content="طباعة" Style="{StaticResource ActionButtonStyle}" Background="{StaticResource FreshGreen}" Height="24" FontSize="10"/>
                        </UniformGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============== العمود الأيمن: بيانات المريض + الجهة + المعلومات الإضافية ============== -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- ============ مجموعة بيانات المريض ============ -->
                    <Grid Margin="4,8,4,2">
                        <Border Style="{StaticResource GroupBoxStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*"    />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*"    />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- صف 0: Lab ID + كود المريض -->
                                <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource FreshGreen}" CornerRadius="1" Padding="8,2" Margin="1">
                                    <TextBlock Text="Lab. ID" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBox Grid.Row="0" Grid.Column="1"
                                         Style="{StaticResource WhiteTextBoxStyle}"
                                         Text="{Binding LabId, UpdateSourceTrigger=PropertyChanged}" />
                                <Border Grid.Row="0" Grid.Column="2" Background="{StaticResource BrightOrange}" CornerRadius="1" Padding="8,2" Margin="1">
                                    <TextBlock Text="كود المريض" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBox Grid.Row="0" Grid.Column="3"
                                         Style="{StaticResource WhiteTextBoxStyle}"
                                         Text="{Binding PatientCode, UpdateSourceTrigger=PropertyChanged}" />

                                <!-- صف 1: Sex + Individual -->
                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabelStyle}">
                                    <TextBlock Text="Sex" Style="{StaticResource FieldLabelText}" FlowDirection="LeftToRight"/>
                                </Border>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton Content="Male"
                                                 Style="{StaticResource WhiteRadioStyle}"
                                                 IsChecked="{Binding Gender, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Male}" />
                                    <RadioButton Content="Female"
                                                 Style="{StaticResource WhiteRadioStyle}"
                                                 IsChecked="{Binding Gender, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Female}" />
                                    <RadioButton Content="Unknown"
                                                 Style="{StaticResource WhiteRadioStyle}"
                                                 IsChecked="{Binding Gender, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Unknown}" />
                                </StackPanel>
                                <CheckBox Grid.Row="1" Grid.Column="2" Content="VIP" Foreground="White"
                                          VerticalAlignment="Center" Margin="4,0" FontSize="11"
                                          IsChecked="{Binding IsVip}" />
                                <ComboBox Grid.Row="1" Grid.Column="3"
                                          Style="{StaticResource WhiteComboBoxStyle}"
                                          SelectedItem="{Binding AccountType, Mode=TwoWay}"
                                          IsEditable="True">
                                    <ComboBoxItem Content="Individual" />
                                    <ComboBoxItem Content="Lab to Lab" />
                                </ComboBox>

                                <!-- صف 2: اسم المريض + اللقب -->
                                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabelStyle}">
                                    <TextBlock Text="اسم المريض" Style="{StaticResource FieldLabelText}" />
                                </Border>
                                <TextBox Grid.Row="2" Grid.Column="1"
                                         Style="{StaticResource WhiteTextBoxStyle}"
                                         Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" />
                                <Grid Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0"
                                              Style="{StaticResource WhiteComboBoxStyle}"
                                              SelectedItem="{Binding Title, Mode=TwoWay}"
                                              IsEditable="True"
                                              Width="80">
                                        <ComboBoxItem Content="السيد/" />
                                        <ComboBoxItem Content="السيدة/" />
                                        <ComboBoxItem Content="الآنسة/" />
                                        <ComboBoxItem Content="الطفل/" />
                                    </ComboBox>
                                    <TextBox Grid.Column="1"
                                             Style="{StaticResource WhiteTextBoxStyle}"
                                             Text="{Binding PatientTitleNote, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>

                                <!-- صف 3: السن + عنوان المريض -->
                                <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabelStyle}">
                                    <TextBlock Text="السن" Style="{StaticResource FieldLabelText}" />
                                </Border>
                                <Grid Grid.Row="3" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Style="{StaticResource WhiteTextBoxStyle}"
                                             Text="{Binding Age, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                    <ComboBox Grid.Column="1"
                                              Style="{StaticResource WhiteComboBoxStyle}"
                                              SelectedItem="{Binding AgeUnit, Mode=TwoWay}"
                                              IsEditable="True">
                                        <ComboBoxItem Content="Years" />
                                        <ComboBoxItem Content="Months" />
                                        <ComboBoxItem Content="Days" />
                                    </ComboBox>
                                </Grid>
                                <Border Grid.Row="3" Grid.Column="2" Style="{StaticResource FieldLabelStyle}">
                                    <TextBlock Text="عنوان المريض" Style="{StaticResource FieldLabelText}" />
                                </Border>
                                <TextBox Grid.Row="3" Grid.Column="3"
                                         Style="{StaticResource WhiteTextBoxStyle}"
                                         Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />

                                <!-- صف 4: تليفون + محمول -->
                                <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabelStyle}">
                                    <TextBlock Text="تليفون" Style="{StaticResource FieldLabelText}" />
                                </Border>
                                <TextBox Grid.Row="4" Grid.Column="1"
                                         Style="{StaticResource WhiteTextBoxStyle}"
                                         Text="{Binding HomePhone, UpdateSourceTrigger=PropertyChanged}" />
                                <Border Grid.Row="4" Grid.Column="2" Style="{StaticResource FieldLabelStyle}">
                                    <TextBlock Text="محمول" Style="{StaticResource FieldLabelText}" />
                                </Border>
                                <TextBox Grid.Row="4" Grid.Column="3"
                                         Style="{StaticResource WhiteTextBoxStyle}"
                                         Text="{Binding MobilePhone, UpdateSourceTrigger=PropertyChanged}" />

                                <!-- صف 5: رقم قومي + البريد الإلكتروني -->
                                <Border Grid.Row="5" Grid.Column="0" Style="{StaticResource FieldLabelStyle}">
                                    <TextBlock Text="رقم قومي" Style="{StaticResource FieldLabelText}" />
                                </Border>
                                <TextBox Grid.Row="5" Grid.Column="1"
                                         Style="{StaticResource WhiteTextBoxStyle}"
                                         Text="{Binding NationalId, UpdateSourceTrigger=PropertyChanged}" />
                                <Border Grid.Row="5" Grid.Column="2" Style="{StaticResource FieldLabelStyle}">
                                    <TextBlock Text="البريد الإلكتروني" Style="{StaticResource FieldLabelText}" />
                                </Border>
                                <TextBox Grid.Row="5" Grid.Column="3"
                                         Style="{StaticResource WhiteTextBoxStyle}"
                                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Border>
                        <!-- ترويسة المجموعة -->
                        <Border Style="{StaticResource GroupHeaderStyle}" VerticalAlignment="Top">
                            <TextBlock Text="بيانات المريض" Style="{StaticResource GroupHeaderText}" />
                        </Border>
                    </Grid>

                    <!-- ============ مجموعة بيانات الطبيب أو الجهة ============ -->
                    <Grid Margin="4,10,4,2">
                        <Border Style="{StaticResource GroupBoxStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*"    />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*"    />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- صف 0: جهة الإحالة -->
                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabelStyle}">
                                    <TextBlock Text="جهة الإحالة" Style="{StaticResource FieldLabelText}" />
                                </Border>
                                <ComboBox Grid.Row="0" Grid.Column="1"
                                          Style="{StaticResource WhiteComboBoxStyle}"
                                          ItemsSource="{Binding Referrals}"
                                          SelectedItem="{Binding SelectedReferral}"
                                          DisplayMemberPath="Name" />
                                <Grid Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" Content="Print" Foreground="White"
                                              VerticalAlignment="Center" Margin="4,0" FontSize="11"
                                              IsChecked="{Binding PrintReferralOnReport}" FlowDirection="LeftToRight" />
                                    <TextBox Grid.Column="1"
                                             Style="{StaticResource WhiteTextBoxStyle}"
                                             Text="{Binding ReferralTitleNote}" />
                                    <ComboBox Grid.Column="2"
                                              Style="{StaticResource WhiteComboBoxStyle}"
                                              SelectedItem="{Binding DoctorTitle, Mode=TwoWay}"
                                              IsEditable="True"
                                              Width="60">
                                        <ComboBoxItem Content="د./" />
                                        <ComboBoxItem Content="أ.د./" />
                                        <ComboBoxItem Content="م.د./" />
                                    </ComboBox>
                                </Grid>

                                <!-- صف 1: تليفون + عنوان الجهة -->
                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabelStyle}">
                                    <TextBlock Text="تليفون" Style="{StaticResource FieldLabelText}" />
                                </Border>
                                <TextBox Grid.Row="1" Grid.Column="1"
                                         Style="{StaticResource WhiteTextBoxStyle}"
                                         Text="{Binding ReferralPhone, UpdateSourceTrigger=PropertyChanged}" />
                                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource FieldLabelStyle}">
                                    <TextBlock Text="عنوان الجهة" Style="{StaticResource FieldLabelText}" />
                                </Border>
                                <TextBox Grid.Row="1" Grid.Column="3"
                                         Style="{StaticResource WhiteTextBoxStyle}"
                                         Text="{Binding ReferralAddress, UpdateSourceTrigger=PropertyChanged}" />

                                <!-- صف 2: تليفون + اسم المسؤول -->
                                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabelStyle}">
                                    <TextBlock Text="تليفون" Style="{StaticResource FieldLabelText}" />
                                </Border>
                                <TextBox Grid.Row="2" Grid.Column="1"
                                         Style="{StaticResource WhiteTextBoxStyle}"
                                         Text="{Binding ReferralAltPhone, UpdateSourceTrigger=PropertyChanged}" />
                                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource FieldLabelStyle}">
                                    <TextBlock Text="اسم المسؤول" Style="{StaticResource FieldLabelText}" />
                                </Border>
                                <Grid Grid.Row="2" Grid.Column="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Style="{StaticResource WhiteTextBoxStyle}"
                                             Text="{Binding ReferralResponsible, UpdateSourceTrigger=PropertyChanged}" />
                                    <ComboBox Grid.Column="1" Style="{StaticResource WhiteComboBoxStyle}" Width="50">
                                        <ComboBoxItem Content="د./" />
                                    </ComboBox>
                                </Grid>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource GroupHeaderStyle}" VerticalAlignment="Top">
                            <TextBlock Text="بيانات الطبيب أو الجهة" Style="{StaticResource GroupHeaderText}" />
                        </Border>
                    </Grid>

                    <!-- ============ مجموعة معلومات اضافية ============ -->
                    <Grid Margin="4,10,4,2">
                        <Border Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <!-- صف صائم + ساعات الصيام + هل سبق التحليل -->
                                <Grid Margin="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" Content="صائم" Style="{StaticResource OliveCheckBoxStyle}"
                                              IsChecked="{Binding IsFasting}" />
                                    <Border Grid.Column="1" Style="{StaticResource FieldLabelStyle}" MinWidth="110">
                                        <TextBlock Text="عدد ساعات الصيام" Style="{StaticResource FieldLabelText}" />
                                    </Border>
                                    <TextBox  Grid.Column="2"
                                              Style="{StaticResource WhiteTextBoxStyle}"
                                              Width="40"
                                              Text="{Binding FastingHours, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Grid.Column="4"
                                              Content="هل سبق لك التحليل بمعملنا"
                                              Style="{StaticResource OliveCheckBoxStyle}"
                                              IsChecked="{Binding HadPreviousAnalysisHere}" />
                                </Grid>

                                <!-- شبكة الـ checkboxes الإضافية -->
                                <UniformGrid Columns="3" Margin="1">
                                    <CheckBox Content="هل يأخذ علاج لسيولة الدم" Style="{StaticResource OliveCheckBoxStyle}" IsChecked="{Binding TakesBloodThinners}" />
                                    <CheckBox Content="هل يأخذ علاج مضاد حيوي"   Style="{StaticResource OliveCheckBoxStyle}" IsChecked="{Binding TakesAntibiotics}" />
                                    <CheckBox Content="هل يأخذ علاج للسكر"        Style="{StaticResource OliveCheckBoxStyle}" IsChecked="{Binding TakesDiabetesTreatment}" />

                                    <CheckBox Content="هل يأخذ علاج للفيروسات"    Style="{StaticResource OliveCheckBoxStyle}" IsChecked="{Binding TakesAntiVirals}" />
                                    <CheckBox Content="هل سبق نقل دم"             Style="{StaticResource OliveCheckBoxStyle}" IsChecked="{Binding HadBloodTransfusion}" />
                                    <CheckBox Content="هل يأخذ علاج للغدد"        Style="{StaticResource OliveCheckBoxStyle}" IsChecked="{Binding TakesGlandsTreatment}" />

                                    <CheckBox Content="للسيدات هل يوجد حمل"       Style="{StaticResource OliveCheckBoxStyle}" IsChecked="{Binding IsPregnant}" />
                                    <CheckBox Content="هل المريض مدخن"            Style="{StaticResource OliveCheckBoxStyle}" IsChecked="{Binding IsSmoker}" />
                                    <CheckBox Content="هل يأخذ علاج للكبد"        Style="{StaticResource OliveCheckBoxStyle}" IsChecked="{Binding TakesLiverTreatment}" />

                                    <CheckBox Content="هل تم عمل اشعة بالصبغة"    Style="{StaticResource OliveCheckBoxStyle}" IsChecked="{Binding HadContrastImaging}" />
                                </UniformGrid>

                                <!-- أزرار العينات -->
                                <WrapPanel Margin="1,4,1,1" FlowDirection="LeftToRight">
                                    <ToggleButton Content="Blood" Style="{StaticResource SampleButtonStyle}" IsChecked="{Binding HasBloodSample}" />
                                    <ToggleButton Content="Urine" Style="{StaticResource SampleButtonStyle}" IsChecked="{Binding HasUrineSample}" />
                                    <ToggleButton Content="Stool" Style="{StaticResource SampleButtonStyle}" IsChecked="{Binding HasStoolSample}" />
                                    <ToggleButton Content="Semen" Style="{StaticResource SampleButtonStyle}" IsChecked="{Binding HasSemenSample}" />
                                    <ToggleButton Content="CSF"   Style="{StaticResource SampleButtonStyle}" IsChecked="{Binding HasCsfSample}" />
                                    <ToggleButton Content="Taken outside Lab"
                                                  Style="{StaticResource SampleButtonStyle}"
                                                  Background="{StaticResource BrightOrange}"
                                                  Foreground="White"
                                                  MinWidth="130"
                                                  IsChecked="{Binding TakenOutsideLab}" />
                                </WrapPanel>

                                <Grid Margin="1,4,1,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Style="{StaticResource WhiteTextBoxStyle}"
                                             MinHeight="40"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             Text="{Binding MedicalNotes, UpdateSourceTrigger=PropertyChanged}" />
                                    <Border Grid.Column="1" Background="{StaticResource BrightOrange}" CornerRadius="1"
                                            Padding="12,2" Margin="1" VerticalAlignment="Stretch">
                                        <TextBlock Text="ملاحظات" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource GroupHeaderStyle}" VerticalAlignment="Top">
                            <TextBlock Text="معلومات اضافية" Style="{StaticResource GroupHeaderText}" />
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============================================================ -->
        <!-- 3) شريط أزرار الإجراءات السفلي                               -->
        <!-- ============================================================ -->
        <Border Grid.Row="2" Margin="4,2" Padding="2" Background="Transparent">
            <UniformGrid Columns="6">
                <Button Content="إضافة مريض"   Command="{Binding NewCommand}"         Style="{StaticResource ActionButtonStyle}" Background="{StaticResource LimeGreen}" />
                <Button Content="تعديل"        Command="{Binding EditCommand}"        Style="{StaticResource ActionButtonStyle}" Background="{StaticResource LimeGreen}" />
                <Button Content="حفظ"          Command="{Binding SaveCommand}"        Style="{StaticResource ActionButtonStyle}" Background="{StaticResource LimeGreen}" />
                <Button Content="حذف"          Command="{Binding DeleteCommand}"      Style="{StaticResource ActionButtonStyle}" Background="{StaticResource BrightOrange}" />
                <Button Content="الباركود"     Command="{Binding ShowBarcodeCommand}" Style="{StaticResource ActionButtonStyle}" Background="{StaticResource LimeGreen}" />
                <Button Content="الإيصال"      Command="{Binding SendCommand}"        Style="{StaticResource ActionButtonStyle}" Background="{StaticResource LimeGreen}" />
            </UniformGrid>
        </Border>

        <!-- ============================================================ -->
        <!-- 4) الشريط السفلي: القائمة الرئيسية + النتائج + مرضى اليوم    -->
        <!-- ============================================================ -->
        <Border Grid.Row="3" Margin="4,2" Padding="4" Background="#13314F">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="القائمة الرئيسية"
                        Command="{Binding DataContext.NavigateToPatientsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="#2E86C1"
                        Foreground="White"
                        MinWidth="120" />
                <Button Grid.Column="1" Content="نتائج التحاليل"
                        Command="{Binding DataContext.NavigateResultsEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="White"
                        Foreground="Black"
                        MinWidth="100" />
                <ComboBox Grid.Column="2"
                          Margin="6,0"
                          Style="{StaticResource WhiteComboBoxStyle}"
                          ItemsSource="{Binding QuickPatientsList}"
                          SelectedItem="{Binding QuickSelectedPatient}"
                          DisplayMemberPath="FullName" />
                <Button Grid.Column="3" Content="مرضى اليوم"
                        Command="{Binding ShowTodayPatientsCommand}"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="#2E86C1"
                        Foreground="White"
                        MinWidth="100" />
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- 5) رسالة الحالة                                              -->
        <!-- ============================================================ -->
        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}"
                    Foreground="{StaticResource HeaderYellow}" Margin="10,0" FontWeight="Bold" FontSize="11" />
    </Grid>
</UserControl>
