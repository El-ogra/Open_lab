<UserControl x:Class="Open_lab.Views.Patients.PatientRegistrationView"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
FlowDirection="RightToLeft"
Background="#13314F">

    <UserControl.Resources>

        <!-- ========= ألوان الواجهة ========= -->
        <SolidColorBrush x:Key="NavyBackground"  Color="#13314F" />
        <SolidColorBrush x:Key="PanelBorder"     Color="#1F4F86" />
        <SolidColorBrush x:Key="HeaderOrange"    Color="#D35400" />
        <SolidColorBrush x:Key="BrightOrange"    Color="#E67E22" />
        <SolidColorBrush x:Key="HeaderYellow"    Color="#F1C40F" />
        <SolidColorBrush x:Key="SoftYellow"      Color="#FFF59D" />
        <SolidColorBrush x:Key="OliveGreen"      Color="#1B5E20" />
        <SolidColorBrush x:Key="FreshGreen"      Color="#27AE60" />
        <SolidColorBrush x:Key="LimeGreen"       Color="#8DB600" />
        <SolidColorBrush x:Key="DangerRed"       Color="#C0392B" />
        <SolidColorBrush x:Key="InfoBlue"        Color="#2980B9" />
        <SolidColorBrush x:Key="LabelBlue"       Color="#3498DB" />
        <SolidColorBrush x:Key="YellowPanel"     Color="#F1C40F" />
        <SolidColorBrush x:Key="DarkBlueHeader"  Color="#0B243B" />
        <SolidColorBrush x:Key="CyanLabel"       Color="#00838F" />
        <SolidColorBrush x:Key="TestListBg"      Color="#C62828" />
        <SolidColorBrush x:Key="MedicalDarkGreen" Color="#2E7D32" />
        <SolidColorBrush x:Key="MedicalLeftGreen" Color="#388E3C" />

        <!-- ========= أنماط الترويسة ========= -->
        <Style x:Key="GroupHeaderStyle" TargetType="Border">
            <Setter Property="Background"          Value="{StaticResource DarkBlueHeader}" />
            <Setter Property="CornerRadius"        Value="2" />
            <Setter Property="Padding"             Value="10,2" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin"              Value="0,0,10,-12" />
            <Setter Property="BorderBrush"         Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness"     Value="1" />
        </Style>
        <Style x:Key="GroupHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{StaticResource HeaderYellow}" />
            <Setter Property="FontWeight"  Value="Bold" />
            <Setter Property="FontSize"    Value="12" />
        </Style>

        <!-- ========= نمط الإطار الأزرق ========= -->
        <Style x:Key="GroupBoxStyle" TargetType="Border">
            <Setter Property="Background"       Value="Transparent" />
            <Setter Property="BorderBrush"      Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness"  Value="1" />
            <Setter Property="CornerRadius"     Value="2" />
            <Setter Property="Padding"          Value="6,14,6,6" />
            <Setter Property="Margin"           Value="4,6,4,2" />
        </Style>

        <!-- ========= نمط ليبل الحقل ========= -->
        <Style x:Key="FieldLabelStyle" TargetType="Border">
            <Setter Property="Background"       Value="{StaticResource LabelBlue}" />
            <Setter Property="CornerRadius"     Value="1" />
            <Setter Property="Padding"          Value="4,2" />
            <Setter Property="Margin"           Value="1" />
            <Setter Property="MinWidth"         Value="80" />
            <Setter Property="Height"           Value="24" />
        </Style>
        <Style x:Key="FieldLabelText" TargetType="TextBlock">
            <Setter Property="Foreground"          Value="White" />
            <Setter Property="FontWeight"          Value="SemiBold" />
            <Setter Property="FontSize"            Value="11" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment"   Value="Center" />
        </Style>

        <!-- ========= ليبل سيان ========= -->
        <Style x:Key="CyanLabelStyle" TargetType="Border">
            <Setter Property="Background"       Value="{StaticResource CyanLabel}" />
            <Setter Property="CornerRadius"     Value="1" />
            <Setter Property="Padding"          Value="6,2" />
            <Setter Property="Margin"           Value="1" />
            <Setter Property="MinWidth"         Value="60" />
            <Setter Property="Height"           Value="24" />
        </Style>

        <!-- ========= ليبل أصفر (للتاريخ) ========= -->
        <Style x:Key="YellowLabelStyle" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource HeaderYellow}" />
            <Setter Property="CornerRadius"    Value="1" />
            <Setter Property="Padding"         Value="6,2" />
            <Setter Property="Margin"          Value="1" />
            <Setter Property="MinWidth"        Value="90" />
            <Setter Property="Height"          Value="24" />
            <Setter Property="BorderBrush"     Value="#7F6E00" />
            <Setter Property="BorderThickness" Value="0.5" />
        </Style>
        <Style x:Key="YellowLabelText" TargetType="TextBlock">
            <Setter Property="Foreground"          Value="#1A1A00" />
            <Setter Property="FontWeight"          Value="Bold" />
            <Setter Property="FontSize"            Value="11" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment"   Value="Center" />
        </Style>

        <!-- ========= نمط أزرار الإجراءات ========= -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="MinWidth"        Value="70" />
            <Setter Property="Height"          Value="26" />
            <Setter Property="Margin"          Value="1" />
            <Setter Property="Background"      Value="{StaticResource FreshGreen}" />
            <Setter Property="Foreground"      Value="Black" />
            <Setter Property="BorderThickness" Value="0.5" />
            <Setter Property="BorderBrush"     Value="#444" />
            <Setter Property="FontWeight"      Value="Bold" />
            <Setter Property="FontSize"        Value="11" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
Background="{TemplateBinding Background}"
BorderBrush="{TemplateBinding BorderBrush}"
BorderThickness="{TemplateBinding BorderThickness}"
CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Background" Value="#BDC3C7" />
                                <Setter Property="Foreground" Value="#7F8C8D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========= ترويسة عينات خارج المختبر ========= -->
        <Style x:Key="OutsideLabHeaderStyle" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource BrightOrange}" />
            <Setter Property="Padding"         Value="8,4" />
            <Setter Property="Margin"          Value="0" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>

        <!-- ========= CheckBox أنماط العينات ========= -->
        <Style x:Key="SampleCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="FontWeight"        Value="Bold" />
            <Setter Property="FontSize"          Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin"            Value="6,2,8,2" />
            <Setter Property="Cursor"            Value="Hand" />
            <Setter Property="FlowDirection"     Value="LeftToRight" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="CheckBoxBorder"
Width="14" Height="14"
Background="White"
BorderBrush="#5D4037"
BorderThickness="1"
Margin="0,0,6,0"
VerticalAlignment="Center">
                                <Path x:Name="CheckMark"
Data="M 1 7 L 4 10 L 11 2"
Stroke="#1B5E20"
StrokeThickness="2"
Visibility="Collapsed"
Margin="1" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"
RecognizesAccessKey="True" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="#FFF9C4" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource HeaderOrange}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========= CheckBox الطبي (يمين) ========= -->
        <Style x:Key="MedicalRightCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground"      Value="White" />
            <Setter Property="FontSize"        Value="11" />
            <Setter Property="FontWeight"      Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin"          Value="1" />
            <Setter Property="MinHeight"       Value="22" />
            <Setter Property="Background"      Value="{StaticResource MedicalDarkGreen}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="1" Padding="4,2">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Left" Width="14" Height="14"
Background="White" BorderBrush="#0B243B" BorderThickness="1"
Margin="2,0,6,0" VerticalAlignment="Center">
                                    <Path x:Name="CheckMark"
Stretch="Fill" Stroke="#1B5E20" StrokeThickness="2"
Data="M 0 5 L 4 9 L 10 0" Margin="1" Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========= CheckBox الطبي (يسار) ========= -->
        <Style x:Key="MedicalLeftCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource MedicalRightCheckBoxStyle}">
            <Setter Property="Background" Value="{StaticResource MedicalLeftGreen}" />
        </Style>

        <!-- ========= CheckBox أصفر ========= -->
        <Style x:Key="YellowCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground"      Value="#1A1A00" />
            <Setter Property="FontSize"        Value="11" />
            <Setter Property="FontWeight"      Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin"          Value="1" />
            <Setter Property="MinHeight"       Value="22" />
            <Setter Property="Background"      Value="{StaticResource SoftYellow}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="1" Padding="4,2"
BorderBrush="#7F6E00" BorderThickness="0.5">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Left" Width="14" Height="14"
Background="White" BorderBrush="#0B243B" BorderThickness="1"
Margin="2,0,6,0" VerticalAlignment="Center">
                                    <Path x:Name="CheckMark"
Stretch="Fill" Stroke="#1B5E20" StrokeThickness="2"
Data="M 0 5 L 4 9 L 10 0" Margin="1" Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========= حقل نص أبيض ========= -->
        <Style x:Key="WhiteTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background"              Value="White" />
            <Setter Property="Foreground"              Value="Black" />
            <Setter Property="Padding"                 Value="2,1" />
            <Setter Property="BorderBrush"             Value="#7FB3D5" />
            <Setter Property="BorderThickness"         Value="1" />
            <Setter Property="MinHeight"               Value="22" />
            <Setter Property="Height"                  Value="24" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin"                  Value="1" />
        </Style>

        <Style x:Key="WhiteComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="Height"     Value="24" />
            <Setter Property="Margin"     Value="1" />
        </Style>

        <Style x:Key="WhiteRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground"        Value="White" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin"            Value="3,0,6,0" />
            <Setter Property="FontSize"          Value="11" />
        </Style>

        <Style x:Key="DarkRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground"        Value="#13314F" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin"            Value="3,0,6,0" />
            <Setter Property="FontSize"          Value="11" />
            <Setter Property="FontWeight"        Value="Bold" />
        </Style>

        <!-- ========= شريط الإجراءات الجانبي ========= -->
        <SolidColorBrush x:Key="SidebarLime"       Color="#B8E986" />
        <SolidColorBrush x:Key="SidebarYellowBtn"  Color="#F4D03F" />
        <SolidColorBrush x:Key="SidebarTicketBlue" Color="#5DADE2" />
        <SolidColorBrush x:Key="SidebarMenuBlue"   Color="#2874A6" />

        <Style x:Key="SidebarActionButtonStyle" TargetType="Button">
            <Setter Property="MinHeight"       Value="36" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin"          Value="2,1" />
            <Setter Property="Padding"         Value="2,1" />
            <Setter Property="BorderBrush"     Value="#2C3E50" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground"      Value="Black" />
            <Setter Property="FontWeight"      Value="Bold" />
            <Setter Property="FontSize"        Value="11" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
Background="{TemplateBinding Background}"
BorderBrush="{TemplateBinding BorderBrush}"
BorderThickness="{TemplateBinding BorderThickness}"
CornerRadius="2"
Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch"
VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarIconGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily"          Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize"            Value="15" />
            <Setter Property="Width"               Value="24" />
            <Setter Property="TextAlignment"       Value="Center" />
            <Setter Property="VerticalAlignment"   Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <!-- ========= زر معلومات إضافية ========= -->
        <Style x:Key="GreenInfoButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource FreshGreen}" />
            <Setter Property="Foreground"      Value="White" />
            <Setter Property="FontWeight"      Value="Bold" />
            <Setter Property="FontSize"        Value="11" />
            <Setter Property="MinHeight"       Value="24" />
            <Setter Property="MinWidth"        Value="100" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="2" Padding="6,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- ===================================================================== -->
    <!--  الشبكة الرئيسية للصفحة                                                -->
    <!-- ===================================================================== -->
    <Grid Margin="4,2,4,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================================================================= -->
        <!-- ROW 0 – شريط التاريخ والوقت العلوي                                  -->
        <!-- ================================================================= -->
        <Border Grid.Row="0" Margin="2,2,2,4" Padding="4,2"
Background="#0B243B"
BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
CornerRadius="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- تاريخ الدخول -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
HorizontalAlignment="Right" Margin="4,0">
                    <TextBox Width="72" Style="{StaticResource WhiteTextBoxStyle}"
Text="{Binding EntryTimeText, UpdateSourceTrigger=PropertyChanged}"
FontWeight="Bold" FlowDirection="LeftToRight" Language="en-US" />
                    <TextBox Width="115" Style="{StaticResource WhiteTextBoxStyle}" Margin="1"
Text="{Binding EntryDate, StringFormat='{}{0:dd-MMM-yyyy}', UpdateSourceTrigger=PropertyChanged}"
FlowDirection="LeftToRight" Language="en-US" />
                    <Border Style="{StaticResource YellowLabelStyle}">
                        <TextBlock Text="تاريخ الدخول" Style="{StaticResource YellowLabelText}" />
                    </Border>
                </StackPanel>

                <!-- تاريخ الاستلام -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
HorizontalAlignment="Right" Margin="4,0">
                    <TextBox Width="72" Style="{StaticResource WhiteTextBoxStyle}"
Text="{Binding ReceptionTimeText, UpdateSourceTrigger=PropertyChanged}"
FontWeight="Bold" FlowDirection="LeftToRight" Language="en-US" />
                    <TextBox Width="115" Style="{StaticResource WhiteTextBoxStyle}" Margin="1"
Text="{Binding ReceptionDate, StringFormat='{}{0:dd-MMM-yyyy}', UpdateSourceTrigger=PropertyChanged}"
FlowDirection="LeftToRight" Language="en-US" />
                    <Border Style="{StaticResource YellowLabelStyle}">
                        <TextBlock Text="تاريخ الاستلام" Style="{StaticResource YellowLabelText}" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================================================= -->
        <!-- ROW 1 – المنطقة الرئيسية                                           -->
        <!-- ================================================================= -->
        <Grid Grid.Row="1" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.75*" />
                <ColumnDefinition Width="1.25*" />
            </Grid.ColumnDefinitions>

            <!-- ============================================================= -->
            <!-- COL 1 (يسار بصرياً): قائمة التحاليل + الملخص المالي           -->
            <!-- ============================================================= -->
            <Grid Grid.Column="1" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- *** لوحة قائمة التحاليل *** -->
                <Border Grid.Row="0"
Background="{StaticResource NavyBackground}"
BorderBrush="{StaticResource PanelBorder}"
BorderThickness="1" CornerRadius="2"
Margin="2,2,2,2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- شريط الرأس -->
                        <Grid Grid.Row="0" Background="{StaticResource HeaderYellow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
Content="start"
Command="{Binding StartCommand}"
Background="{StaticResource HeaderYellow}"
Foreground="#13314F"
FontWeight="Bold" FontSize="12"
Height="26" MinWidth="60" Margin="4,2"
BorderBrush="#7F6E00"
BorderThickness="1"
Cursor="Hand"
FlowDirection="LeftToRight">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="White" CornerRadius="2"
BorderBrush="#7F6E00" BorderThickness="1" Padding="6,2">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <StackPanel Grid.Column="1" Orientation="Horizontal"
HorizontalAlignment="Center" VerticalAlignment="Center"
FlowDirection="LeftToRight">
                                <RadioButton Content="TM" GroupName="TestMode"
Style="{StaticResource DarkRadioStyle}" IsChecked="True" />
                                <RadioButton Content="TG" GroupName="TestMode"
Style="{StaticResource DarkRadioStyle}" />
                                <RadioButton Content="CG" GroupName="TestMode"
Style="{StaticResource DarkRadioStyle}" />
                            </StackPanel>

                            <TextBlock Grid.Column="2"
Text="complete test menu"
Foreground="{StaticResource DangerRed}" FontWeight="Bold" FontSize="11"
VerticalAlignment="Center" Margin="6,0"
Cursor="Hand" FlowDirection="LeftToRight"
TextDecorations="Underline" />
                        </Grid>

                        <!-- عنوان قائمة الاختبارات -->
                        <Grid Grid.Row="1" Margin="2,3,2,1" FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="34" />
                            </Grid.ColumnDefinitions>

                            <DockPanel Grid.Column="0" Margin="1,0">
                                <ComboBox DockPanel.Dock="Left"
SelectedItem="{Binding TestCategoryFilter, Mode=TwoWay}"
Style="{StaticResource WhiteComboBoxStyle}"
Width="85" FlowDirection="LeftToRight">
                                    <ComboBoxItem Content="Routine Tests" IsSelected="True" />
                                    <ComboBoxItem Content="Send Out" />
                                    <ComboBoxItem Content="All" />
                                </ComboBox>
                                <TextBox Style="{StaticResource WhiteTextBoxStyle}"
Text="{Binding TestSearchText, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>

                            <Border Grid.Column="1" Background="{StaticResource FreshGreen}" Padding="4,2" Margin="1,0">
                                <TextBlock Text="Patient's tests" Foreground="White" FontWeight="Bold"
FontSize="11" HorizontalAlignment="Center"
VerticalAlignment="Center" FlowDirection="LeftToRight" />
                            </Border>

                            <Border Grid.Column="2" Background="{StaticResource BrightOrange}" Margin="0,0,1,0">
                                <TextBlock Text="{Binding SelectedTests.Count}"
Foreground="White" FontWeight="Bold" FontSize="13"
HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>

                        <!-- القوائم المتوازية -->
                        <Grid Grid.Row="2" Margin="2,1" FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <DataGrid Grid.Column="0" x:Name="AvailableTestsList" Margin="1"
Background="White"
ItemsSource="{Binding AvailableTests}"
SelectedItem="{Binding SelectedAvailableTest}"
AutoGenerateColumns="False"
CanUserAddRows="False" IsReadOnly="True"
HeadersVisibility="None"
RowHeaderWidth="0"
MouseDoubleClick="AvailableTestsList_MouseDoubleClick"
FlowDirection="LeftToRight"
RowBackground="White"
AlternatingRowBackground="#F5F5F5"
GridLinesVisibility="Horizontal"
FontWeight="Bold" FontSize="11">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding NameReport}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <DataGrid Grid.Column="1" Margin="1"
Background="#0B243B"
Foreground="White"
ItemsSource="{Binding SelectedTests}"
SelectedItem="{Binding SelectedTest}"
AutoGenerateColumns="False"
CanUserAddRows="False" IsReadOnly="True"
HeadersVisibility="None"
RowHeaderWidth="0"
FlowDirection="LeftToRight"
RowBackground="#0B243B"
AlternatingRowBackground="#102E4E"
GridLinesVisibility="None"
FontWeight="Bold" FontSize="11">
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Padding" Value="4,2" />
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="{StaticResource InfoBlue}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.CellStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding TestName}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <!-- أزرار Add / Delete / All -->
                        <UniformGrid Grid.Row="3" Columns="3" Margin="2,2,2,1">
                            <Button Content="Add select test"
Command="{Binding AddTestCommand}"
Style="{StaticResource ActionButtonStyle}"
Background="{StaticResource LimeGreen}"
FlowDirection="LeftToRight" />
                            <Button Content="Delete"
Command="{Binding RemoveTestCommand}"
Style="{StaticResource ActionButtonStyle}"
Background="{StaticResource OliveGreen}"
Foreground="White"
FlowDirection="LeftToRight" />
                            <Button Content="All"
Command="{Binding AddAllTestsCommand}"
Style="{StaticResource ActionButtonStyle}"
Background="{StaticResource OliveGreen}"
Foreground="White"
FlowDirection="LeftToRight" />
                        </UniformGrid>

                        <!-- عينات خارج المختبر -->
                        <Border Grid.Row="4" Margin="2,2,2,3"
BorderBrush="{StaticResource BrightOrange}"
BorderThickness="1"
CornerRadius="1"
Background="{StaticResource DarkBlueHeader}"
Padding="1">
                            <Grid FlowDirection="LeftToRight">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource OutsideLabHeaderStyle}">
                                    <TextBlock Text="Taken outside lab"
Foreground="White"
FontWeight="Bold"
FontSize="11"
VerticalAlignment="Center" />
                                </Border>

                                <Border Grid.Column="1"
Background="#FFF8E1"
Padding="4,2">
                                    <WrapPanel VerticalAlignment="Center">
                                        <CheckBox Content="Urine"
Style="{StaticResource SampleCheckBoxStyle}"
Foreground="#5D4037"
IsChecked="{Binding HasUrineSample}" />
                                        <CheckBox Content="Stool"
Style="{StaticResource SampleCheckBoxStyle}"
Foreground="#5D4037"
IsChecked="{Binding HasStoolSample}" />
                                        <CheckBox Content="Blood"
Style="{StaticResource SampleCheckBoxStyle}"
Foreground="#C62828"
IsChecked="{Binding HasBloodSample}" />
                                        <CheckBox Content="Semen"
Style="{StaticResource SampleCheckBoxStyle}"
Foreground="#4A148C"
IsChecked="{Binding HasSemenSample}" />
                                        <CheckBox Content="CSF"
Style="{StaticResource SampleCheckBoxStyle}"
Foreground="#1B5E20"
IsChecked="{Binding HasCsfSample}" />
                                    </WrapPanel>
                                </Border>
                            </Grid>
                        </Border>

                    </Grid>
                </Border>

                <!-- ===================================================================== -->
                <!-- *** الملخص المالي المُحسّن *** -->
                <!-- ===================================================================== -->
                <Border Grid.Row="1"
Background="{StaticResource YellowPanel}"
BorderBrush="{StaticResource PanelBorder}"
BorderThickness="1" CornerRadius="2"
Margin="2,2,2,0" Padding="3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- إجمالي التحاليل -->
                        <Grid Grid.Row="0" Grid.Column="0" Margin="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource DangerRed}" Padding="4,2">
                                <TextBlock Text="إجمالي التحاليل" Foreground="White" FontWeight="Bold" FontSize="11"
HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBox Grid.Column="1"
Text="{Binding TotalAmount, StringFormat=N0, Mode=OneWay}"
Style="{StaticResource WhiteTextBoxStyle}" IsReadOnly="True"
FontWeight="Bold" HorizontalContentAlignment="Center" />
                        </Grid>

                        <!-- الخصم -->
                        <Grid Grid.Row="1" Grid.Column="0" Margin="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource InfoBlue}" Padding="4,2">
                                <TextBlock Text="الخصم" Foreground="White" FontWeight="Bold" FontSize="11"
HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBox Grid.Column="1"
Text="{Binding DiscountPercent, UpdateSourceTrigger=PropertyChanged}"
Style="{StaticResource WhiteTextBoxStyle}" FontWeight="Bold"
HorizontalContentAlignment="Center" />
                            <ComboBox Grid.Column="2" Style="{StaticResource WhiteComboBoxStyle}" FontSize="10">
                                <ComboBoxItem Content="%" IsSelected="True" />
                            </ComboBox>
                        </Grid>

                        <!-- قيمة الخصم -->
                        <Grid Grid.Row="2" Grid.Column="0" Margin="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource InfoBlue}" Padding="4,2">
                                <TextBlock Text="قيمة الخصم" Foreground="White" FontWeight="Bold" FontSize="11"
HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBox Grid.Column="1"
Text="{Binding DiscountAmount, StringFormat=N0, Mode=OneWay}"
Style="{StaticResource WhiteTextBoxStyle}" IsReadOnly="True"
FontWeight="Bold" HorizontalContentAlignment="Center" />
                        </Grid>

                        <!-- التكلفة بعد الخصم -->
                        <Grid Grid.Row="3" Grid.Column="0" Margin="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource InfoBlue}" Padding="4,2">
                                <TextBlock Text="التكلفة بعد الخصم" Foreground="White" FontWeight="Bold" FontSize="11"
HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBox Grid.Column="1"
Text="{Binding NetTotal, StringFormat=N0, Mode=OneWay}"
Style="{StaticResource WhiteTextBoxStyle}" IsReadOnly="True"
FontWeight="Bold" HorizontalContentAlignment="Center" />
                        </Grid>

                        <!-- المدفوع سابقاً -->
                        <Grid Grid.Row="4" Grid.Column="0" Margin="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource InfoBlue}" Padding="4,2">
                                <TextBlock Text="المدفوع سابقاً" Foreground="White" FontWeight="Bold" FontSize="11"
HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBox Grid.Column="1"
Text="{Binding PreviousPaidAmount, UpdateSourceTrigger=PropertyChanged}"
Style="{StaticResource WhiteTextBoxStyle}" FontWeight="Bold"
HorizontalContentAlignment="Center" />
                        </Grid>

                        <!-- الباقي للمعمل -->
                        <Grid Grid.Row="0" Grid.Column="1" Margin="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="95" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource BrightOrange}" Padding="4,2">
                                <TextBlock Text="الباقي للمعمل" Foreground="White" FontWeight="Bold" FontSize="11"
HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBox Grid.Column="1"
Text="{Binding BalanceForLab, StringFormat=N0, Mode=OneWay}"
Style="{StaticResource WhiteTextBoxStyle}" IsReadOnly="True"
FontWeight="Bold" HorizontalContentAlignment="Center"
Background="#C62828" Foreground="White" />
                        </Grid>

                        <!-- الباقي للمريض -->
                        <Grid Grid.Row="1" Grid.Column="1" Margin="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="95" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource BrightOrange}" Padding="4,2">
                                <TextBlock Text="الباقي للمريض" Foreground="White" FontWeight="Bold" FontSize="11"
HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBox Grid.Column="1"
Text="{Binding BalanceForPatient, StringFormat=N1, Mode=OneWay}"
Style="{StaticResource WhiteTextBoxStyle}" IsReadOnly="True"
FontWeight="Bold" HorizontalContentAlignment="Center"
Background="{StaticResource BrightOrange}" Foreground="White" />
                        </Grid>

                        <!-- المدفوع + الأزرار -->
                        <Grid Grid.Row="2" Grid.Column="1" Grid.RowSpan="3" Margin="1" VerticalAlignment="Top">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- المدفوع -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="95" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource DangerRed}" Padding="4,2">
                                    <TextBlock Text="المدفوع" Foreground="White" FontWeight="Bold" FontSize="11"
HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBox Grid.Column="1"
Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged}"
Style="{StaticResource WhiteTextBoxStyle}" FontWeight="Bold"
HorizontalContentAlignment="Center" />
                            </Grid>

                            <!-- الأزرار: خالص | تراجع | موافق -->
                            <UniformGrid Grid.Row="1" Columns="3" Margin="0,4,0,0">
                                <Button Content="خالص" Command="{Binding SettleCommand}"
Style="{StaticResource ActionButtonStyle}"
Background="{StaticResource FreshGreen}" Height="24" FontSize="10"
Margin="0,0,1,0" />
                                <Button Content="تراجع" Command="{Binding UndoCommand}"
Style="{StaticResource ActionButtonStyle}"
Background="{StaticResource DangerRed}" Foreground="White" Height="24" FontSize="10"
Margin="1,0" />
                                <Button Content="موافق" Command="{Binding SaveCommand}"
Style="{StaticResource ActionButtonStyle}"
Background="{StaticResource OliveGreen}" Foreground="White" Height="24" FontSize="10"
Margin="1,0,0,0" />
                            </UniformGrid>
                        </Grid>

                    </Grid>
                </Border>

            </Grid>

            <!-- ============================================================= -->
            <!-- COL 0 (يمين بصرياً): بيانات المريض + أزرار الإجراءات          -->
            <!-- ============================================================= -->
            <Grid Grid.Column="0" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- ========= مجموعة بيانات المريض ========= -->
                        <Grid Margin="4,4,4,2">
                            <Border Style="{StaticResource GroupBoxStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- ROW 0: كود المريض + Lab. ID + VIP -->
                                    <Border Grid.Row="0" Grid.Column="0"
Background="{StaticResource BrightOrange}"
CornerRadius="1" Padding="6,2" Margin="1" MinWidth="80" Height="24">
                                        <TextBlock Text="كود المريض" Foreground="White" FontWeight="Bold"
FontSize="11" HorizontalAlignment="Center"
VerticalAlignment="Center" />
                                    </Border>
                                    <TextBox Grid.Row="0" Grid.Column="1"
Style="{StaticResource WhiteTextBoxStyle}"
Text="{Binding PatientCode, UpdateSourceTrigger=PropertyChanged}" />

                                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal"
VerticalAlignment="Center" HorizontalAlignment="Center"
FlowDirection="LeftToRight">
                                        <Border Background="#E91E63" CornerRadius="1" Padding="6,2"
Margin="3,1,1,1" MinWidth="45" Height="24">
                                            <TextBlock Text="VIP" Foreground="White" FontWeight="Bold"
FontSize="11" HorizontalAlignment="Center"
VerticalAlignment="Center" />
                                        </Border>
                                        <CheckBox IsChecked="{Binding IsVip}"
VerticalAlignment="Center" Margin="2,0" />
                                    </StackPanel>

                                    <Border Grid.Row="0" Grid.Column="3"
Background="#7F8C8D" CornerRadius="1" Padding="6,2"
Margin="1" MinWidth="60" Height="24">
                                        <TextBlock Text="Lab. ID" Foreground="White" FontWeight="Bold"
FontSize="11" HorizontalAlignment="Center"
VerticalAlignment="Center" FlowDirection="LeftToRight" />
                                    </Border>
                                    <TextBox Grid.Row="0" Grid.Column="4"
Style="{StaticResource WhiteTextBoxStyle}"
Text="{Binding LabId, UpdateSourceTrigger=PropertyChanged}"
FontWeight="Bold" />

                                    <!-- ROW 1: اسم المريض + النوع -->
                                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabelStyle}">
                                        <TextBlock Text="اسم المريض" Style="{StaticResource FieldLabelText}" />
                                    </Border>
                                    <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" Style="{StaticResource WhiteComboBoxStyle}"
SelectedItem="{Binding Title, Mode=TwoWay}" IsEditable="True">
                                            <ComboBoxItem Content="السيد/" />
                                            <ComboBoxItem Content="السيدة/" />
                                            <ComboBoxItem Content="الآنسة/" />
                                            <ComboBoxItem Content="الطفل/" />
                                        </ComboBox>
                                        <TextBox Grid.Column="1" Style="{StaticResource WhiteTextBoxStyle}"
FontWeight="Bold" Foreground="#0D47A1"
Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
VerticalAlignment="Center" Margin="6,0">
                                            <RadioButton Content="Male"   Style="{StaticResource WhiteRadioStyle}"
IsChecked="{Binding Gender, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Male}" />
                                            <RadioButton Content="Female" Style="{StaticResource WhiteRadioStyle}"
IsChecked="{Binding Gender, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Female}" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- ROW 2: السن + موبايل/تليفون -->
                                    <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabelStyle}">
                                        <TextBlock Text="سن المريض" Style="{StaticResource FieldLabelText}" />
                                    </Border>
                                    <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Style="{StaticResource WhiteTextBoxStyle}"
FontWeight="Bold" HorizontalContentAlignment="Center"
Text="{Binding Age, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                        <ComboBox Grid.Column="1" Style="{StaticResource WhiteComboBoxStyle}"
SelectedItem="{Binding AgeUnit, Mode=TwoWay}" IsEditable="True">
                                            <ComboBoxItem Content="Years" />
                                            <ComboBoxItem Content="Months" />
                                            <ComboBoxItem Content="Days" />
                                        </ComboBox>
                                        <TextBox Grid.Column="2" Style="{StaticResource WhiteTextBoxStyle}"
Text="{Binding HomePhone, UpdateSourceTrigger=PropertyChanged}" />
                                        <Border Grid.Column="3" Style="{StaticResource FieldLabelStyle}">
                                            <TextBlock Text="موبايل/تليفون" Style="{StaticResource FieldLabelText}" />
                                        </Border>
                                        <TextBox Grid.Column="4" Style="{StaticResource WhiteTextBoxStyle}"
Text="{Binding MobilePhone, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>

                                    <!-- ROW 3: نوع الحساب + رقم البطاقة -->
                                    <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabelStyle}">
                                        <TextBlock Text="نوع الحساب" Style="{StaticResource FieldLabelText}" />
                                    </Border>
                                    <Grid Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
Style="{StaticResource WhiteComboBoxStyle}"
SelectedItem="{Binding AccountType, Mode=TwoWay}"
IsEditable="True">
                                            <ComboBoxItem Content="Individual" />
                                            <ComboBoxItem Content="Lab to Lab" />
                                        </ComboBox>
                                        <Border Grid.Column="1" Style="{StaticResource FieldLabelStyle}">
                                            <TextBlock Text="رقم البطاقة" Style="{StaticResource FieldLabelText}" />
                                        </Border>
                                        <TextBox Grid.Column="2" Style="{StaticResource WhiteTextBoxStyle}"
Text="{Binding NationalId, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>

                                    <!-- ROW 4: عنوان المريض -->
                                    <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabelStyle}">
                                        <TextBlock Text="عنوان المريض" Style="{StaticResource FieldLabelText}" />
                                    </Border>
                                    <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="4"
Style="{StaticResource WhiteTextBoxStyle}"
Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ========= مجموعة بيانات الطبيب أو الجهة ========= -->
                        <Grid Margin="4,4,4,2">
                            <Border Style="{StaticResource GroupBoxStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- ROW 0: الطبيب المعالج -->
                                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" MinWidth="95">
                                        <TextBlock Text="الطبيب المعالج" Style="{StaticResource FieldLabelText}" />
                                    </Border>
                                    <Button Grid.Row="0" Grid.Column="1"
Content="معلومات اضافية"
Style="{StaticResource GreenInfoButtonStyle}"
Margin="1" />
                                    <Grid Grid.Row="0" Grid.Column="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="55" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" Style="{StaticResource WhiteComboBoxStyle}"
SelectedItem="{Binding DoctorTitle, Mode=TwoWay}"
IsEditable="True">
                                            <ComboBoxItem Content="د./" />
                                            <ComboBoxItem Content="أ.د./" />
                                            <ComboBoxItem Content="م.د./" />
                                        </ComboBox>
                                        <TextBox Grid.Column="1" Style="{StaticResource WhiteTextBoxStyle}"
FontWeight="Bold" Foreground="#0D47A1"
Text="{Binding ReferralTitleNote, UpdateSourceTrigger=PropertyChanged}" />
                                        <CheckBox Grid.Column="2" Content="Print"
Foreground="White" VerticalAlignment="Center"
Margin="4,0" FontSize="11"
IsChecked="{Binding PrintReferralOnReport}"
FlowDirection="LeftToRight" />
                                    </Grid>

                                    <!-- ROW 1: جهة الإحالة -->
                                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" MinWidth="95">
                                        <TextBlock Text="جهة الإحالة" Style="{StaticResource FieldLabelText}" />
                                    </Border>
                                    <Button Grid.Row="1" Grid.Column="1"
Content="معلومات اضافية"
Style="{StaticResource GreenInfoButtonStyle}"
Margin="1" />
                                    <ComboBox Grid.Row="1" Grid.Column="2"
Style="{StaticResource WhiteComboBoxStyle}"
ItemsSource="{Binding Referrals}"
SelectedItem="{Binding SelectedReferral}"
DisplayMemberPath="Name" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ========= مجموعة معلومات اضافية (الحالات الطبية) ========= -->
                        <Grid Margin="4,4,4,2">
                            <Border Style="{StaticResource GroupBoxStyle}">
                                <StackPanel>

                                    <!-- صف علوي: صائم + عدد ساعات الصيام + هل يأخذ علاج السكر -->
                                    <Grid Margin="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0"
Content="هل يأخذ علاج السكر"
Style="{StaticResource MedicalRightCheckBoxStyle}"
IsChecked="{Binding TakesDiabetesTreatment}" />

                                        <CheckBox Grid.Column="1"
Content="صائم"
Style="{StaticResource YellowCheckBoxStyle}"
IsChecked="{Binding IsFasting}" />

                                        <TextBox Grid.Column="2" Style="{StaticResource WhiteTextBoxStyle}"
HorizontalContentAlignment="Center" FontWeight="Bold"
Text="{Binding FastingHours, UpdateSourceTrigger=PropertyChanged}" />

                                        <Border Grid.Column="3" Style="{StaticResource YellowLabelStyle}" MinWidth="125">
                                            <TextBlock Text="عدد ساعات الصيام" Style="{StaticResource YellowLabelText}" />
                                        </Border>
                                    </Grid>

                                    <!-- الحالات الطبية -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <CheckBox Grid.Row="0" Grid.Column="0"
Content="هل يأخذ علاج لسيولة الدم"
Style="{StaticResource MedicalRightCheckBoxStyle}"
IsChecked="{Binding TakesBloodThinners}" />
                                        <CheckBox Grid.Row="1" Grid.Column="0"
Content="هل يأخذ علاج للفيروسات"
Style="{StaticResource MedicalRightCheckBoxStyle}"
IsChecked="{Binding TakesAntiVirals}" />
                                        <CheckBox Grid.Row="2" Grid.Column="0"
Content="هل يأخذ مضاد حيوي"
Style="{StaticResource MedicalRightCheckBoxStyle}"
IsChecked="{Binding TakesAntibiotics}" />
                                        <CheckBox Grid.Row="3" Grid.Column="0"
Content="هل يأخذ علاج للكبد"
Style="{StaticResource MedicalRightCheckBoxStyle}"
IsChecked="{Binding TakesLiverTreatment}" />
                                        <CheckBox Grid.Row="4" Grid.Column="0"
Content="للسيدات هل يوجد حمل"
Style="{StaticResource MedicalRightCheckBoxStyle}"
IsChecked="{Binding IsPregnant}" />

                                        <CheckBox Grid.Row="0" Grid.Column="1"
Content="مريض فقر الدم"
Style="{StaticResource MedicalLeftCheckBoxStyle}"
IsChecked="{Binding HasAnemia}" />
                                        <CheckBox Grid.Row="1" Grid.Column="1"
Content="مريض بالتهاب المفاصل"
Style="{StaticResource MedicalLeftCheckBoxStyle}"
IsChecked="{Binding HasJointInflammation}" />
                                        <CheckBox Grid.Row="2" Grid.Column="1"
Content="مريض بالضغط الدم"
Style="{StaticResource MedicalLeftCheckBoxStyle}"
IsChecked="{Binding HasHypertension}" />
                                        <CheckBox Grid.Row="3" Grid.Column="1"
Content="مريض بالفشل الكلوي"
Style="{StaticResource MedicalLeftCheckBoxStyle}"
IsChecked="{Binding HasKidneyFailure}" />
                                        <CheckBox Grid.Row="4" Grid.Column="1"
Content="مريض بالإصابة بمرض مزمن"
Style="{StaticResource MedicalLeftCheckBoxStyle}"
IsChecked="{Binding HasPregnancyComplication}" />
                                    </Grid>

                                    <CheckBox Margin="1,2,1,1"
Content="هل تم عمل اشعة بالصبغة او المواد المشعة خلال يومين"
Style="{StaticResource MedicalRightCheckBoxStyle}"
HorizontalAlignment="Stretch"
IsChecked="{Binding HadContrastImaging}" />

                                    <Grid Margin="0,3,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
Style="{StaticResource WhiteTextBoxStyle}"
MinHeight="32" AcceptsReturn="True"
TextWrapping="Wrap"
Text="{Binding MedicalNotes, UpdateSourceTrigger=PropertyChanged}" />
                                        <Border Grid.Column="1" Background="{StaticResource BrightOrange}"
CornerRadius="1" Padding="10,2" Margin="2,1,1,1"
VerticalAlignment="Stretch">
                                            <TextBlock Text="ملاحظات" Foreground="White" FontWeight="Bold"
VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>

                                </StackPanel>
                            </Border>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>

                <!-- ======= أزرار الإجراءات السفلية ======= -->
                <Border Grid.Row="1" Margin="4,4,4,0" Padding="2"
Background="{StaticResource DarkBlueHeader}"
BorderBrush="{StaticResource PanelBorder}"
BorderThickness="1"
CornerRadius="2">
                    <StackPanel>

                        <!-- صف 1: تراجع | حفظ | تعديل | إضافة -->
                        <UniformGrid Rows="1" Columns="4" Margin="0,0,0,2">
                            <Button Command="{Binding UndoCommand}"
Style="{StaticResource SidebarActionButtonStyle}"
Background="{StaticResource SidebarLime}">
                                <Grid>
