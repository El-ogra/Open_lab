                                </Grid>
                            </Button>
                            <Button Command="{Binding UndoCommand}"
                                    Style="{StaticResource SidebarActionButtonStyle}"
                                    Background="{StaticResource SidebarLime}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="تراجع" Foreground="{StaticResource DangerRed}"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" Margin="4,0,2,0" />
                                    <TextBlock Grid.Column="1" Text="&#xE711;" Foreground="{StaticResource DangerRed}"
                                               Style="{StaticResource SidebarIconGlyph}" />
                                </Grid>
                            </Button>
                        </UniformGrid>

                        <UniformGrid Rows="1" Columns="4" Margin="0,0,0,2">
                            <Button Command="{Binding PrintReceiptCommand}"
                                    Style="{StaticResource SidebarActionButtonStyle}"
                                    Background="{StaticResource SidebarYellowBtn}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="الإيصال" VerticalAlignment="Center"
                                               HorizontalAlignment="Right" Margin="4,0,2,0" />
                                    <TextBlock Grid.Column="1" Text="&#xE749;" Style="{StaticResource SidebarIconGlyph}" />
                                </Grid>
                            </Button>
                            <Button Command="{Binding ShowBarcodeCommand}"
                                    Style="{StaticResource SidebarActionButtonStyle}"
                                    Background="{StaticResource SidebarYellowBtn}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="الباركود" VerticalAlignment="Center"
                                               HorizontalAlignment="Right" Margin="4,0,2,0" />
                                    <TextBlock Grid.Column="1" Text="&#xE8C8;" Style="{StaticResource SidebarIconGlyph}" />
                                </Grid>
                            </Button>
                            <Button Command="{Binding WorksheetCommand}"
                                    Style="{StaticResource SidebarActionButtonStyle}"
                                    Background="{StaticResource SidebarYellowBtn}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="ورقة العمل" VerticalAlignment="Center"
                                               HorizontalAlignment="Right" Margin="4,0,2,0" />
                                    <TextBlock Grid.Column="1" Text="&#xE8A5;" Style="{StaticResource SidebarIconGlyph}" />
                                </Grid>
                            </Button>
                            <Button Command="{Binding InsuranceCommand}"
                                    Style="{StaticResource SidebarActionButtonStyle}"
                                    Background="{StaticResource SidebarYellowBtn}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="الكارنية" VerticalAlignment="Center"
                                               HorizontalAlignment="Right" Margin="4,0,2,0" />
                                    <TextBlock Grid.Column="1" Text="&#xE7C3;" Style="{StaticResource SidebarIconGlyph}" />
                                </Grid>
                            </Button>
                        </UniformGrid>

                        <Border Margin="0,2,0,2"
                                BorderBrush="{StaticResource HeaderYellow}"
                                BorderThickness="2"
                                CornerRadius="1"
                                Padding="1">
                            <Border BorderBrush="{StaticResource DangerRed}"
                                    BorderThickness="0,2,0,0"
                                    Padding="0,2,0,0">
                                <UniformGrid Rows="1" Columns="3">
                                    <Button Command="{Binding ShowTodayPatientsCommand}"
                                            Style="{StaticResource SidebarActionButtonStyle}"
                                            Background="{StaticResource SidebarTicketBlue}"
                                            Foreground="White">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="24" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="تذكرة المريض" Foreground="White"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                                       Margin="4,0,2,0" />
                                            <TextBlock Grid.Column="1" Text="&#xE716;" Foreground="White"
                                                       Style="{StaticResource SidebarIconGlyph}" />
                                        </Grid>
                                    </Button>
                                    <Button Command="{Binding GoToResultsCommand}"
                                            Style="{StaticResource SidebarActionButtonStyle}"
                                            Background="White">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="24" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="نتائج التحاليل"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                                       Margin="4,0,2,0" />
                                            <TextBlock Grid.Column="1" Text="&#xE8A1;" Style="{StaticResource SidebarIconGlyph}" />
                                        </Grid>
                                    </Button>
                                    <Button Command="{Binding GoToHomeCommand}"
                                            Style="{StaticResource SidebarActionButtonStyle}"
                                            Background="{StaticResource SidebarMenuBlue}"
                                            Foreground="White"
                                            MinHeight="38">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="24" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="القائمة الرئيسية" Foreground="White"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                                       Margin="4,0,2,0" />
                                            <TextBlock Grid.Column="1" Text="&#xE7E8;" Foreground="White"
                                                       Style="{StaticResource SidebarIconGlyph}" />
                                        </Grid>
                                    </Button>
                                </UniformGrid>
                            </Border>
                        </Border>

                    </StackPanel>
                </Border>

            </Grid>

        </Grid>
        <!-- ================================================================= -->

    </Grid>
</UserControl>
