<UserControl x:Class="Open_lab.Views.ReferralsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <StackPanel Margin="0,0,16,0">
            <TextBlock Text="الجهات" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="الاسم" Margin="0,12,0,4" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="النوع" Margin="0,12,0,4" />
            <TextBox Text="{Binding Type, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="الهاتف" Margin="0,12,0,4" />
            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="المدينة" Margin="0,12,0,4" />
            <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="حفظ" Margin="0,0,8,0" Command="{Binding SaveCommand}" />
                <Button Content="حذف" Command="{Binding DeleteCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}" Foreground="DarkGreen" Margin="0,8,0,0" />
        </StackPanel>

        <DataGrid Grid.Column="1" ItemsSource="{Binding Referrals}" SelectedItem="{Binding SelectedReferral}" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="النوع" Binding="{Binding ReferralType}" Width="120" />
                <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="120" />
                <DataGridTextColumn Header="المدينة" Binding="{Binding City}" Width="120" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
