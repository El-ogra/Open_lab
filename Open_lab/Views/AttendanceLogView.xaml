<UserControl x:Class="Open_lab.Views.AttendanceLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="من" VerticalAlignment="Center" Margin="0,0,6,0" />
            <DatePicker SelectedDate="{Binding DateFrom}" Width="140" />
            <TextBlock Text="إلى" VerticalAlignment="Center" Margin="12,0,6,0" />
            <DatePicker SelectedDate="{Binding DateTo}" Width="140" />
            <Button Content="تحميل" Margin="12,0,0,0" Command="{Binding LoadLogsCommand}" />
            <TextBlock Text="{Binding StatusMessage}" Margin="12,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Logs}" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="المستخدم" Binding="{Binding Username}" Width="*" />
                <DataGridTextColumn Header="الاسم" Binding="{Binding FullName}" Width="*" />
                <DataGridTextColumn Header="دخول" Binding="{Binding LoginAt}" Width="*" />
                <DataGridTextColumn Header="خروج" Binding="{Binding LogoutAt}" Width="*" />
                <DataGridTextColumn Header="المدة" Binding="{Binding Duration}" Width="120" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
