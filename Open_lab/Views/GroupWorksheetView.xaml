<UserControl x:Class="Open_lab.Views.GroupWorksheetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Header="اختيار الفترة والمجموعة" Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Margin="8">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="من:" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <DatePicker SelectedDate="{Binding From}" Width="140" />
                    <TextBlock Text="إلى:" VerticalAlignment="Center" Margin="12,0,8,0" />
                    <DatePicker SelectedDate="{Binding To}" Width="140" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <RadioButton Content="مجموعة تحاليل" IsChecked="{Binding IsCustomGroup, Converter={StaticResource InverseBooleanConverter}}" Margin="0,0,12,0" />
                    <RadioButton Content="مجموعة مخصصة" IsChecked="{Binding IsCustomGroup}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <ComboBox ItemsSource="{Binding Groups}" 
                              SelectedValue="{Binding SelectedGroupId}" 
                              SelectedValuePath="GroupId"
                              DisplayMemberPath="GroupName" 
                              Width="300" Margin="0,0,8,0"
                              Visibility="{Binding IsCustomGroup, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                    
                    <ComboBox ItemsSource="{Binding CustomGroups}" 
                              SelectedValue="{Binding SelectedCustomGroupId}" 
                              SelectedValuePath="CustomGroupId"
                              DisplayMemberPath="Name" 
                              Width="300" Margin="0,0,8,0"
                              Visibility="{Binding IsCustomGroup, Converter={StaticResource BoolToVisibilityConverter}}" />
                    
                    <Button Content="تحميل ورقة العمل" Command="{Binding LoadWorksheetCommand}" Margin="0,0,8,0" />
                    <Button Content="طباعة" Command="{Binding PrintCommand}" />
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" Margin="0,8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="الزيارة" Binding="{Binding VisitId}" Width="80" />
                <DataGridTextColumn Header="المريض" Binding="{Binding PatientName}" Width="*" />
                <DataGridTextColumn Header="التاريخ" Binding="{Binding VisitDate, StringFormat=yyyy-MM-dd HH:mm}" Width="180" />
                <DataGridTextColumn Header="عدد التحاليل" Binding="{Binding TestsCount}" Width="120" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="DarkGreen" TextWrapping="Wrap" Margin="0,8,0,0" />
    </Grid>
</UserControl>
