<Window x:Class="Open_lab.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open Lab System &gt;&gt; القائمة الرئيسية"
        Height="720"
        Width="1180"
        MinHeight="640"
        MinWidth="980"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft">
    <Window.Resources>
        <LinearGradientBrush x:Key="TopToolbarBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0B2239" Offset="0" />
            <GradientStop Color="#234B67" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="ToolbarRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="3,8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#244F70" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#4F7590" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#B7D6E8" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarExitButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="3,8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#244F70" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#4F7590" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarIconStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2,0,5" />
            <Setter Property="FlowDirection" Value="LeftToRight" />
        </Style>

        <Style x:Key="ToolbarTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="90" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource TopToolbarBrush}">
            <UniformGrid Columns="12" FlowDirection="RightToLeft">
                <RadioButton GroupName="TopModules" Style="{StaticResource ToolbarRadioButtonStyle}" Command="{Binding NavigateToPatientsCommand}">
                    <StackPanel>
                        <TextBlock Text="&#xE716;" Style="{StaticResource ToolbarIconStyle}" />
                        <TextBlock Text="المرضى" Style="{StaticResource ToolbarTextStyle}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton GroupName="TopModules" Style="{StaticResource ToolbarRadioButtonStyle}" Command="{Binding NavigateToToolsCommand}">
                    <StackPanel>
                        <TextBlock Text="&#xE90F;" Style="{StaticResource ToolbarIconStyle}" />
                        <TextBlock Text="أدوات" Style="{StaticResource ToolbarTextStyle}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton GroupName="TopModules" Style="{StaticResource ToolbarRadioButtonStyle}" Command="{Binding NavigateToWorksheetCommand}">
                    <StackPanel>
                        <TextBlock Text="&#xE70B;" Style="{StaticResource ToolbarIconStyle}" />
                        <TextBlock Text="ورقة عمل" Style="{StaticResource ToolbarTextStyle}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton GroupName="TopModules" Style="{StaticResource ToolbarRadioButtonStyle}" Command="{Binding NavigateToAccountsCommand}">
                    <StackPanel>
                        <TextBlock Text="&#xE8C7;" Style="{StaticResource ToolbarIconStyle}" />
                        <TextBlock Text="حسابات" Style="{StaticResource ToolbarTextStyle}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton GroupName="TopModules" Style="{StaticResource ToolbarRadioButtonStyle}" Command="{Binding NavigateToStatisticsCommand}">
                    <StackPanel>
                        <TextBlock Text="&#xE9D2;" Style="{StaticResource ToolbarIconStyle}" />
                        <TextBlock Text="احصاليات" Style="{StaticResource ToolbarTextStyle}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton GroupName="TopModules" Style="{StaticResource ToolbarRadioButtonStyle}" Command="{Binding NavigateToUsersCommand}">
                    <StackPanel>
                        <TextBlock Text="&#xE716;" Style="{StaticResource ToolbarIconStyle}" />
                        <TextBlock Text="المستخدمين" Style="{StaticResource ToolbarTextStyle}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton GroupName="TopModules" Style="{StaticResource ToolbarRadioButtonStyle}" Command="{Binding NavigateToSystemDataCommand}">
                    <StackPanel>
                        <TextBlock Text="&#xE7F0;" Style="{StaticResource ToolbarIconStyle}" />
                        <TextBlock Text="بيانات النظام" Style="{StaticResource ToolbarTextStyle}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton GroupName="TopModules" Style="{StaticResource ToolbarRadioButtonStyle}" Command="{Binding NavigateToSettingsCommand}">
                    <StackPanel>
                        <TextBlock Text="&#xE713;" Style="{StaticResource ToolbarIconStyle}" />
                        <TextBlock Text="اعدادات" Style="{StaticResource ToolbarTextStyle}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton GroupName="TopModules" Style="{StaticResource ToolbarRadioButtonStyle}" Command="{Binding NavigateToEmployeesCommand}">
                    <StackPanel>
                        <TextBlock Text="&#xE77B;" Style="{StaticResource ToolbarIconStyle}" />
                        <TextBlock Text="الموظفين" Style="{StaticResource ToolbarTextStyle}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton GroupName="TopModules" Style="{StaticResource ToolbarRadioButtonStyle}" Command="{Binding NavigateToDidYouKnowCommand}">
                    <StackPanel>
                        <TextBlock Text="&#xE946;" Style="{StaticResource ToolbarIconStyle}" />
                        <TextBlock Text="هل تعلم" Style="{StaticResource ToolbarTextStyle}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton GroupName="TopModules" Style="{StaticResource ToolbarRadioButtonStyle}" Command="{Binding NavigateToAboutCommand}">
                    <StackPanel>
                        <TextBlock Text="&#xE946;" Style="{StaticResource ToolbarIconStyle}" />
                        <TextBlock Text="نبذة" Style="{StaticResource ToolbarTextStyle}" />
                    </StackPanel>
                </RadioButton>
                <Button Style="{StaticResource ToolbarExitButtonStyle}" Command="{Binding LogoutCommand}">
                    <StackPanel>
                        <TextBlock Text="&#xE8BB;" Style="{StaticResource ToolbarIconStyle}" />
                        <TextBlock Text="خروج" Style="{StaticResource ToolbarTextStyle}" />
                    </StackPanel>
                </Button>
            </UniformGrid>
        </Border>

        <Border Grid.Row="1" Background="#F7FAF7">
            <ContentControl Content="{Binding CurrentView}" />
        </Border>

        <Border Grid.Row="2" Background="{StaticResource TopToolbarBrush}" Padding="14,0">
            <DockPanel LastChildFill="False" VerticalAlignment="Center">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="#DCECF6" Margin="0,0,0,0" />
                    <TextBlock Text=" اسم المستخدم: " Foreground="#DCECF6" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CurrentUser}" Foreground="White" Margin="0,0,18,0" />
                    <TextBlock Text="آخر دخول: " Foreground="#DCECF6" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding LastLoginDate}" Foreground="White" Margin="0,0,18,0" />
                    <TextBlock Text="قاعدة البيانات: " Foreground="#DCECF6" FontWeight="SemiBold" />
                    <TextBlock Text="متصل" Foreground="#BDE5C8" Margin="0,0,18,0" />
                    <TextBlock Text="اليوم: " Foreground="#DCECF6" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CurrentDate}" Foreground="White" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
