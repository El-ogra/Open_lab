<Window x:Class="Open_lab.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Open_lab" Height="700" Width="1100"
        DataContext="{StaticResource MainViewModel}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Background="#2B2B2B" Grid.Column="0" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="Open_lab" Foreground="White" FontSize="18" FontWeight="Bold" Margin="16" />

                <TextBlock Text="الأساسية" Foreground="White" Margin="16,8,16,4" />
                <Button Content="لوحة التحكم" Margin="12,4" Command="{Binding NavigateDashboardCommand}" />
                <Button Content="تسجيل مريض" Margin="12,4" Command="{Binding NavigatePatientRegistrationCommand}" />
                <Button Content="اختيار تحاليل" Margin="12,4" Command="{Binding NavigatePatientTestsCommand}" />
                <Button Content="حسابات" Margin="12,4" Command="{Binding NavigatePatientBillingCommand}" />
                <Button Content="إدخال نتائج" Margin="12,4" Command="{Binding NavigateResultsEntryCommand}" />
                <Button Content="التقارير" Margin="12,4" Command="{Binding NavigateReportViewerCommand}" />

                <TextBlock Text="بحث وتاريخ" Foreground="White" Margin="16,12,16,4" />
                <Button Content="بحث مريض" Margin="12,4" Command="{Binding NavigatePatientSearchCommand}" />
                <Button Content="تاريخ مرضي" Margin="12,4" Command="{Binding NavigatePatientHistoryCommand}" />

                <TextBlock Text="ورقة العمل" Foreground="White" Margin="16,12,16,4" />
                <Button Content="بالمرضى" Margin="12,4" Command="{Binding NavigateWorkSheetByPatientCommand}" />
                <Button Content="بالتحاليل" Margin="12,4" Command="{Binding NavigateWorkSheetByTestCommand}" />

                <TextBlock Text="الكتالوج" Foreground="White" Margin="16,12,16,4" />
                <Button Content="تعريف التحاليل" Margin="12,4" Command="{Binding NavigateTestCatalogCommand}" />
                <Button Content="القيم المرجعية" Margin="12,4" Command="{Binding NavigateReferenceRangesCommand}" />
                <Button Content="تعليقات التحاليل" Margin="12,4" Command="{Binding NavigateTestCommentsCommand}" />
                <Button Content="قوائم الأسعار" Margin="12,4" Command="{Binding NavigatePriceListsCommand}" />
                <Button Content="مجموعات التحاليل" Margin="12,4" Command="{Binding NavigateCustomGroupsCommand}" />
                <Button Content="الجهات" Margin="12,4" Command="{Binding NavigateReferralsCommand}" />

                                <TextBlock Text="الإدارة" Foreground="White" Margin="16,12,16,4" />
                <Button Content="المستخدمون والصلاحيات" Margin="12,4" Command="{Binding NavigateUsersPermissionsCommand}" />
                <Button Content="الإحصائيات" Margin="12,4" Command="{Binding NavigateStatisticsCommand}" />
                <Button Content="إعدادات النظام" Margin="12,4" Command="{Binding NavigateSystemSettingsCommand}" />
                <Button Content="نسخ احتياطي واستعادة" Margin="12,4" Command="{Binding NavigateBackupRestoreCommand}" />
                <Button Content="خروج" Margin="12,16" Command="{Binding LogoutCommand}" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1" Background="White">
            <ContentControl Content="{Binding CurrentViewModel}" />
        </Border>
    </Grid>
</Window>

