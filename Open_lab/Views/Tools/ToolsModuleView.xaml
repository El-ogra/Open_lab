<UserControl x:Class="Open_lab.Views.Tools.ToolsModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <Style x:Key="ModuleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="200" />
            <Setter Property="Height" Value="65" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Background" Value="#8DB600" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="10">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#25333E">
        <Grid.RowDefinitions>
            <RowDefinition Height="215" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="20"
                Padding="22"
                Background="#FAFAFA"
                BorderBrush="#D5D8DA"
                BorderThickness="1"
                CornerRadius="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" FlowDirection="LeftToRight">
                    <Ellipse Width="126" Height="126" Fill="#E7F2F4" Stroke="#B5CDD2" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Text="&#xED43;" FontFamily="Segoe MDL2 Assets" Foreground="#376C78" FontSize="64" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="من خلال هذه النافذة يمكنك عمل الآتي:"
                               Foreground="#D56E13"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,12" />
                    <TextBlock Text=". الاطلاع على بيانات التحاليل وطبيعة العينات ومعدلاتها الطبيعية وتأثيرها على المريض" FontSize="16" Foreground="#111" Margin="0,3" />
                    <TextBlock Text=". معرفة المصطلحات الخاصة بالاختصارات المستخدمة في مجال التحاليل الطبية" FontSize="16" Foreground="#111" Margin="0,3" />
                    <TextBlock Text=". إدخال طلبات واحتياجات العمل في قائمة المطلوبات والمشتريات" FontSize="16" Foreground="#111" Margin="0,3" />
                    <TextBlock Text=". استخدام ساعة التوقيت بالآلة الحاسبة ومحول نتائج التحاليل" FontSize="16" Foreground="#111" Margin="0,3" />
                    <TextBlock Text=". عمل رسالة تذكيرية لمستخدم محدد أو بك شخصياً من خلال نونة المواعيد" FontSize="16" Foreground="#111" Margin="0,3" />
                    <TextBlock Text=". البحث عن رقم هاتف شخص ما أو تخزين بياناته من خلال دليل الهاتف" FontSize="16" Foreground="#111" Margin="0,3" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Row 0 -->
            <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource ModuleButtonStyle}" Command="{Binding OpenTestLibraryCommand}">
                <DockPanel LastChildFill="True">
                    <TextBlock Text="&#xEA86;" FontFamily="Segoe MDL2 Assets" FontSize="24" DockPanel.Dock="Left" Margin="0,0,10,0" />
                    <TextBlock Text="مكتبة التحاليل" TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center" />
                </DockPanel>
            </Button>
            <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource ModuleButtonStyle}" Command="{Binding OpenStopwatchCommand}">
                <DockPanel LastChildFill="True">
                    <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="24" DockPanel.Dock="Left" Margin="0,0,10,0" />
                    <TextBlock Text="ساعة التوقيت Stopwatch" TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center" />
                </DockPanel>
            </Button>
            <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource ModuleButtonStyle}" Command="{Binding OpenRequirementsListCommand}">
                <DockPanel LastChildFill="True">
                    <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="24" DockPanel.Dock="Left" Margin="0,0,10,0" />
                    <TextBlock Text="قائمة المطلوبات والمشتريات" TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center" />
                </DockPanel>
            </Button>

            <!-- Row 1 -->
            <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource ModuleButtonStyle}" Command="{Binding OpenImageLibraryCommand}">
                <DockPanel LastChildFill="True">
                    <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="24" DockPanel.Dock="Left" Margin="0,0,10,0" />
                    <TextBlock Text="مكتبة الصور" TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center" />
                </DockPanel>
            </Button>
            <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource ModuleButtonStyle}" Command="{Binding OpenUnitConverterCommand}">
                <DockPanel LastChildFill="True">
                    <TextBlock Text="&#xE8EF;" FontFamily="Segoe MDL2 Assets" FontSize="24" DockPanel.Dock="Left" Margin="0,0,10,0" />
                    <TextBlock Text="محول وحدات نتائج التحاليل" TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center" />
                </DockPanel>
            </Button>
            <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource ModuleButtonStyle}" Command="{Binding OpenAppointmentsCommand}">
                <DockPanel LastChildFill="True">
                    <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="24" DockPanel.Dock="Left" Margin="0,0,10,0" />
                    <TextBlock Text="نونة المواعيد" TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center" />
                </DockPanel>
            </Button>

            <!-- Row 2 -->
            <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource ModuleButtonStyle}" Command="{Binding OpenAbbreviationsDictionaryCommand}">
                <DockPanel LastChildFill="True">
                    <TextBlock Text="&#xE8D2;" FontFamily="Segoe MDL2 Assets" FontSize="24" DockPanel.Dock="Left" Margin="0,0,10,0" />
                    <TextBlock Text="قاموس لاختصارات" TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center" />
                </DockPanel>
            </Button>
            <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource ModuleButtonStyle}" Command="{Binding OpenCalculatorCommand}">
                <DockPanel LastChildFill="True">
                    <TextBlock Text="&#xED1E;" FontFamily="Segoe MDL2 Assets" FontSize="24" DockPanel.Dock="Left" Margin="0,0,10,0" />
                    <TextBlock Text="الآلة الحاسبة" TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center" />
                </DockPanel>
            </Button>
            <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource ModuleButtonStyle}" Command="{Binding OpenPhoneDirectoryCommand}">
                <DockPanel LastChildFill="True">
                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="24" DockPanel.Dock="Left" Margin="0,0,10,0" />
                    <TextBlock Text="دليل الهاتف" TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center" />
                </DockPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
