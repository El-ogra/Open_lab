<UserControl x:Class="Open_lab.Views.CustomGroupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <StackPanel Margin="0,0,16,0">
            <TextBlock Text="مجموعات التحاليل" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="اسم المجموعة" Margin="0,12,0,4" />
            <TextBox Text="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="السعر" Margin="0,12,0,4" />
            <TextBox Text="{Binding GroupPrice, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="إنشاء مجموعة" Margin="0,8,0,0" Command="{Binding SaveGroupCommand}" />

            <TextBlock Text="المجموعة الحالية" Margin="0,12,0,4" />
            <ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" DisplayMemberPath="Name" />

            <TextBlock Text="التحليل" Margin="0,12,0,4" />
            <ComboBox ItemsSource="{Binding Tests}" SelectedItem="{Binding SelectedTest}" DisplayMemberPath="NameReport" />
            <Button Content="إضافة" Margin="0,8,0,0" Command="{Binding AddItemCommand}" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="DarkGreen" Margin="0,8,0,0" />
        </StackPanel>

        <DataGrid Grid.Column="1" ItemsSource="{Binding GroupItems}" SelectedItem="{Binding SelectedItem}" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="التحليل" Binding="{Binding Test.NameReport}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
