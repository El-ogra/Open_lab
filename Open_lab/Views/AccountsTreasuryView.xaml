<UserControl x:Class="Open_lab.Views.AccountsTreasuryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <WrapPanel Margin="0,0,0,12">
            <TextBlock Text="من" VerticalAlignment="Center" Margin="0,0,6,0" />
            <DatePicker SelectedDate="{Binding DateFrom}" Width="140" />
            <TextBlock Text="إلى" VerticalAlignment="Center" Margin="12,0,6,0" />
            <DatePicker SelectedDate="{Binding DateTo}" Width="140" />
            <Button Content="تحميل" Margin="12,0,0,0" Command="{Binding LoadCommand}" />
            <Button Content="يومي" Margin="8,0,0,0" Command="{Binding DailyCommand}" />
            <Button Content="أسبوعي" Margin="8,0,0,0" Command="{Binding WeeklyCommand}" />
            <Button Content="شهري" Margin="8,0,0,0" Command="{Binding MonthlyCommand}" />
            <Button Content="طباعة" Margin="8,0,0,0" Command="{Binding PrintCommand}" />
            <TextBlock Text="{Binding StatusMessage}" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
        </WrapPanel>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,12">
            <Border Margin="4" Padding="8" Background="#F4F4F4">
                <StackPanel>
                    <TextBlock Text="إجمالي الفواتير" />
                    <TextBlock Text="{Binding TotalInvoiced, StringFormat=N2}" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Margin="4" Padding="8" Background="#F4F4F4">
                <StackPanel>
                    <TextBlock Text="إجمالي المدفوع" />
                    <TextBlock Text="{Binding TotalPaid, StringFormat=N2}" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Margin="4" Padding="8" Background="#F4F4F4">
                <StackPanel>
                    <TextBlock Text="المتبقي" />
                    <TextBlock Text="{Binding TotalBalance, StringFormat=N2}" FontWeight="Bold" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <GroupBox Grid.Row="2" Header="المدفوعات التفصيلية" Margin="0,0,0,8">
            <DataGrid ItemsSource="{Binding Payments}" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="المريض" Binding="{Binding PatientName}" Width="*" />
                    <DataGridTextColumn Header="الجهة" Binding="{Binding ReferralName}" Width="*" />
                    <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N2}" Width="120" />
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding PaymentDate}" Width="180" />
                    <DataGridTextColumn Header="المستخدم" Binding="{Binding Username}" Width="140" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="ملخص حسب المستخدم" Margin="0,0,0,8">
            <DataGrid ItemsSource="{Binding ByUser}" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="المستخدم" Binding="{Binding Username}" Width="*" />
                    <DataGridTextColumn Header="عدد العمليات" Binding="{Binding PaymentsCount}" Width="140" />
                    <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalAmount, StringFormat=N2}" Width="140" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <GroupBox Grid.Row="4" Header="ملخص حسب الجهة">
            <DataGrid ItemsSource="{Binding ByReferral}" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الجهة" Binding="{Binding ReferralName}" Width="*" />
                    <DataGridTextColumn Header="عدد الزيارات" Binding="{Binding VisitsCount}" Width="120" />
                    <DataGridTextColumn Header="الفواتير" Binding="{Binding TotalInvoiced, StringFormat=N2}" Width="130" />
                    <DataGridTextColumn Header="المدفوع" Binding="{Binding TotalPaid, StringFormat=N2}" Width="130" />
                    <DataGridTextColumn Header="المتبقي" Binding="{Binding TotalBalance, StringFormat=N2}" Width="130" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</UserControl>
