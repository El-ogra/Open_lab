<UserControl x:Class="Open_lab.Views.UsersPermissionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <StackPanel Margin="0,0,16,0">
            <TextBlock Text="المستخدمون" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="اسم المستخدم" Margin="0,12,0,4" />
            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="كلمة المرور" Margin="0,12,0,4" />
            <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="الاسم الكامل" Margin="0,12,0,4" />
            <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" />
            <CheckBox Content="نشط" IsChecked="{Binding IsActive}" Margin="0,8,0,0" />

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="حفظ المستخدم" Command="{Binding SaveUserCommand}" />
                <Button Content="حذف المستخدم" Margin="8,0,0,0" Command="{Binding DeleteUserCommand}" />
            </StackPanel>

            <TextBlock Text="الدور" Margin="0,12,0,4" />
            <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" DisplayMemberPath="RoleName" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="ربط الدور" Command="{Binding AssignRoleCommand}" />
                <Button Content="فك الربط" Margin="8,0,0,0" Command="{Binding UnassignRoleCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}" Foreground="DarkGreen" Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <DataGrid Grid.Column="1" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="المستخدم" Binding="{Binding Username}" Width="*" />
                <DataGridTextColumn Header="الاسم" Binding="{Binding FullName}" Width="*" />
                <DataGridCheckBoxColumn Header="نشط" Binding="{Binding IsActive}" Width="80" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Column="2">
            <TextBlock Text="الأدوار والصلاحيات" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="اسم الدور" Margin="0,12,0,4" />
            <TextBox Text="{Binding RoleName, UpdateSourceTrigger=PropertyChanged}" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="إنشاء دور" Command="{Binding SaveRoleCommand}" />
                <Button Content="حذف الدور" Margin="8,0,0,0" Command="{Binding DeleteRoleCommand}" />
            </StackPanel>

            <TextBlock Text="الصلاحيات" Margin="0,12,0,4" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="360">
                <ItemsControl ItemsSource="{Binding Permissions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Code}" IsChecked="{Binding IsGranted}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Button Content="حفظ الصلاحيات" Margin="0,8,0,0" Command="{Binding SaveRolePermissionsCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
