<UserControl x:Class="Open_lab.Views.ResultsEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="من" VerticalAlignment="Center" Margin="0,0,8,0" />
            <DatePicker SelectedDate="{Binding DateFrom}" Width="140" />
            <TextBlock Text="إلى" VerticalAlignment="Center" Margin="16,0,8,0" />
            <DatePicker SelectedDate="{Binding DateTo}" Width="140" />
            <Button Content="تحميل" Margin="16,0,0,0" Command="{Binding LoadVisitTestsCommand}" />
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding VisitTests}" SelectedItem="{Binding SelectedVisitTest}" AutoGenerateColumns="False" Height="200" Margin="0,12,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="المريض" Binding="{Binding PatientName}" Width="*" />
                <DataGridTextColumn Header="التحليل" Binding="{Binding TestName}" Width="*" />
                <DataGridTextColumn Header="التاريخ" Binding="{Binding VisitDate}" Width="150" />
                <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="100" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="نتائج التحليل" FontWeight="Bold" />
            <DataGrid ItemsSource="{Binding ResultItems}" AutoGenerateColumns="False" Height="200">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الباراميتر" Binding="{Binding ParameterName}" Width="*" IsReadOnly="True" />
                    <DataGridTextColumn Header="القيمة" Binding="{Binding Value}" Width="120" />
                    <DataGridTextColumn Header="Flag" Binding="{Binding Flag}" Width="80" />
                    <DataGridTextColumn Header="تعليق" Binding="{Binding Comment}" Width="200" />
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="حفظ النتائج" Margin="0,0,8,0" Command="{Binding SaveResultsCommand}" />
                <Button Content="اعتماد" Margin="0,0,8,0" Command="{Binding VerifyResultsCommand}" />`r`n                <Button Content="إعادة فتح" Command="{Binding ReopenResultsCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}" Foreground="DarkGreen" Margin="0,8,0,0" />
        </StackPanel>
    </Grid>
</UserControl>

