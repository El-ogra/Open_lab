<UserControl x:Class="Open_lab.Views.TestCatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <StackPanel Margin="0,0,16,0">
            <TextBlock Text="كتالوج التحاليل" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="الكود" Margin="0,12,0,4" />
            <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="اسم التقرير" Margin="0,12,0,4" />
            <TextBox Text="{Binding NameReport, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="اسم الإيصال" Margin="0,12,0,4" />
            <TextBox Text="{Binding NameReceipt, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="السعر" Margin="0,12,0,4" />
            <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="زمن التنفيذ" Margin="0,12,0,4" />
            <TextBox Text="{Binding TurnaroundHours, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="المجموعة" Margin="0,12,0,4" />
            <ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" DisplayMemberPath="GroupName" />
            <TextBlock Text="نوع العينة" Margin="0,12,0,4" />
            <ComboBox ItemsSource="{Binding SampleTypes}" SelectedItem="{Binding SelectedSampleType}" DisplayMemberPath="Name" />
            <TextBlock Text="الوحدة" Margin="0,12,0,4" />
            <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedUnit}" DisplayMemberPath="Name" />
            <CheckBox Content="روتيني" IsChecked="{Binding IsRoutine}" Margin="0,12,0,0" />
            <CheckBox Content="مرسل" IsChecked="{Binding IsSendOut}" />

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="جديد" Width="80" Margin="0,0,8,0" Command="{Binding NewCommand}" />
                <Button Content="حفظ" Width="80" Margin="0,0,8,0" Command="{Binding SaveCommand}" />
                <Button Content="حذف" Width="80" Command="{Binding DeleteCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}" Foreground="DarkGreen" Margin="0,8,0,0" />
        </StackPanel>

        <DataGrid Grid.Column="1" ItemsSource="{Binding Tests}" SelectedItem="{Binding SelectedTest}" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="الكود" Binding="{Binding Code}" Width="120" />
                <DataGridTextColumn Header="اسم التقرير" Binding="{Binding NameReport}" Width="*" />
                <DataGridTextColumn Header="السعر" Binding="{Binding Price}" Width="100" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
