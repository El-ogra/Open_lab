<UserControl x:Class="Open_lab.Views.BlankReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Padding="16">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="تقرير فارغ (بيانات المريض فقط)" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" />

        <!-- Search -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="رقم الزيارة:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Text="{Binding VisitId, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,8,0" />
            <Button Content="تحميل" Command="{Binding LoadCommand}" />
        </StackPanel>

        <!-- Patient Data -->
        <GroupBox Grid.Row="2" Header="بيانات المريض">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="اسم المريض:" FontWeight="Bold" Margin="4,8" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PatientName}" Margin="4,8" FontSize="16" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="رقم المعمل (Lab ID):" FontWeight="Bold" Margin="4,8" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LabId}" Margin="4,8" FontSize="16" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="الجنس:" FontWeight="Bold" Margin="4,8" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Gender}" Margin="4,8" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="تاريخ الميلاد:" FontWeight="Bold" Margin="4,8" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding BirthDate}" Margin="4,8" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="الهاتف:" FontWeight="Bold" Margin="4,8" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Phone}" Margin="4,8" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="تاريخ الزيارة:" FontWeight="Bold" Margin="4,8" />
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding VisitDate}" Margin="4,8" />

                <TextBlock Grid.Row="6" Grid.Column="0" Text="جهة الإحالة:" FontWeight="Bold" Margin="4,8" />
                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ReferralName}" Margin="4,8" />
            </Grid>
        </GroupBox>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Margin="0,8,0,0" Foreground="Green" />
    </Grid>
</UserControl>
