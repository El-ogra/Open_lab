<UserControl x:Class="Open_lab.Views.TestCommentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <StackPanel Margin="0,0,16,0">
            <TextBlock Text="تعليقات التحاليل" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="التحليل" Margin="0,12,0,4" />
            <ComboBox ItemsSource="{Binding Tests}" SelectedItem="{Binding SelectedTest}" DisplayMemberPath="NameReport" />
            <TextBlock Text="التعليق" Margin="0,12,0,4" />
            <TextBox Text="{Binding CommentText, UpdateSourceTrigger=PropertyChanged}" />
            <CheckBox Content="افتراضي" IsChecked="{Binding IsDefault}" Margin="0,8,0,0" />

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="حفظ" Margin="0,0,8,0" Command="{Binding SaveCommand}" />
                <Button Content="حذف" Command="{Binding DeleteCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}" Foreground="DarkGreen" Margin="0,8,0,0" />
        </StackPanel>

        <DataGrid Grid.Column="1" ItemsSource="{Binding Comments}" SelectedItem="{Binding SelectedComment}" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="النص" Binding="{Binding CommentText}" Width="*" />
                <DataGridCheckBoxColumn Header="افتراضي" Binding="{Binding IsDefault}" Width="80" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
