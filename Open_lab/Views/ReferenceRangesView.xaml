<UserControl x:Class="Open_lab.Views.ReferenceRangesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <StackPanel Margin="0,0,16,0">
            <TextBlock Text="القيم المرجعية" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="التحليل" Margin="0,12,0,4" />
            <ComboBox ItemsSource="{Binding Tests}" SelectedItem="{Binding SelectedTest}" DisplayMemberPath="NameReport" />

            <TextBlock Text="النوع" Margin="0,12,0,4" />
            <TextBox Text="{Binding Gender, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="العمر من" Margin="0,12,0,4" />
            <TextBox Text="{Binding AgeFrom, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="العمر إلى" Margin="0,12,0,4" />
            <TextBox Text="{Binding AgeTo, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="الحد الأدنى" Margin="0,12,0,4" />
            <TextBox Text="{Binding LowValue, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="الحد الأعلى" Margin="0,12,0,4" />
            <TextBox Text="{Binding HighValue, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="نص طبيعي" Margin="0,12,0,4" />
            <TextBox Text="{Binding NormalText, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="حفظ" Margin="0,0,8,0" Command="{Binding SaveCommand}" />
                <Button Content="حذف" Command="{Binding DeleteCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}" Foreground="DarkGreen" Margin="0,8,0,0" />
        </StackPanel>

        <DataGrid Grid.Column="1" ItemsSource="{Binding Ranges}" SelectedItem="{Binding SelectedRange}" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="النوع" Binding="{Binding Gender}" Width="80" />
                <DataGridTextColumn Header="من" Binding="{Binding AgeFrom}" Width="60" />
                <DataGridTextColumn Header="إلى" Binding="{Binding AgeTo}" Width="60" />
                <DataGridTextColumn Header="منخفض" Binding="{Binding LowValue}" Width="80" />
                <DataGridTextColumn Header="مرتفع" Binding="{Binding HighValue}" Width="80" />
                <DataGridTextColumn Header="نص" Binding="{Binding NormalText}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
