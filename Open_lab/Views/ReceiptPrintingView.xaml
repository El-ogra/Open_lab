<UserControl x:Class="Open_lab.Views.ReceiptPrintingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Padding="16">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="طباعة الباركود / الإيصال" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" />

        <!-- Search -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="رقم الزيارة:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Text="{Binding VisitId, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,8,0" />
            <Button Content="تحميل" Command="{Binding LoadCommand}" />
        </StackPanel>

        <!-- Patient Info -->
        <GroupBox Grid.Row="2" Header="بيانات الإيصال" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="المريض:" Margin="4" FontWeight="Bold" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PatientName}" Margin="4" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Lab ID:" Margin="4" FontWeight="Bold" />
                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding LabId}" Margin="4" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="تاريخ الزيارة:" Margin="4" FontWeight="Bold" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding VisitDate}" Margin="4" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="الإجمالي:" Margin="4" FontWeight="Bold" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TotalAmount}" Margin="4" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="المدفوع:" Margin="4" FontWeight="Bold" />
                <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding PaidAmount}" Margin="4" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="المتبقي:" Margin="4" FontWeight="Bold" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding BalanceAmount}" Margin="4" Foreground="Red" />
            </Grid>
        </GroupBox>

        <!-- Tests List -->
        <DataGrid Grid.Row="3" ItemsSource="{Binding TestItems}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding VisitTestId}" Width="50" />
                <DataGridTextColumn Header="التحليل" Binding="{Binding Test.NameReceipt}" Width="*" />
                <DataGridTextColumn Header="السعر" Binding="{Binding Price, StringFormat=N2}" Width="100" />
                <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="80" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Margin="0,8,0,0" Foreground="Green" />
    </Grid>
</UserControl>
