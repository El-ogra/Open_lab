<UserControl x:Class="Open_lab.Views.CombinedReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Padding="16">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="التقرير المجمّع" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" />

        <!-- Search -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="رقم الزيارة:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Text="{Binding VisitId, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,8,0" />
            <Button Content="تحميل" Command="{Binding LoadCommand}" />
        </StackPanel>

        <!-- Patient Info -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="المريض:" FontWeight="Bold" Margin="0,0,4,0" />
            <TextBlock Text="{Binding PatientName}" Margin="0,0,16,0" />
            <TextBlock Text="Lab ID:" FontWeight="Bold" Margin="0,0,4,0" />
            <TextBlock Text="{Binding LabId}" Margin="0,0,16,0" />
            <TextBlock Text="التاريخ:" FontWeight="Bold" Margin="0,0,4,0" />
            <TextBlock Text="{Binding VisitDate}" />
        </StackPanel>

        <!-- Tests with reordering -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" ItemsSource="{Binding Tests}" SelectedItem="{Binding SelectedTest}"
                      AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="التحليل" Binding="{Binding Test.NameReport}" Width="*" />
                    <DataGridTextColumn Header="الحالة" Binding="{Binding VisitTest.Status}" Width="80" />
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                <Button Content="▲" Command="{Binding MoveUpCommand}" Width="40" Height="40" Margin="0,0,0,4" FontSize="16" />
                <Button Content="▼" Command="{Binding MoveDownCommand}" Width="40" Height="40" FontSize="16" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Margin="0,8,0,0" Foreground="Green" />
    </Grid>
</UserControl>
