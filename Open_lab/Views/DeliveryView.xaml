<UserControl x:Class="Open_lab.Views.DeliveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="من" VerticalAlignment="Center" Margin="0,0,8,0" />
            <DatePicker SelectedDate="{Binding DateFrom}" Width="140" />
            <TextBlock Text="إلى" VerticalAlignment="Center" Margin="12,0,8,0" />
            <DatePicker SelectedDate="{Binding DateTo}" Width="140" />
            <TextBlock Text="بحث" VerticalAlignment="Center" Margin="12,0,8,0" />
            <TextBox Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" Width="220" />
            <Button Content="تحميل" Margin="12,0,0,0" Command="{Binding SearchCommand}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,10">
            <Button Content="تسليم" Command="{Binding DeliverCommand}" />
            <Button Content="إعادة فتح" Margin="8,0,0,0" Command="{Binding ReopenCommand}" />
        </StackPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Visits}" SelectedItem="{Binding SelectedVisit}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Visit" Binding="{Binding VisitId}" Width="80" />
                <DataGridTextColumn Header="Lab ID" Binding="{Binding LabId}" Width="120" />
                <DataGridTextColumn Header="المريض" Binding="{Binding PatientName}" Width="200" />
                <DataGridTextColumn Header="التاريخ" Binding="{Binding VisitDate}" Width="150" />
                <DataGridTextColumn Header="حالة الزيارة" Binding="{Binding VisitStatus}" Width="120" />
                <DataGridTextColumn Header="عدد التحاليل" Binding="{Binding TestsCount}" Width="100" />
                <DataGridTextColumn Header="معتمدة" Binding="{Binding VerifiedCount}" Width="80" />
                <DataGridTextColumn Header="مُسلّمة" Binding="{Binding DeliveredCount}" Width="80" />
                <DataGridTextColumn Header="المتبقي" Binding="{Binding Balance}" Width="100" />
                <DataGridCheckBoxColumn Header="جاهزة" Binding="{Binding IsReadyForDelivery}" Width="70" />
                <DataGridCheckBoxColumn Header="تم التسليم" Binding="{Binding IsDelivered}" Width="90" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="DarkGreen" Margin="0,10,0,0" />
    </Grid>
</UserControl>
