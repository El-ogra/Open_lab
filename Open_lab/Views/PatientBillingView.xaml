<UserControl x:Class="Open_lab.Views.PatientBillingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="16">
        <StackPanel>
            <TextBlock Text="حساب المريض" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="رقم الزيارة" Margin="0,12,0,4" />
            <TextBox Text="{Binding VisitId, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="تحميل" Margin="0,8,0,0" Command="{Binding LoadVisitCommand}" />

            <UniformGrid Columns="2" Margin="0,16,0,0">
                <TextBlock Text="الإجمالي" />
                <TextBlock Text="{Binding Total}" />
                <TextBlock Text="الخصم" />
                <TextBox Text="{Binding Discount, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="مبلغ دفعة جديدة" />
                <TextBox Text="{Binding Paid, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="مبلغ تعديل الدفعة المحددة" />
                <TextBox Text="{Binding EditPaymentAmount, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="الصافي" />
                <TextBlock Text="{Binding NetTotal}" />
                <TextBlock Text="المتبقي" />
                <TextBlock Text="{Binding Balance}" />
            </UniformGrid>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="حفظ الفاتورة" Margin="0,0,8,0" Command="{Binding SaveInvoiceCommand}" />
                <Button Content="تسجيل دفعة" Margin="0,0,8,0" Command="{Binding AddPaymentCommand}" />
                <Button Content="تعديل الدفعة المحددة" Margin="0,0,8,0" Command="{Binding EditPaymentCommand}" />
                <Button Content="حذف دفعة محددة" Command="{Binding DeletePaymentCommand}" />
            </StackPanel>

            <TextBlock Text="سجل الدفعات" FontWeight="Bold" Margin="0,16,0,8" />
            <DataGrid ItemsSource="{Binding Payments}" SelectedItem="{Binding SelectedPayment}" AutoGenerateColumns="False" Height="180">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم" Binding="{Binding PaymentId}" Width="80" />
                    <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount}" Width="120" />
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding PaymentDate}" Width="*" />
                    <DataGridTextColumn Header="المستخدم" Binding="{Binding UserId}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>

            <GroupBox Header="إضافة رسوم إضافية" Margin="0,16,0,0">
                <StackPanel Margin="8">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="الوصف" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Width="260" Text="{Binding NewChargeDescription, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="المبلغ" VerticalAlignment="Center" Margin="12,0,8,0" />
                        <TextBox Width="120" Text="{Binding NewChargeAmount, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="إضافة الرسوم" Margin="12,0,0,0" Command="{Binding AddChargeCommand}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding AdditionalCharges}" AutoGenerateColumns="False" Height="120">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم الرسوم" Binding="{Binding AdditionalChargeId}" Width="100" />
                            <DataGridTextColumn Header="الوصف" Binding="{Binding Description}" Width="*" />
                            <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </GroupBox>

            <TextBlock Text="{Binding StatusMessage}" Foreground="DarkGreen" Margin="0,12,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
