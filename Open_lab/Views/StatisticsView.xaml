<UserControl x:Class="Open_lab.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <WrapPanel>
            <TextBlock Text="من" VerticalAlignment="Center" Margin="0,0,8,0" />
            <DatePicker SelectedDate="{Binding From}" Width="150" />
            <TextBlock Text="إلى" VerticalAlignment="Center" Margin="12,0,8,0" />
            <DatePicker SelectedDate="{Binding To}" Width="150" />

            <TextBlock Text="الجنس" VerticalAlignment="Center" Margin="12,0,8,0" />
            <ComboBox Width="120" ItemsSource="{Binding Genders}" SelectedItem="{Binding SelectedGender}" />

            <TextBlock Text="الجهة" VerticalAlignment="Center" Margin="12,0,8,0" />
            <ComboBox Width="220" ItemsSource="{Binding Referrals}" SelectedItem="{Binding SelectedReferral}" DisplayMemberPath="Name" />

            <Button Content="تحميل" Margin="12,0,0,0" Command="{Binding LoadCommand}" />
            <Button Content="طباعة" Margin="8,0,0,0" Command="{Binding PrintCommand}" />
        </WrapPanel>

        <UniformGrid Grid.Row="1" Columns="5" Margin="0,12,0,0">
            <Border Margin="4" Padding="8" Background="#F4F4F4">
                <StackPanel>
                    <TextBlock Text="عدد الزيارات" />
                    <TextBlock Text="{Binding VisitCount}" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Margin="4" Padding="8" Background="#F4F4F4">
                <StackPanel>
                    <TextBlock Text="عدد المرضى" />
                    <TextBlock Text="{Binding PatientCount}" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Margin="4" Padding="8" Background="#F4F4F4">
                <StackPanel>
                    <TextBlock Text="عدد التحاليل" />
                    <TextBlock Text="{Binding TestCount}" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Margin="4" Padding="8" Background="#F4F4F4">
                <StackPanel>
                    <TextBlock Text="إجمالي الفواتير" />
                    <TextBlock Text="{Binding TotalRevenue, StringFormat=N2}" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Margin="4" Padding="8" Background="#F4F4F4">
                <StackPanel>
                    <TextBlock Text="إجمالي المدفوع" />
                    <TextBlock Text="{Binding TotalPaid, StringFormat=N2}" FontWeight="Bold" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="DarkGreen" Margin="0,10,0,6" TextWrapping="Wrap" />

        <GroupBox Grid.Row="3" Header="التحليل حسب الجنس" Margin="0,0,0,8">
            <DataGrid ItemsSource="{Binding ByGender}" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الجنس" Binding="{Binding Gender}" Width="*" />
                    <DataGridTextColumn Header="عدد الزيارات" Binding="{Binding VisitsCount}" Width="140" />
                    <DataGridTextColumn Header="عدد التحاليل" Binding="{Binding TestsCount}" Width="140" />
                    <DataGridTextColumn Header="الإيراد" Binding="{Binding Revenue, StringFormat=N2}" Width="140" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <GroupBox Grid.Row="4" Header="التحليل حسب الجهة">
            <DataGrid ItemsSource="{Binding ByReferral}" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الجهة" Binding="{Binding ReferralName}" Width="*" />
                    <DataGridTextColumn Header="عدد الزيارات" Binding="{Binding VisitsCount}" Width="130" />
                    <DataGridTextColumn Header="عدد التحاليل" Binding="{Binding TestsCount}" Width="130" />
                    <DataGridTextColumn Header="الإيراد" Binding="{Binding Revenue, StringFormat=N2}" Width="130" />
                    <DataGridTextColumn Header="المدفوع" Binding="{Binding Paid, StringFormat=N2}" Width="130" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</UserControl>
