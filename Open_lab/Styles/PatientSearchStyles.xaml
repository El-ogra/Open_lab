<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="AppMainBlue" Color="#033860" />
    <SolidColorBrush x:Key="AppOrange" Color="#E58D2D" />
    <SolidColorBrush x:Key="AppHeaderBlue" Color="#18588A" />
    <SolidColorBrush x:Key="GridHeaderYellow" Color="#FEFBC6" />
    <SolidColorBrush x:Key="LightPanelBg" Color="#EEEEEE" />
    <SolidColorBrush x:Key="DarkPanelBg" Color="#DFEDF7" />

    <!-- DataGrid Header Style -->
    <Style x:Key="CustomDataGridHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource GridHeaderYellow}" />
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="BorderBrush" Value="#AAA" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="Padding" Value="5" />
    </Style>

    <!-- Bottom Action Button Styles -->
    <Style x:Key="BaseActionButtonStyle" TargetType="Button">
        <Setter Property="Margin" Value="2" />
        <Setter Property="Padding" Value="10,2" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderBrush" Value="#888" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="28" />
    </Style>

    <Style x:Key="BlueActionButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseActionButtonStyle}">
        <Setter Property="Background" Value="#3275A4" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style x:Key="GreenActionButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseActionButtonStyle}">
        <Setter Property="Background" Value="#B1DA3F" />
    </Style>

    <Style x:Key="YellowActionButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseActionButtonStyle}">
        <Setter Property="Background" Value="#FFD91A" />
    </Style>

    <Style x:Key="OrangeActionButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseActionButtonStyle}">
        <Setter Property="Background" Value="#FFA115" />
    </Style>

    <Style x:Key="GreyActionButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseActionButtonStyle}">
        <Setter Property="Background" Value="#EEEEEE" />
    </Style>

    <!-- Search Header Style (Blue background with white text) -->
    <Style x:Key="SearchHeaderStyle" TargetType="Border">
        <Setter Property="Background" Value="#297EBB" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="White" />
        <Setter Property="Padding" Value="5,2" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <!-- Header Text inside Search Header -->
    <Style x:Key="SearchHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="11" />
    </Style>

</ResourceDictionary>
