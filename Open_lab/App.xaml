<Application x:Class="Open_lab.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Open_lab.ViewModels"
             xmlns:views="clr-namespace:Open_lab.Views">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <vm:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <vm:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />

        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MainViewModel}">
            <views:MainWindow />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:WelcomeViewModel}">
            <views:WelcomeView />
        </DataTemplate>
    </Application.Resources>
</Application>
